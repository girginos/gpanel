#!/bin/bash
# girginospanel-backup-all — EMEKLIYE AYRILDI (2026-08-26)
#
# NEDEN: bu script `domains.backup_freq` sutununu HIC okumuyordu — panelde yedegi
# "kapali" (none) olan domainler dahil TUM domainleri her gece tam kopyaliyordu.
# Retention da kod icinde sabit 14 gundu (`domains.backup_retention` yok sayiliyordu)
# ve yazmadan once bos alan kontrolu yoktu. Sonuc: kok disk sessizce doluyor,
# dolunca panel + siteler + MySQL birlikte duruyordu (.180'de 26.7 GB/gun uretim,
# 14 gun saklama = ~374 GB ihtiyac, disk 199 GB).
#
# YERINE: panel binary'sindeki Go scheduler (internal/backups/schedule.go). O;
#   * backup_freq / backup_hour / backup_retention alanlarina saygi duyar,
#   * sistem geneli ana saltere (backup_genel_ayar.aktif) uyar,
#   * yazmadan once bos-alan ve depo-tavani kapisindan gecer,
#   * TUM domain DB'lerini alir (bu script yalniz <sk>_main aliyordu),
#   * sha256 + gzip -t ile dogrular, bozulmada bildirim birakir,
#   * domain bazli VE sistem geneli uzak hedefe yukleyebilir.
#
# Bu dosya, eski kurulumlarda cron girdisi hala duruyor olabilecegi icin
# silinmedi: calisirsa hicbir sey yapmadan cikar. Cron girdisini
# `girginospanel-repair --only backup_cron` temizler.

case "${1:-}" in -h|--help)
  cat <<'USAGE'
Usage: girginospanel-backup-all

RETIRED (2026-08-26). Backups are now run by the scheduler built into the panel
(which honors each domain's backup frequency, hour and retention). This file
only remains because old installs may still have a cron entry for it; it does
nothing and exits 0. Remove the stale cron entry with:
  girginospanel-repair --only backup_cron
USAGE
  exit 0 ;;
esac
logger -t girginospanel-backup "backup-all is retired; backups are handled by the panel scheduler (remove the stale cron entry with: girginospanel-repair --only backup_cron)"
exit 0
