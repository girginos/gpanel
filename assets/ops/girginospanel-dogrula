#!/usr/bin/env bash
# girginospanel-dogrula — proves the install/update ACTUALLY works.
#
#   girginospanel-dogrula            # full report
#   girginospanel-dogrula --kisa     # summary + failures only (for installer/updater)
#   girginospanel-dogrula --json     # machine readable
#
# WHY THIS EXISTS
# ───────────────
# 🔴 The old "15) Verification" section was DECORATIVE: it printed status but
# no finding stopped the install. On demo-sunucu the install first printed
#   "wp-cli (WordPress): MISSING"
# and right below it printed
#   "✓ GirginOSPanel installation complete"
# In that same corner there was no SELinux label, valkey was down, FTP was not
# installed and port 80 returned HTTP 500 for every Host. The operator saw "complete".
#
# This tool replaces that section and IS A GATE: if a critical check fails, the exit
# code becomes 1 and the caller does NOT print the success banner.
#
# DESIGN RULES (all learned the hard way in this project)
# ───────────────────────────────────────────────────────
# 1. Measure the PRODUCTION PATH, not the install step. "I ran chmod" and "nginx
#    can actually read it" are not the same thing — measure the latter.
# 2. An UNMEASURABLE check FAILS. Empty output / a missing tool does not mean
#    "clean"; `?? 0` and `|| echo 0` are forbidden.
# 3. 401 and 404 are NOT THE SAME. 401 = route registered, asks for auth (correct).
#    404 = route DOES NOT EXIST (binary/frontend broken). A measurement that does not
#    distinguish the two is a lie.
# 4. Do NOT use pipe + `grep -q`: grep closes the pipe on the first match, the upstream
#    command gets SIGPIPE and `pipefail` marks the pipeline as failed.
# 5. Every check must have a way it CAN FAIL. A check that cannot fail is not measuring.

set -uo pipefail
case ":$PATH:" in
  *:/usr/local/bin:*) : ;;
  *) export PATH="/usr/local/sbin:/usr/local/bin:$PATH" ;;
esac

# 🔴 LC_ALL=C IS MANDATORY FOR PARSING — THE TURKISH LOCALE BREAKS THE REGEX RANGE.
# Measured (31.56.47.190, LANG=tr_TR.UTF-8):
#     printf '@CT@ audit_log' | grep -oE '@CT@ [a-zA-Z0-9_]+'   ->  "@CT@ aud"
#     the same command with LC_ALL=C                             ->  "@CT@ audit_log"
# Under tr_TR collation the `a-z` range does NOT include the letter `i` (dotless i /
# dotted i distinction), so EVERY parse that uses a character range gets cut at `i`:
#   audit_log -> aud · cp_domains -> cp_doma · cp_websec_findings -> cp_websec_f
# Result: the schema check produced a FAKE critical like 22/46 and BLOCKED the customer
# update. Turkey is our main market — this affects every customer server.
# LC_ALL=C gives byte semantics; that is the correct way to parse ASCII identifiers.
export LC_ALL=C

KISA=0; JSON=0
while [ $# -gt 0 ]; do case "$1" in
  --kisa) KISA=1 ;;
  --json) JSON=1 ;;
  -h|--help) sed -n '2,12p' "$0"; exit 0 ;;
  # 🔴 An unknown flag is NOT silently swallowed: if a gate types `--jsom` instead of
  # `--json` it would get the text report and see 0. repair does this correctly.
  *) echo "girginospanel-dogrula: unknown option: $1" >&2; exit 2 ;;
esac; shift; done

c_g=$'\e[32m'; c_r=$'\e[31m'; c_y=$'\e[33m'; c_b=$'\e[1m'; c_0=$'\e[0m'
KRITIK=0; UYARI=0; GECEN=0
declare -a DUSENLER=()

# gec/dus/uyar: every check is reported on ONE line.
# 🔴 `return 0` IS REQUIRED: if the return value becomes printf's (full disk, closed
# log target) then in the `[ cond ] && gec || dus` pattern `dus` would ALSO fire.
# Measured: under `> /dev/full`, 7 GHOST criticals on a healthy system.
gec()  { GECEN=$((GECEN+1))
         if [ $KISA -eq 0 ] && [ $JSON -eq 0 ]; then
           printf "  ${c_g}✓${c_0} %-34s %s\n" "$1" "${2:-}"
         fi; return 0; }
# 🔴 In JSON mode human output is NOT printed; otherwise stdout is not valid JSON
# and `json.load` blows up (measured).
dus()  { KRITIK=$((KRITIK+1)); DUSENLER+=("KRITIK|$1|${2:-}")
         [ $JSON -eq 1 ] || printf "  ${c_r}✗${c_0} %-34s %s\n" "$1" "${2:-}"; return 0; }
uyar() { UYARI=$((UYARI+1)); DUSENLER+=("UYARI|$1|${2:-}")
         [ $JSON -eq 1 ] || printf "  ${c_y}!${c_0} %-34s %s\n" "$1" "${2:-}"; return 0; }
bas()  { { [ $KISA -eq 1 ] || [ $JSON -eq 1 ]; } && return 0; echo -e "\n${c_b}══ $* ══${c_0}"; }

# http: return the code. If the connection could not be made, return "NO-CONNECTION"
# NOT empty — an empty string silently behaves like 0 in a numeric comparison and
# would wrongly pass the check.
http() { # $1=url  $2=host header (opt)
  local k
  if [ -n "${2:-}" ]; then
    k=$(curl -sk -o /dev/null -w '%{http_code}' -H "Host: $2" --max-time 10 "$1" 2>/dev/null)
  else
    k=$(curl -sk -o /dev/null -w '%{http_code}' --max-time 10 "$1" 2>/dev/null)
  fi
  [ -n "$k" ] && [ "$k" != "000" ] && echo "$k" || echo "NO-CONNECTION"
}

# 🔴 `systemctl is-active X || echo unknown` can produce TWO lines: systemctl PRINTS
# "inactive" *and* returns non-zero -> the `||` branch ALSO runs. Result: the variable
# becomes "inactive<newline>unknown" and printf prints the second line BARE. In the
# broken-state test exactly this was seen: a stray "unknown" appeared below the valkey
# line. Take the first line.
servis() {
  local d
  d=$(systemctl is-active "$1" 2>/dev/null)
  d=${d%%$'\n'*}
  [ -n "$d" ] && echo "$d" || echo "unknown"
}

# 🔴 DO NOT ASSUME THE PANEL PORT — READ IT. In the first version I hardcoded 8443 and
# on the build server (moved to port 8899) it produced THREE CRITICAL false alarms.
# The panel port can be changed by the operator (deliberately, to avoid popular ports).
# I broke my own rule: "measure the production path, don't assume". The port is read
# from the vhost file; if it can't be read we fall back to 8443 BUT we do NOT do this
# SILENTLY — the measurement states which port was looked at.
# 🔴 DO NOT ASSUME THE PANEL ADDRESS — READ IT. I wrote this function wrong twice:
#   1) First I hardcoded "8443"  -> 3 CRITICAL false alarms on a port-changed server.
#   2) Then I wrote the regex for `listen <port> ssl` but the real line was
#      `listen 127.0.0.1:9443 ssl;` (IP-prefixed) -> missed again, and the FALLBACK
#      GUESS "look for 8443|8899 in ss output" kicked in and mistook an UNRELATED
#      port (8899) for the panel port.
# Lesson: a guessing fallback makes a wrong measurement look CORRECT. No more guessing —
# if we cannot parse it, we say so plainly and the check FAILS.
# Supported forms:  listen 8443 ssl | listen 127.0.0.1:9443 ssl | listen [::]:8443 ssl
# panel_adaylari: produces candidate addr:port from ALL `listen` lines in _panel.conf.
# It does not decide — only the candidate list. Comments are stripped FIRST (the word
# "ssl" in a comment was poisoning the port), and legacy blocks using `ssl on;` are also
# covered (those blocks don't say ssl on the listen line).
panel_adaylari() {
  local pf=/etc/nginx/conf.d/_panel.conf
  [ -f "$pf" ] || return 0
  sed -E 's/#.*//' "$pf" \
  | grep -oE '^[[:space:]]*listen[[:space:]]+[^;]+' \
  | sed -E 's/^[[:space:]]*listen[[:space:]]+//' \
  | awk '{print $1}' \
  | sed -E 's/^\[([0-9a-fA-F:]+)\]:/\1|/; s/^([0-9.]+):/\1|/; s/^\*:/|/' \
  | awk -F'|' '{ if (NF==2) { adr=$1; p=$2 } else { adr=""; p=$1 }
                 if (p ~ /^[0-9]+$/) { if (adr=="" || adr=="0.0.0.0" || adr=="::") adr="127.0.0.1"; print adr":"p } }' \
  | sort -u
}

# panel_kimligi: is the given base URL the panel ITSELF? Code is not enough — we look
# for the panel's version field in the body. The _default443 catch-all returns 200 +
# HTML on every path; a code-based check mistook it for "the panel" (proven live).
panel_kimligi() {
  curl -sk --max-time 8 "$1/healthz" 2>/dev/null | grep -q '"surum"'
}

PANEL_TABAN=""; PANEL_PORT=""
for _a in $(panel_adaylari); do
  _p=${_a##*:}; _h=${_a%:*}
  for _u in "https://$_h:$_p" "http://$_h:$_p"; do
    if panel_kimligi "$_u"; then
      PANEL_TABAN="$_u"; PANEL_PORT="$_p"; break 2
    fi
  done
done
# If no candidate was found, try the listening sockets (conf unreadable/legacy form).
if [ -z "$PANEL_TABAN" ]; then
  for _p in $(ss -ltnH 2>/dev/null | awk '{print $4}' | sed 's/.*://' | sort -un); do
    for _u in "https://127.0.0.1:$_p" "http://127.0.0.1:$_p"; do
      if panel_kimligi "$_u"; then PANEL_TABAN="$_u"; PANEL_PORT="$_p"; break 3; fi
    done
  done
fi

# ══════════════════════════════════════════════════════════════════════
bas "Services"
# Without panel + web + DB + PHP the system is NOT WORKING -> CRITICAL.
for s in girginospanel nginx mariadb php-fpm; do
  d=$(servis "$s")
  [ "$d" = "active" ] && gec "$s" "active" || dus "$s" "$d (CRITICAL: system won't run)"
done
# Without these the panel still opens, but there is feature loss -> WARNING.
for s in valkey named httpd crond; do
  d=$(servis "$s")
  [ "$d" = "active" ] && gec "$s" "active" || uyar "$s" "$d"
done

# ══════════════════════════════════════════════════════════════════════
# 🔴 "service active" and "the new binary is running" are NOT THE SAME. If the binary
# is replaced on disk and the service is not restarted, the OLD process keeps running
# and systemd still says "active". This silent stale process means the update was never
# actually applied. We compare the /proc/PID/exe inode against the installed file —
# a deleted inode or a different file = stale.
bas "Running process identity"
_pid=$(systemctl show -p MainPID --value girginospanel 2>/dev/null)
_kurulu=/opt/girginospanel/bin/girginospanel-server
if [ -z "$_pid" ] || [ "$_pid" = "0" ]; then
  dus "running binary" "no panel process (MainPID=$_pid)"
elif [ ! -r "/proc/$_pid/exe" ]; then
  uyar "running binary" "COULD NOT MEASURE (/proc/$_pid/exe unreadable)"
elif [ ! -f "$_kurulu" ]; then
  dus "running binary" "installed binary not found ($_kurulu)"
else
  # CONTENT comparison. Comparing inodes with `stat` is WRONG: /proc/PID/exe carries
  # procfs's device number, the installed file is on the real fs -> they never match
  # and the check ALWAYS says "stale" (exactly what happened in the first version, the
  # negative control caught it).
  _link=$(readlink "/proc/$_pid/exe" 2>/dev/null)
  _ch=$(sha256sum "/proc/$_pid/exe" 2>/dev/null | awk '{print $1}')
  _kh=$(sha256sum "$_kurulu" 2>/dev/null | awk '{print $1}')
  case "$_link" in
    *" (deleted)")
      dus "running binary" "STALE PROCESS — running file is DELETED (systemctl restart girginospanel)" ;;
    *)
      # 🔴 sha256 ALONE IS NOT ENOUGH: /proc/PID/exe reads not the loaded image but the
      # CURRENT on-disk content of that inode. If the binary is written IN PLACE (cp/dd/
      # rsync --inplace) both sides are the same inode and the comparison collapses to
      # an X==X tautology — the process runs old code while the check says GREEN (measured).
      # The TIME measurement closes this gate: if the file was modified AFTER the process
      # started, the running code is stale.
      _bmt=$(stat -c%Y "$_kurulu" 2>/dev/null)
      _bas=$(awk '{print $22}' "/proc/$_pid/stat" 2>/dev/null)
      _hz=$(getconf CLK_TCK 2>/dev/null); _hz=${_hz:-100}
      _up=$(awk '{print int($1)}' /proc/uptime 2>/dev/null)
      _now=$(date +%s)
      _surec_bas=""
      if [ -n "$_bas" ] && [ -n "$_up" ]; then
        _surec_bas=$(( _now - _up + _bas / _hz ))
      fi
      if [ -z "$_ch" ] || [ -z "$_kh" ]; then
        uyar "running binary" "COULD NOT MEASURE (sha256 unavailable) — not counted as passed"
      elif [ "$_ch" != "$_kh" ]; then
        dus "running binary" "STALE PROCESS — on-disk binary is not running (systemctl restart girginospanel)"
      elif [ -n "$_surec_bas" ] && [ -n "$_bmt" ] && [ "$_bmt" -gt "$_surec_bas" ]; then
        dus "running binary" "STALE PROCESS — binary modified AFTER the process started (systemctl restart girginospanel)"
      else
        gec "running binary" "same as installed file (sha256 + time)"
      fi ;;
  esac
fi

bas "Panel HTTP surface"
if [ -z "$PANEL_TABAN" ]; then
  # No candidate gave a panel IDENTITY. This is not "port closed", it is "there is NO
  # panel on that port" — we land here even if a fake/wrong service returns 200.
  dus "panel surface" "no address gave a panel identity (no 'surum' in healthz body)"
  dus "/healthz" "COULD NOT MEASURE (panel not found)"
  dus "API authentication" "COULD NOT MEASURE (panel not found)"
else
# In JSON mode free text is NOT printed — stdout must be valid JSON.
if [ $KISA -eq 0 ] && [ $JSON -eq 0 ]; then echo "  (panel surface found by probe: $PANEL_TABAN)"; fi
K=$(http "$PANEL_TABAN/")
[ "$K" = "200" ] && gec "panel :$PANEL_PORT" "HTTP 200" || dus "panel :$PANEL_PORT" "HTTP $K (200 expected)"

K=$(http "$PANEL_TABAN/healthz")
_hz=$(curl -sk --max-time 8 "$PANEL_TABAN/healthz" 2>/dev/null)
_sur=$(printf '%s' "$_hz" | grep -oE '"surum":"[^"]*"' | cut -d'"' -f4)
if [ "$K" = "200" ] && [ -n "$_sur" ]; then
  gec "/healthz" "HTTP 200 · version $_sur"
elif [ "$K" = "200" ]; then
  # Code is correct but the body is not the panel's: another service holds that port.
  dus "/healthz" "HTTP 200 but body does NOT belong to the panel (another service?)"
else
  dus "/healthz" "HTTP $K"
fi

# 🔴 Also prove that the PROCESS HOLDING the port is the panel: even if code+body are
# correct, an interposing proxy could be answering on the panel's behalf.
_mp=$(systemctl show -p MainPID --value girginospanel 2>/dev/null)
_sahip=$(ss -ltnpH 2>/dev/null | grep ":${PANEL_PORT} " | grep -oE 'pid=[0-9]+' | head -1 | cut -d= -f2)
if [ -z "$_sahip" ]; then
  uyar "panel port owner" "COULD NOT MEASURE (ss gave no pid)"
elif [ "$_sahip" = "$_mp" ]; then
  gec "panel port owner" "girginospanel (pid $_sahip)"
else
  _pad=$(ps -o comm= -p "$_sahip" 2>/dev/null)
  # nginx sits in front of the panel as a proxy — this is NORMAL.
  case "$_pad" in
    nginx) gec "panel port owner" "nginx proxy (pid $_sahip) -> panel" ;;
    *)     uyar "panel port owner" "unexpected process: ${_pad:-?} (pid $_sahip)" ;;
  esac
fi

# 🔴 401 vs 404 distinction: 404 shows the routes are NOT REGISTERED AT ALL (binary
# broken/old). Passing because "it's not 200, so it must be protected" is a LIE MEASUREMENT.
K=$(http "$PANEL_TABAN/api/v1/domains")
case "$K" in
  401) gec "API authentication" "HTTP 401 (route registered, protection working)" ;;
  404) dus "API authentication" "HTTP 404 — route DOES NOT EXIST (binary/router broken)" ;;
  200) dus "API authentication" "HTTP 200 — UNAUTHENTICATED ACCESS IS OPEN" ;;
  *)   dus "API authentication" "HTTP $K (401 expected)" ;;
esac
fi

# ══════════════════════════════════════════════════════════════════════
# Role gates (ADR-GP-001): admin / reseller / customer enter through SEPARATE ports.
# Each gate port must answer its OWN type through nginx (listen -> map -> header ->
# proxy secret -> backend trust). If the chain is broken the panel fails SAFE (gate
# rules off = single-port behaviour, nobody is locked out) — it still works, but role
# separation is GONE, so this is a WARNING, not a critical. kapi.json is read directly:
# the panel binary is NOT executed (an old binary would start a server on unknown args).
# GOSP_* path overrides exist only for sandbox tests; the defaults are the real paths.
_kapi_json=${GOSP_KAPI_AYAR:-/etc/girginospanel/kapi.json}
kapi_portu() { grep -oE "\"$1\": *[0-9]+" "$_kapi_json" 2>/dev/null | grep -oE '[0-9]+$' | head -1; }
# The panel's enforcement flag as a file ("acik" | "kapali"; tmpfs, written by the startup
# Heal and every measurement). See internal/provisioner/panelkapi.go kapiZorlamaDosyasi.
_kapi_zorlama=${GOSP_KAPI_ZORLAMA:-/run/girginospanel/kapi-zorlama}

# kapi_zorlama_olc: is gate enforcement REALLY on? (SON-OPS-2; same logic as
# girginospanel-erisim kapi_zorlama_olc.) The type measurement above CANNOT tell: the
# panel answers a loopback measurement with the real gate type even when enforcement is
# OFF (kapi.go: ZorlamaAktif() || istemciLoopback), while at the same time the reseller,
# customer and legacy gates accept the ADMIN login. Two independent measurements:
#   1) the panel's flag file says "acik"
#   2) production path: the customer gate has NO admin login endpoint -> 404. With
#      enforcement off the same request returns 400 (empty body). Body '{}': no
#      credentials are sent; audit log and brute-force counter are untouched (401 only).
# Only both together count as ON. Sets _kz_durum = acik | kapali | olculemedi and
# _kz_olcum = details (plain ASCII/UTF-8 text, no quotes — safe for --json).
_kz_durum=""; _kz_olcum=""
kapi_zorlama_olc() { # -> 0 only if enforcement is PROVEN on
  local bayrak mp kod b_ac=0 b_kapali=0 u_ac=0 u_kapali=0 bd ud
  bayrak=$(head -c 32 "$_kapi_zorlama" 2>/dev/null | tr -d '[:space:]')
  case "$bayrak" in
    acik)   b_ac=1;     bd="flag: acik" ;;
    kapali) b_kapali=1; bd="flag: KAPALI ($_kapi_zorlama)" ;;
    "")     bd="flag unreadable ($_kapi_zorlama missing - panel measurement not done or old version)" ;;
    *)      bd="flag not recognised (${bayrak//[!a-zA-Z0-9_-]/?})" ;;
  esac
  mp=$(kapi_portu musteri)
  if [ -z "$mp" ]; then
    ud="no customer gate port in $_kapi_json - login endpoint not measured"
  else
    kod=$(curl -sk --max-time 5 -o /dev/null -w '%{http_code}' -X POST \
          -H 'Content-Type: application/json' --data '{}' \
          "https://127.0.0.1:$mp/api/v1/auth/login" 2>/dev/null)
    case "$kod" in
      404)         u_ac=1;     ud="customer gate :$mp admin login: 404 (no endpoint)" ;;
      400|401|200) u_kapali=1; ud="customer gate :$mp admin login: HTTP $kod - endpoint OPEN" ;;
      ""|000)      ud="customer gate :$mp could not connect - login endpoint not measured" ;;
      *)           ud="customer gate :$mp HTTP ${kod//[!0-9]/?} - login endpoint not measured" ;;
    esac
  fi
  _kz_olcum="$bd · $ud"
  if [ $b_ac -eq 1 ] && [ $u_ac -eq 1 ]; then
    _kz_durum=acik; return 0
  fi
  if [ $b_kapali -eq 1 ] || [ $u_kapali -eq 1 ]; then
    _kz_durum=kapali
  else
    _kz_durum=olculemedi
  fi
  return 1
}
# http_port_t_kapsar: is tcp port $2 inside http_port_t in `semanage port -l` output $1?
# Entries are single ports or ranges ("80, 443, 8000-8010"); the policy line and the local
# customization line are both considered (same parse as portyonetim.SELinuxPortDurumu).
# awk reads ALL input (no early exit) -> no SIGPIPE under pipefail (rule 4).
http_port_t_kapsar() {
  printf '%s\n' "$1" | awk -v p="$2" '
    $1 == "http_port_t" && $2 == "tcp" {
      s = ""; for (i = 3; i <= NF; i++) s = s $i
      n = split(s, a, ",")
      for (j = 1; j <= n; j++) {
        if (a[j] ~ /^[0-9]+-[0-9]+$/) { split(a[j], r, "-"); if (p + 0 >= r[1] + 0 && p + 0 <= r[2] + 0) hit = 1 }
        else if (a[j] ~ /^[0-9]+$/ && a[j] + 0 == p + 0) hit = 1
      }
    }
    END { exit(hit ? 0 : 1) }'
}
if [ -f "$_kapi_json" ]; then
  bas "Role gates"
  for _kr in admin:yonetim bayi:yonetim musteri:musteri; do
    _rol=${_kr%%:*}; _bek=${_kr#*:}; _kp=$(kapi_portu "$_rol")
    if [ -z "$_kp" ]; then
      uyar "gate $_rol" "COULD NOT MEASURE (no port in $_kapi_json)"
      continue
    fi
    _tip=$(curl -sk --max-time 8 "https://127.0.0.1:$_kp/api/v1/kapi" 2>/dev/null | grep -oE '"tip":"[a-z]+"' | cut -d'"' -f4)
    if [ "$_tip" = "$_bek" ]; then
      gec "gate $_rol :$_kp" "$_tip"
    else
      uyar "gate $_rol :$_kp" "expected '$_bek', got '${_tip:-no answer}' — role separation OFF (single-port behaviour)"
    fi
  done

  # 🔴 A correct type is NOT enforcement (SON-OPS-2): measured from loopback, the three
  # gates above pass even while enforcement is OFF and the reseller/customer/legacy gates
  # accept the admin login. Measure enforcement separately; unmeasurable != passed (rule 2).
  if kapi_zorlama_olc; then
    gec "gate enforcement" "ON — $_kz_olcum"
  elif [ "$_kz_durum" = "kapali" ]; then
    uyar "gate enforcement" "role separation OFF (enforcement KAPALI) — admin login is accepted on the reseller/customer/legacy gates: $_kz_olcum"
  else
    uyar "gate enforcement" "role separation COULD NOT MEASURE (ölçülemedi) — not counted as passed; admin login may be open on the reseller/customer/legacy gates: $_kz_olcum"
  fi

  # 🔴 Gate ports vs SELinux (RK-OPS-01). In Enforcing, nginx (httpd_t) can only bind
  # ports labelled http_port_t; random gate ports default to unreserved_port_t. A reload
  # silently keeps the old sockets (systemctl reload only signals and returns 0) and the
  # NEXT nginx restart does not come up at all -> EVERY site goes down. `nginx -t` does not
  # catch it (it opens no sockets). The panel labels the ports before writing the listen
  # lines (Heal); this measures the result. Candidate ports: the three role ports + the
  # legacy ports while they are still open (kapi.Ayar.EskiAcik: listed AND (now <
  # eski_bitis OR admin_dogrulandi == 0)).
  # 🔴 CRITICAL only for a port nginx really BINDS (an active listen line in _panel.conf).
  # When labelling fails the panel deliberately does NOT write the gate listens (safe
  # state: single-port behaviour, the next nginx restart is unaffected) — girginospanel-
  # update says exactly that ("kapı portları SELinux'ta etiketlenemedi …"). Calling that a
  # critical made the update end in "VERIFICATION FAILED" for a safe server. Unlabelled but
  # not bound = gate layout not applied -> WARNING. Loopback listens (127.0.0.1:P, [::1]:P)
  # DO count: SELinux name_bind is checked on the PORT type whatever the address, so an
  # unlabelled loopback admin gate (erisim desktop mode) also stops nginx on restart.
  # Commented lines (erisim's "# [erisim:masaustu] listen …") are not bound. If _panel.conf
  # is unreadable nothing can be proven "not bound": every candidate counts (old behaviour).
  _panel_conf=${GOSP_PANEL_CONF:-/etc/nginx/conf.d/_panel.conf}
  _dinlenen=""; _dinlenen_ok=0
  if [ -r "$_panel_conf" ]; then
    _dinlenen_ok=1
    # awk/sort read ALL input -> no SIGPIPE under pipefail (rule 4).
    _dinlenen=" $(sed -E 's/#.*//' "$_panel_conf" 2>/dev/null \
      | awk '$1 == "listen" { a = $2; sub(/;.*/, "", a); sub(/^.*:/, "", a); if (a ~ /^[0-9]+$/) print a }' \
      | sort -un | tr '\n' ' ')"
  fi
  port_dinleniyor() { # port -> 0 if an active listen line binds it (or it cannot be proven otherwise)
    [ "$_dinlenen_ok" = 1 ] || return 0
    case "$_dinlenen" in *" $1 "*) return 0 ;; esac
    return 1
  }
  _kj=$(tr -d ' \t\r\n' < "$_kapi_json" 2>/dev/null)
  _kports=""
  for _rol in admin bayi musteri; do
    _kp=$(kapi_portu "$_rol")
    [ -n "$_kp" ] && _kports="$_kports $_kp:$_rol"   # a missing port was already reported above
  done
  _eski=$(printf '%s' "$_kj" | grep -oE '"eski_portlar":\[[0-9,]*\]' | grep -oE '[0-9]+')
  _ebit=$(printf '%s' "$_kj" | grep -oE '"eski_bitis":[0-9]+' | grep -oE '[0-9]+$')
  _adog=$(printf '%s' "$_kj" | grep -oE '"admin_dogrulandi":[0-9]+' | grep -oE '[0-9]+$')
  if [ -n "$_eski" ] && { [ "$(date +%s)" -lt "${_ebit:-0}" ] || [ "${_adog:-0}" -eq 0 ]; }; then
    for _kp in $_eski; do _kports="$_kports $_kp:legacy"; done
  fi
  _sel=""
  command -v getenforce >/dev/null 2>&1 && _sel=$(getenforce 2>/dev/null)
  case "$_sel" in
    Enforcing)
      if ! command -v semanage >/dev/null 2>&1; then
        uyar "gate SELinux labels" "Enforcing but no semanage — COULD NOT MEASURE (not counted as passed)"
      else
        _spl=$(semanage port -l 2>/dev/null)
        _say=0; _etiketsiz=""; _yazilmamis=""
        for _k in $_kports; do
          _say=$((_say+1))
          http_port_t_kapsar "$_spl" "${_k%%:*}" && continue
          if port_dinleniyor "${_k%%:*}"; then
            _etiketsiz="$_etiketsiz :${_k%%:*}(${_k#*:})"
          else
            _yazilmamis="$_yazilmamis :${_k%%:*}(${_k#*:})"
          fi
        done
        if [ -z "$_spl" ]; then
          uyar "gate SELinux labels" "semanage port -l gave no output — COULD NOT MEASURE (not counted as passed)"
        elif [ "$_say" -eq 0 ]; then
          uyar "gate SELinux labels" "no gate port readable from $_kapi_json — COULD NOT MEASURE"
        else
          if [ -n "$_etiketsiz" ]; then
            dus "gate SELinux labels" "Enforcing and NOT http_port_t:$_etiketsiz — bound by a listen line in _panel.conf, nginx cannot bind them, the next nginx restart FAILS (all sites down). Fix: girginospanel-server kapi selinux (or semanage port -a -t http_port_t -p tcp <port>)"
          fi
          if [ -n "$_yazilmamis" ]; then
            uyar "gate SELinux labels" "kapı düzeni uygulanmadı — SELinux etiketi eksik; girginospanel-server kapi selinux. Enforcing and NOT http_port_t:$_yazilmamis — no listen line binds them (the panel did not apply the gate layout: single-port behaviour, nginx restart unaffected)"
          fi
          if [ -z "$_etiketsiz" ] && [ -z "$_yazilmamis" ]; then
            gec "gate SELinux labels" "$_say/$_say gate ports http_port_t (Enforcing)"
          fi
        fi
      fi ;;
    Permissive|Disabled)
      # Not a check here: bind is not restricted. Info line only, not counted as passed.
      if [ $KISA -eq 0 ] && [ $JSON -eq 0 ]; then
        echo "  (gate SELinux labels: skipped — SELinux $_sel, nginx bind not restricted)"
      fi ;;
    *)
      if command -v getenforce >/dev/null 2>&1; then
        uyar "gate SELinux labels" "getenforce gave '${_sel:-no output}' — COULD NOT MEASURE (not counted as passed)"
      elif [ $KISA -eq 0 ] && [ $JSON -eq 0 ]; then
        echo "  (gate SELinux labels: skipped — no getenforce; see the SELinux section)"
      fi ;;
  esac
fi

# ══════════════════════════════════════════════════════════════════════
bas "Catch-all vhosts"
# 🔴 Because the port 80 catch-all document root was not created, `try_files` entered an
# infinite internal redirect and returned 500 (4/4 servers in the fleet). 5xx = broken.
K=$(http http://127.0.0.1/ "unknown-verification.example")
case "$K" in
  5*)            dus "port 80 catch-all" "HTTP $K — unmatched Hosts get an error" ;;
  NO-CONNECTION) dus "port 80 catch-all" "could not connect" ;;
  *)             gec "port 80 catch-all" "HTTP $K" ;;
esac
K=$(http https://127.0.0.1/ "unknown-verification.example")
case "$K" in
  5*|NO-CONNECTION) uyar "port 443 catch-all" "HTTP $K" ;;
  *)                gec "port 443 catch-all" "HTTP $K" ;;
esac

# ══════════════════════════════════════════════════════════════════════
bas "nginx configuration"
# 🔴 `nginx -t >/dev/null 2>&1` looks ONLY at the exit code and SWALLOWS THE WARNINGS.
# This cost us dearly: for months nginx was saying
#     [warn] no "fastcgi_cache_key" for "fastcgi_cache"
# and because the key was undefined, ALL PAGES shared a SINGLE cache entry named md5("")
# and visitors got the wrong page. The warning was right there, we weren't looking.
# Now we REPORT the warnings too.
_ngx=$(nginx -t 2>&1)
if [ $? -ne 0 ]; then
  dus "nginx -t" "configuration INVALID — will blow up on reload"
else
  gec "nginx -t" "valid"
fi
# Filter known harmless noise, show the remaining warnings.
_ngxw=$(printf '%s
' "$_ngx" | grep -i "\[warn\]" | grep -v "conflicting server name")
if [ -n "$_ngxw" ]; then
  # 🔴 The cache_key warning means CONTENT MIXUP — treat this as CRITICAL, not a warning.
  case "$_ngxw" in
    *fastcgi_cache_key*)
      dus "nginx WARNINGS" "fastcgi_cache_key UNDEFINED — all pages share one cache entry (visitor sees the wrong page)" ;;
    *)
      uyar "nginx WARNINGS" "$(printf '%s' "$_ngxw" | head -3 | tr '
' ' ')" ;;
  esac
else
  gec "nginx warnings" "none"
fi

# 🔴 Measure via the PRODUCTION PATH: looking at the permission bit is not enough, can
# the nginx user actually get in? If the parent directory stays 0700 root:root, the
# subdirectory being correct still leaves fastcgi_cache silently dead (unnoticed because
# nginx stays up).
CD=/var/cache/nginx/girgincache
if [ -d "$CD" ]; then
  if command -v runuser >/dev/null 2>&1; then
    # 🔴 `test -r` IS NOT ENOUGH — fastcgi_cache WRITES. Measured: on a root:root 755
    # directory `test -r` passed but the real write failed, so the cache was dead and the
    # check was green. We actually create a file and delete it.
    if runuser -u nginx -- sh -c "cd '$CD' && : > .gosp-sonda && rm -f .gosp-sonda" 2>/dev/null; then
      gec "cache dir access" "nginx CAN actually write"
    else
      uyar "cache dir access" "nginx CANNOT write — fastcgi_cache dead (girginospanel-repair --only nginx_cache)"
    fi
  else
    uyar "cache dir access" "no runuser — COULD NOT MEASURE (not counted as passed)"
  fi
else
  uyar "cache dir" "$CD missing"
fi

# ══════════════════════════════════════════════════════════════════════
bas "Database"
# 🔴 PRODUCTION PATH: connect using the panel's OWN DSN. root+socket auth always works;
# if the password in env is corrupted or the GRANT is revoked, the panel won't open but
# a check that measures with root stays GREEN.
_dsn=$(grep -oE '^PANEL_DB_DSN=.*' /etc/girginospanel/env 2>/dev/null | cut -d= -f2-)
_dbu=$(printf '%s' "$_dsn" | sed -E 's#^([^:]+):.*#\1#')
_dbp=$(printf '%s' "$_dsn" | sed -E 's#^[^:]+:([^@]*)@.*#\1#')
_dbh=$(printf '%s' "$_dsn" | sed -E 's#.*tcp\(([^:]+):([0-9]+)\).*#\1#')
_dbport=$(printf '%s' "$_dsn" | sed -E 's#.*tcp\(([^:]+):([0-9]+)\).*#\2#')
_dbn=$(printf '%s' "$_dsn" | sed -E 's#.*/([a-zA-Z0-9_]+)(\?.*)?$#\1#')
if [ -n "$_dbu" ] && [ -n "$_dbn" ]; then
  _PANEL_MYSQL="mysql -N -u $_dbu -p$_dbp -h ${_dbh:-127.0.0.1} -P ${_dbport:-3306} $_dbn"
else
  _PANEL_MYSQL=""
fi
if [ -z "$_PANEL_MYSQL" ]; then
  dus "panel DB identity" "PANEL_DB_DSN could not be parsed — DB production path COULD NOT MEASURE"
elif $_PANEL_MYSQL -e 'SELECT 1' >/dev/null 2>&1; then
  gec "MariaDB connection" "OK via panel DSN ($_dbu@$_dbh/$_dbn)"
  DB=${_dbn:-panel}
  GOC=$($_PANEL_MYSQL -e "SELECT COUNT(*) FROM schema_migrations;" 2>/dev/null)
  TAB=$($_PANEL_MYSQL -e "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema='$DB';" 2>/dev/null)
  # 🔴 An empty result is NOT "0 migrations", it means "could not measure" — distinguish them.
  # 🔴 The `-gt 0` threshold was MEANINGLESS: a server with 1 of 75 migrations applied
  # passed GREEN — i.e. the very "half migration" scenario the updater's rollback path
  # is afraid of. The expected number is the count of files on disk.
  _goc_bekl=$(ls /opt/girginospanel/src/migrations/*.sql 2>/dev/null | grep -c .)
  if [ -z "$GOC" ]; then dus "migration records" "COULD NOT MEASURE (schema_migrations unreadable)"
  elif [ "${_goc_bekl:-0}" -eq 0 ]; then uyar "migration records" "$GOC applied, expected count COULD NOT MEASURE"
  elif [ "$GOC" -ge "$_goc_bekl" ] 2>/dev/null; then gec "migration records" "$GOC/$_goc_bekl applied"
  else dus "migration records" "$GOC/$_goc_bekl — HALF migration (missing: $((_goc_bekl-GOC)))"; fi
  # Table count alone cannot be a threshold — the "tables" check below compares against a
  # list DERIVED from the migrations, one to one. This is informational only; the decision
  # is made there.
  if [ -z "$TAB" ]; then dus "panel tables" "COULD NOT MEASURE"
  else gec "panel tables" "$TAB tables ($DB)"; fi
else
  dus "MariaDB connection" "COULD NOT CONNECT via panel DSN — panel won't open ($_dbu@$_dbh/$_dbn)"
fi

# ══════════════════════════════════════════════════════════════════════
bas "Tools (resolvable from PATH)"
# 🔴 A file existing IS NOT ENOUGH. `sudo` drops /usr/local/bin from PATH; the tools were
# installed yet gave "command not found", and the install silently skipped 6 steps and
# finished green.
for t in girginospanel-repair girginospanel-wpcli-kur girginospanel-wp-onkosul \
         girginospanel-optimize girginospanel-redis-setup; do
  if [ ! -x "/usr/local/bin/$t" ]; then
    uyar "$t" "not in package"
  elif ! command -v "$t" >/dev/null 2>&1; then
    dus "$t" "installed but not callable from PATH (PATH=$PATH)"
  elif [ ! -s "/usr/local/bin/$t" ]; then
    # 🔴 A 0-byte / truncated tool also looks "executable" and `command -v` finds it.
    # The lesson learned for wp-cli ("check that it RUNS, not that it exists") had not
    # been applied to the other tools.
    dus "$t" "file EMPTY (0 bytes) — half downloaded"
  elif ! head -c2 "/usr/local/bin/$t" 2>/dev/null | grep -q '#!'; then
    dus "$t" "no shebang — broken/truncated file"
  else
    gec "$t" "resolvable"
  fi
done

# wp-cli: check that it RUNS, not that it exists. A broken phar is a file too.
if [ -f /usr/local/bin/wp ]; then
  V=$(wp --version --allow-root 2>/dev/null | head -1)
  [ -n "$V" ] && gec "wp-cli" "$V" || dus "wp-cli" "file exists but DOES NOT RUN (broken phar)"
else
  uyar "wp-cli" "missing — WordPress features won't work (girginospanel-wpcli-kur)"
fi

V=$(composer --version 2>/dev/null | head -1)
[ -n "$V" ] && gec "composer" "$V" || uyar "composer" "missing"

# ══════════════════════════════════════════════════════════════════════
bas "PHP"
# 🔴 `grep -qix opcache` requires a FULL LINE match; the module is listed as "Zend OPcache"
# -> it never matches. Substring test, no pipe.
MODL=$(php -m 2>/dev/null | tr 'A-Z' 'a-z' | tr -d ' ')
if [ -z "$MODL" ]; then
  dus "PHP modules" "php -m did not run — COULD NOT MEASURE"
else
  eksik=""
  for m in gd bcmath intl soap ldap sodium opcache mysqlnd mbstring zip; do
    case "$MODL" in *"$m"*) : ;; *) eksik="$eksik $m" ;; esac
  done
  [ -z "$eksik" ] && gec "PHP modules" "10/10" || uyar "PHP modules" "MISSING:$eksik"
  case "$MODL" in
    *imagick*) gec "imagick" "installed" ;;
    *) uyar "imagick" "missing — WordPress Site Health warns (girginospanel-wp-onkosul)" ;;
  esac
fi

# ══════════════════════════════════════════════════════════════════════
bas "SELinux"
if ! command -v getenforce >/dev/null 2>&1; then
  uyar "SELinux status" "no getenforce — UNKNOWN (not counted as passed)"
else
  SEL=$(getenforce 2>/dev/null)
  SPEC='/home/c_[^/]+/(public_html|tmp)(/.*)?'
  LST=$(semanage fcontext -l 2>/dev/null)
  case "$LST" in
    *"$SPEC"*) gec "tenant docroot rule" "defined ($SEL)" ;;
    *)
      # In Enforcing, without this rule WordPress CANNOT install a plugin -> CRITICAL.
      if [ "$SEL" = "Enforcing" ]; then
        dus "tenant docroot rule" "MISSING + Enforcing — WordPress cannot write (girginospanel-wp-onkosul)"
      else
        uyar "tenant docroot rule" "missing ($SEL — if switched to Enforcing, WordPress breaks)"
      fi ;;
  esac
fi

# ══════════════════════════════════════════════════════════════════════
bas "Antivirus"
# 🔴 The agent binary EXISTS but if it doesn't join the slice, the resource limit
# constrains nothing. "Unit defined" and "process actually inside the slice" are separate
# things — on 49 the units were somehow NOT installed at all (the updater block landed in
# the wrong place).
if [ -x /usr/local/bin/girginospanel-avajan ]; then
  gec "av agent" "installed"
else
  uyar "av agent" "girginospanel-avajan missing"
fi
if [ -f /etc/systemd/system/girginos-av.slice ]; then
  _avslice=$(systemctl show girginospanel-avtara.service -p Slice --value 2>/dev/null)
  if [ "$_avslice" = "girginos-av.slice" ]; then
    gec "av resource slice" "avtara.service -> $_avslice"
  else
    dus "av resource slice" "unit DOES NOT JOIN the slice (Slice=$_avslice) — resource limit not enforced"
  fi
else
  uyar "av resource slice" "girginos-av.slice missing"
fi
_avt=$(systemctl is-active girginospanel-avtara.timer 2>/dev/null)
[ "$_avt" = "active" ] && gec "av scheduled scan" "timer active" || uyar "av scheduled scan" "timer $_avt"
[ -f /etc/systemd/system/girginospanel-avsurec.service ] && gec "av process monitor" "unit installed" || uyar "av process monitor" "girginospanel-avsurec.service MISSING (won't run silently when process monitoring is enabled)"

# 🔴 D.2 (security-auditor): RULE SET FRESHNESS. If the mirror is blocked, the agent
# cannot pull new rules and SILENTLY goes stale; the operator sees "working" while the
# rules can be months old ("failure renders as reassurance"). The mtime of the on-disk
# package = last successful remote pull. If older than 30 days, warn.
_avpaket=/var/lib/girginospanel/av/kurallar.gospav
if [ -f "$_avpaket" ]; then
  _yas=$(( ( $(date +%s) - $(stat -c%Y "$_avpaket" 2>/dev/null || echo 0) ) / 86400 ))
  if [ "$_yas" -le 30 ]; then
    gec "av rule freshness" "updated $_yas days ago"
  else
    uyar "av rule freshness" "$_yas DAYS ago — remote service may be unreachable (rules stale)"
  fi
else
  # No on-disk package: the agent never pulled successfully, the embedded base is used.
  # This is not an error (new install / isolated server) but is informational.
  gec "av rule set" "embedded base (remote set not yet fetched)"
fi

bas "Security / maintenance"
AV=$(ls /var/lib/clamav/*.c[vl]d 2>/dev/null | wc -l)
# 🔴 Just counting files is not enough: signatures left over from years ago also say
# "3 signatures". A stale signature is a placebo too — measure FRESHNESS.
if [ "${AV:-0}" -eq 0 ]; then
  uyar "ClamAV signatures" "missing — scanning without signatures (placebo)"
else
  _en_yeni=$(ls -t /var/lib/clamav/*.c[vl]d 2>/dev/null | head -1)
  _yas_gun=$(( ( $(date +%s) - $(stat -c%Y "$_en_yeni" 2>/dev/null || echo 0) ) / 86400 ))
  if [ "$_yas_gun" -le 7 ]; then
    gec "ClamAV signatures" "$AV signatures · newest $_yas_gun days ago"
  else
    uyar "ClamAV signatures" "$AV signatures but NEWEST is $_yas_gun DAYS OLD — freshclam may not be running"
  fi
fi

if [ "$(findmnt -no FSTYPE / 2>/dev/null)" = "xfs" ]; then
  if findmnt -no OPTIONS / 2>/dev/null | tr ',' '\n' | grep -qxE 'usrquota|uquota|quota'; then
    gec "disk quota" "active"
  else
    uyar "disk quota" "written in GRUB but NOT ACTIVE — a one-time reboot is required"
  fi
fi

# ══════════════════════════════════════════════════════════════════════
# DEEP VERIFICATION — file / directory / service / SQL schema / crash history
#
# The checks above ask "is the system RESPONDING?". This section asks "was the system
# INSTALLED CORRECTLY?". They are not the same: the panel may be up while a migration is
# half applied, a directory was never created, or an ops tool cannot write to disk. These
# only blow up when that feature is used — i.e. on the customer.
#
# DESIGN: to keep the output from BLOATING, each group is reported as a SUMMARY; only the
# FAILURES are listed one by one. A summary like "12/12" is more informative than zero
# lines of silence (silence cannot be told apart from "the check did not run").
# ══════════════════════════════════════════════════════════════════════

bas "Files"
# format: path|type|min_size   (type: f=file, x=executable)
_dosya_eksik=""; _dosya_ok=0; _dosya_top=0
while IFS='|' read -r _y _t _min; do
  [ -z "$_y" ] && continue
  _dosya_top=$((_dosya_top+1))
  if [ ! -e "$_y" ]; then
    _dosya_eksik="$_dosya_eksik\n      MISSING     $_y"
  elif [ "$_t" = "x" ] && [ ! -x "$_y" ]; then
    _dosya_eksik="$_dosya_eksik\n      NOT-EXEC    $_y (not executable)"
  else
    _bo=$(stat -c%s "$_y" 2>/dev/null)
    # An empty/truncated file does not count as present: a truncated frontend index.html
    # is a white screen, a truncated binary is a panel that doesn't run.
    if [ -z "$_bo" ]; then
      _dosya_eksik="$_dosya_eksik\n      UNMEASURED  $_y"
    elif [ "$_bo" -lt "${_min:-1}" ]; then
      _dosya_eksik="$_dosya_eksik\n      TRUNCATED   $_y ($_bo bytes, at least $_min expected)"
    else
      _dosya_ok=$((_dosya_ok+1))
    fi
  fi
done <<'DOSYALAR'
/opt/girginospanel/bin/girginospanel-server|x|1000000
/opt/girginospanel/frontend-dist/index.html|f|200
/etc/girginospanel/env|f|60
/etc/systemd/system/girginospanel.service|f|100
/etc/nginx/conf.d/_panel.conf|f|100
/etc/nginx/conf.d/_default80.conf|f|100
/etc/nginx/conf.d/_default443.conf|f|100
/var/www/_default80/index.html|f|200
/var/www/_default443/index.html|f|200
/usr/local/bin/girginospanel-update|x|1000
/usr/local/bin/girginospanel-repair|x|1000
/usr/local/bin/girginospanel-dogrula|x|1000
DOSYALAR
if [ -z "$_dosya_eksik" ]; then
  gec "critical files" "$_dosya_ok/$_dosya_top"
else
  dus "critical files" "$_dosya_ok/$_dosya_top$(printf "$_dosya_eksik")"
fi

# The frontend asset bundle is separate: its name is hashed, so it's searched via glob.
# 🔴 Without this check, a truncated frontend tarball silently produces a white screen;
# index.html exists but the JS bundle does not, and the panel comes in as "won't open".
_asset=$(ls /opt/girginospanel/frontend-dist/assets/index-*.js 2>/dev/null | head -1)
if [ -n "$_asset" ] && [ -s "$_asset" ]; then
  gec "frontend JS bundle" "$(basename "$_asset")"
else
  dus "frontend JS bundle" "assets/index-*.js MISSING or EMPTY — panel shows a white screen"
fi

bas "Directories"
_dizin_eksik=""; _dizin_ok=0; _dizin_top=0
while IFS='|' read -r _y _sahip; do
  [ -z "$_y" ] && continue
  _dizin_top=$((_dizin_top+1))
  if [ ! -d "$_y" ]; then
    _dizin_eksik="$_dizin_eksik\n      MISSING     $_y"
  elif [ -n "$_sahip" ]; then
    _s=$(stat -c%U "$_y" 2>/dev/null)
    if [ "$_s" != "$_sahip" ]; then
      _dizin_eksik="$_dizin_eksik\n      OWNER       $_y ($_s, expected $_sahip)"
    else
      _dizin_ok=$((_dizin_ok+1))
    fi
  else
    _dizin_ok=$((_dizin_ok+1))
  fi
done <<'DIZINLER'
/opt/girginospanel/bin|root
/opt/girginospanel/frontend-dist|root
/opt/girginospanel/src/migrations|root
/opt/girginospanel/eklentiler|
/etc/girginospanel|root
/var/www/_default80|
/var/www/_default443|
/var/cache/nginx/girgincache|nginx
DIZINLER
if [ -z "$_dizin_eksik" ]; then
  gec "critical directories" "$_dizin_ok/$_dizin_top"
else
  dus "critical directories" "$_dizin_ok/$_dizin_top$(printf "$_dizin_eksik")"
fi

# 🔴 LAZILY-CREATED DIRECTORIES — their absence is NOT a fault.
# I first put /var/backups/girginospanel in the CRITICAL list and it BLOCKED A CLEAN
# INSTALL: the backup script creates the directory itself with its own `mkdir -p` on the
# first run (03:30), so it doesn't exist yet at install end. The system was healthy, the
# check was wrong. A check that yields a false positive is WORSE than a missing check —
# and because this was a gate, it did direct harm.
for _td in /var/backups/girginospanel; do
  if [ -d "$_td" ]; then
    gec "backup directory" "$_td"
  else
    uyar "backup directory" "$_td not there yet — created on the first backup run (girginospanel-db-backup)"
  fi
done

bas "Service -> port mapping"
# 🔴 "service active" IS NOT ENOUGH: systemd can call a unit "active" while the process
# never bound to the relevant port (wrong config, bind error, port conflict). We verify
# from the socket that the service is REALLY listening.
_port_hata=""; _port_ok=0; _port_top=0
_dinlenen=$(ss -tlnH 2>/dev/null; ss -xlnH 2>/dev/null)
while IFS='|' read -r _srv _desen _aciklama; do
  [ -z "$_srv" ] && continue
  systemctl is-active --quiet "$_srv" 2>/dev/null || continue   # down service already reported above
  _port_top=$((_port_top+1))
  case "$_dinlenen" in
    *"$_desen"*) _port_ok=$((_port_ok+1)) ;;
    *) _port_hata="$_port_hata\n      $_srv ACTIVE but $_desen NOT LISTENING ($_aciklama)" ;;
  esac
done <<'PORTLAR'
mariadb|127.0.0.1:3306|cannot connect to panel DB
girginospanel|127.0.0.1:8080|nginx cannot proxy to the panel
named|:53|DNS resolution won't work
PORTLAR
if [ -z "$_port_hata" ]; then
  gec "service listening" "$_port_ok/$_port_top"
else
  dus "service listening" "$_port_ok/$_port_top$(printf "$_port_hata")"
fi

bas "FTP"
# 🔴 On 181 pure-ftpd was DOWN for 3 weeks (enabled but inactive — an offsite-backup FTP
# test stopped it and nobody started it again) AND the live pureftpd-mysql.conf said
# `MYSQLCrypt cleartext` while every active account stored a $6$ crypt hash, i.e. EVERY FTP
# login got 530. Panel login is separate from FTP, so the panel looked healthy and no check
# caught either. Measured here: service up, FTP port bound, credential mode matches the
# at-rest format of the active ftp_accounts rows. Only COUNTS and the $6$ prefix are read —
# password/hash CONTENT is never selected or printed.
#   • pure-ftpd not installed (no unit) -> skipped: not every server offers FTP.
#   • deliberately switched off (disabled/masked AND inactive) -> WARNING only: a critical
#     here would fail the update gate on every server that chose not to run FTP.
#   • otherwise not running / port not bound / mode mismatch -> CRITICAL.
# pure-ftpd MYSQLCrypt: `crypt` verifies $6$ (as does `any` = crypt/md5/password — NOT
# cleartext); `cleartext` compares the stored string as-is. GOSP_* = sandbox tests only.
_pf_mysql=${GOSP_PUREFTPD_MYSQL_CONF:-/etc/pure-ftpd/pureftpd-mysql.conf}
_pf_conf=${GOSP_PUREFTPD_CONF:-/etc/pure-ftpd/pure-ftpd.conf}
_pf_load=$(systemctl show -p LoadState --value pure-ftpd.service 2>/dev/null); _pf_load=${_pf_load%%$'\n'*}
if [ "$_pf_load" != "loaded" ] && [ "$_pf_load" != "masked" ]; then
  if [ $KISA -eq 0 ] && [ $JSON -eq 0 ]; then
    echo "  (FTP: pure-ftpd not installed — skipped)"
  fi
else
  _pf_akt=$(servis pure-ftpd)
  _pf_en=$(systemctl is-enabled pure-ftpd 2>/dev/null); _pf_en=${_pf_en%%$'\n'*}
  _pf_kapali=0
  if [ "$_pf_akt" = "active" ]; then
    gec "pure-ftpd" "active (${_pf_en:-unit state unknown})"
  else
    case "$_pf_en" in
      disabled|masked|masked-runtime)
        _pf_kapali=1
        uyar "pure-ftpd" "$_pf_akt + $_pf_en — FTP deliberately off? panel FTP accounts cannot log in (to serve FTP: systemctl enable --now pure-ftpd)" ;;
      *)
        dus "pure-ftpd" "$_pf_akt but ${_pf_en:-unit state unknown} — FTP is DOWN, every panel FTP account fails (systemctl start pure-ftpd; journalctl -u pure-ftpd -n 40)" ;;
    esac
  fi

  if [ "$_pf_kapali" = 0 ]; then
    # FTP port: `Bind [host,]port` in pure-ftpd.conf, else 21. Measured from the socket
    # (same rule as "Service -> port mapping": active is not the same as listening).
    _pf_port=$(sed -E 's/#.*//' "$_pf_conf" 2>/dev/null | awk 'tolower($1)=="bind"{v=$2} END{print v}')
    _pf_port=${_pf_port##*,}
    case "$_pf_port" in ''|*[!0-9]*) _pf_port=21 ;; esac
    if [ "$_pf_akt" = "active" ]; then
      _pf_ss=$(ss -tlnH 2>/dev/null)
      if [ -z "$_pf_ss" ]; then
        uyar "FTP port" "COULD NOT MEASURE (ss gave no output) — not counted as passed"
      elif printf '%s\n' "$_pf_ss" | awk -v s=":$_pf_port" '{ if (substr($4, length($4) - length(s) + 1) == s) f = 1 } END { exit(f ? 0 : 1) }'; then
        gec "FTP port" ":$_pf_port listening"
      else
        dus "FTP port" "pure-ftpd active but :$_pf_port NOT LISTENING — FTP clients cannot connect (journalctl -u pure-ftpd -n 40)"
      fi
    fi

    # Credential mode vs at-rest format (the 530-for-everyone class).
    if [ ! -f "$_pf_mysql" ]; then
      dus "FTP auth mode" "$_pf_mysql MISSING — pure-ftpd has no panel account backend, every FTP login fails (girginospanel-ftp-setup)"
    elif [ ! -r "$_pf_mysql" ]; then
      uyar "FTP auth mode" "COULD NOT MEASURE ($_pf_mysql unreadable) — not counted as passed"
    else
      _pf_mod=$(awk 'tolower($1)=="mysqlcrypt"{print tolower($2); exit}' "$_pf_mysql" 2>/dev/null)
      _pf_h6='$6$'; _pf_hn=""; _pf_pn=""
      if [ -n "$_PANEL_MYSQL" ]; then
        _pf_hn=$($_PANEL_MYSQL -e "SELECT COUNT(*) FROM ftp_accounts WHERE status='active' AND password_md5 LIKE '${_pf_h6}%'" 2>/dev/null)
        _pf_pn=$($_PANEL_MYSQL -e "SELECT COUNT(*) FROM ftp_accounts WHERE status='active' AND password_md5 <> '' AND password_md5 NOT LIKE '${_pf_h6}%'" 2>/dev/null)
      fi
      case "$_pf_hn$_pf_pn" in *[!0-9]*) _pf_hn="" ;; esac
      if [ -z "$_pf_hn" ] || [ -z "$_pf_pn" ]; then
        uyar "FTP auth mode" "COULD NOT MEASURE (ftp_accounts unreadable via panel DSN) — MYSQLCrypt ${_pf_mod:-not set}, not counted as passed"
      elif [ -z "$_pf_mod" ]; then
        uyar "FTP auth mode" "MYSQLCrypt NOT SET in $_pf_mysql — COULD NOT VERIFY against $_pf_hn \$6\$ / $_pf_pn other active account(s) (expected: crypt)"
      elif [ "$_pf_hn" -gt 0 ]; then
        case "$_pf_mod" in
          crypt|any) gec "FTP auth mode" "MYSQLCrypt $_pf_mod · $_pf_hn active \$6\$ account(s)" ;;
          *) dus "FTP auth mode" "MYSQLCrypt $_pf_mod but $_pf_hn active account(s) store \$6\$ crypt hashes — EVERY FTP login fails with 530. Fix: MYSQLCrypt crypt in $_pf_mysql + systemctl restart pure-ftpd (girginospanel-update reconciles it)" ;;
        esac
        if [ "$_pf_pn" -gt 0 ]; then
          uyar "FTP account format" "$_pf_pn of $((_pf_hn + _pf_pn)) active account(s) NOT stored as \$6\$ — they fail under MYSQLCrypt $_pf_mod (the panel re-hashes legacy plaintext on start: systemctl restart girginospanel)"
        fi
      elif [ "$_pf_pn" -gt 0 ]; then
        # Legacy server: all active accounts still plaintext (panel sifreheal has not run).
        case "$_pf_mod" in
          cleartext) gec "FTP auth mode" "MYSQLCrypt cleartext · $_pf_pn active legacy plaintext account(s)" ;;
          *) dus "FTP auth mode" "MYSQLCrypt $_pf_mod but all $_pf_pn active account(s) are plaintext — EVERY FTP login fails with 530 (the panel re-hashes them on start: systemctl restart girginospanel, then girginospanel-update)" ;;
        esac
      else
        case "$_pf_mod" in
          crypt|any) gec "FTP auth mode" "MYSQLCrypt $_pf_mod · no active FTP accounts" ;;
          *) uyar "FTP auth mode" "MYSQLCrypt $_pf_mod with no active FTP accounts — new accounts are stored as \$6\$ and will fail with 530 (set MYSQLCrypt crypt + systemctl restart pure-ftpd)" ;;
        esac
      fi
    fi
  fi
fi

bas "SQL schema (derived from migrations)"
# 🔴 The expected schema is NOT MAINTAINED BY HAND — it is DERIVED from the migration
# files. A hand-maintained list inevitably goes stale and falls into "the check exists but
# doesn't measure". Source: /opt/girginospanel/src/migrations/*.sql
_MIGR=/opt/girginospanel/src/migrations
_DB=$(grep -oE 'tcp\([^)]*\)/[a-zA-Z0-9_]+' /etc/girginospanel/env 2>/dev/null | sed 's#.*/##')
_DB=${_DB:-panel}

if [ ! -d "$_MIGR" ]; then
  dus "migration source" "$_MIGR missing — schema COULD NOT BE VERIFIED"
elif [ -z "$_PANEL_MYSQL" ] || ! $_PANEL_MYSQL -e 'SELECT 1' >/dev/null 2>&1; then
  dus "schema verification" "could not connect to MariaDB — COULD NOT MEASURE"
else
  # ── 1) Is each migration file APPLIED + does its sha256 MATCH ──
  # Because schema_migrations holds (dosya, sha256, uygulandi), we can also catch drift:
  # if a file was changed but not re-applied, the hash won't match.
  _uyg_eksik=""; _uyg_ok=0; _uyg_top=0; _hash_fark=""
  _uygulanan=$($_PANEL_MYSQL -e "SELECT CONCAT(dosya,'=',sha256) FROM schema_migrations;" 2>/dev/null)
  if [ -z "$_uygulanan" ]; then
    dus "migration records" "schema_migrations UNREADABLE — schema COULD NOT BE VERIFIED"
  else
    for _f in "$_MIGR"/*.sql; do
      [ -f "$_f" ] || continue
      _uyg_top=$((_uyg_top+1))
      _ad=$(basename "$_f")
      _sha=$(sha256sum "$_f" 2>/dev/null | awk '{print $1}')
      case "$_uygulanan" in
        *"$_ad=$_sha"*) _uyg_ok=$((_uyg_ok+1)) ;;
        *"$_ad="*)      _hash_fark="$_hash_fark\n      HASH MISMATCH  $_ad (file changed, not re-applied)" ;;
        *)              _uyg_eksik="$_uyg_eksik\n      NOT-APPLIED $_ad" ;;
      esac
    done
    # 🔴 SEVERITY DISTINCTION — evidence-based:
    #   NOT-APPLIED migration -> CRITICAL. The schema may be incomplete, the panel breaks
    #                            on that feature.
    #   HASH MISMATCH         -> WARNING.  The file changed, but whether it AFFECTS the
    #                            schema cannot be known here. The real evidence is the
    #                            table/column checks below; if they pass, there is NO impact.
    # Otherwise a harmless comment change on the build server would flash CRITICAL every
    # run and devalue the signal.
    _hash_fark_sayisi=$(printf "%s" "$_hash_fark" | grep -c "HASH MISMATCH")
    if [ -n "$_uyg_eksik" ]; then
      dus "migration files" "$_uyg_ok/$_uyg_top$(printf "$_uyg_eksik$_hash_fark")"
    elif [ -n "$_hash_fark" ]; then
      uyar "migration files" "$_uyg_ok/$_uyg_top — $_hash_fark_sayisi file(s) changed but not re-applied$(printf "$_hash_fark")"
    else
      gec "migration files" "$_uyg_ok/$_uyg_top applied (name+sha256)"
    fi
  fi

  # ── 2) Does every table defined with CREATE TABLE EXIST in the DB ──
  _mevcut=$($_PANEL_MYSQL -e "SELECT LOWER(table_name) FROM information_schema.tables WHERE table_schema='$_DB';" 2>/dev/null)
  if [ -z "$_mevcut" ]; then
    dus "tables" "information_schema UNREADABLE"
  else
    # 🔴 THE PARSER PRODUCED A FALSE POSITIVE TWICE, both fixed:
    #  1) In `CREATE TABLE( IF NOT EXISTS)? <name>`, when the optional group didn't match,
    #     `[a-z0-9_]+` mistook the word "IF" for the TABLE NAME -> a bogus "MISSING if"
    #     finding on every server. Fix: strip IF NOT EXISTS FIRST.
    #  2) DROP TABLE was not counted at all. cp_banned_tlds is created in 0060 and DROPped
    #     in 0061; the table is LEGITIMATELY gone but the check flashed red "MISSING".
    # A check that yields a false positive is WORSE than a missing check: it trains people
    # to ignore the red. The expected schema is computed by processing the migrations IN
    # ORDER (CREATE adds, DROP removes).
    _beklenen_tablolar() {
      local f
      for f in $(ls "$_MIGR"/*.sql 2>/dev/null | sort); do
        sed -E 's/CREATE[[:space:]]+TABLE([[:space:]]+IF[[:space:]]+NOT[[:space:]]+EXISTS)?[[:space:]]+/@CT@ /Ig;
                s/DROP[[:space:]]+TABLE([[:space:]]+IF[[:space:]]+EXISTS)?[[:space:]]+/@DT@ /Ig' "$f" \
        | grep -oE '@[CD]T@ `?[a-zA-Z0-9_]+' \
        | sed -E 's/`//g' \
        | awk '{print $1" "tolower($2)}'
      done | awk '
        $1=="@CT@" { var[$2]=1 }
        $1=="@DT@" { delete var[$2] }
        END { for (t in var) print t }
      ' | sort -u
    }
    _tab_eksik=""; _tab_ok=0; _tab_top=0
    for _t in $(_beklenen_tablolar); do
      _tab_top=$((_tab_top+1))
      case "
$_mevcut
" in
        *"
$_t
"*) _tab_ok=$((_tab_ok+1)) ;;
        *)  _tab_eksik="$_tab_eksik\n      MISSING  $_t" ;;
      esac
    done
    if [ -z "$_tab_eksik" ]; then
      gec "tables" "$_tab_ok/$_tab_top (derived from migrations)"
    else
      dus "tables" "$_tab_ok/$_tab_top$(printf "$_tab_eksik")"
    fi
  fi

  # Columns follow the same logic as tables: ADD COLUMN adds, DROP COLUMN removes, files
  # are processed IN ORDER. Columns of a DROPped table are also removed — otherwise a
  # deleted table's column would look "missing".
  _beklenen_kolonlar() {
    local f
    for f in $(ls "$_MIGR"/*.sql 2>/dev/null | sort); do
      sed -E 's/ALTER[[:space:]]+TABLE[[:space:]]+`?([a-zA-Z0-9_]+)`?[[:space:]]+ADD[[:space:]]+COLUMN([[:space:]]+IF[[:space:]]+NOT[[:space:]]+EXISTS)?[[:space:]]+`?([a-zA-Z0-9_]+)`?/@AC@ \1 \3/Ig;
              s/ALTER[[:space:]]+TABLE[[:space:]]+`?([a-zA-Z0-9_]+)`?[[:space:]]+DROP[[:space:]]+COLUMN([[:space:]]+IF[[:space:]]+EXISTS)?[[:space:]]+`?([a-zA-Z0-9_]+)`?/@DC@ \1 \3/Ig;
              s/DROP[[:space:]]+TABLE([[:space:]]+IF[[:space:]]+EXISTS)?[[:space:]]+`?([a-zA-Z0-9_]+)`?/@DT@ \2/Ig' "$f" \
      | grep -oE '@(AC|DC|DT)@ [a-zA-Z0-9_]+( [a-zA-Z0-9_]+)?' \
      | awk '{ if ($1=="@DT@") print $1" "tolower($2); else print $1" "tolower($2)" "tolower($3) }'
    done | awk '
      $1=="@AC@" { var[$2"."$3]=1 }
      $1=="@DC@" { delete var[$2"."$3] }
      $1=="@DT@" { for (k in var) { split(k,a,"."); if (a[1]==$2) delete var[k] } }
      END { for (k in var) print k }
    ' | sort -u
  }

  # ── 3) Do the columns added with ALTER TABLE ... ADD COLUMN EXIST ──
  # 🔴 "table exists but column missing" is the most common symptom of a half-applied
  # migration: the panel opens, then blows up with "Unknown column" when the feature is
  # used. The table count NEVER catches this.
  _kol_eksik=""; _kol_ok=0; _kol_top=0
  _kolonlar=$($_PANEL_MYSQL -e "SELECT CONCAT(LOWER(table_name),'.',LOWER(column_name)) FROM information_schema.columns WHERE table_schema='$_DB';" 2>/dev/null)
  if [ -z "$_kolonlar" ]; then
    dus "columns" "information_schema.columns UNREADABLE"
  else
    while read -r _tk; do
      [ -z "$_tk" ] && continue
      _kol_top=$((_kol_top+1))
      case "
$_kolonlar
" in
        *"
$_tk
"*) _kol_ok=$((_kol_ok+1)) ;;
        *)  _kol_eksik="$_kol_eksik\n      MISSING  $_tk" ;;
      esac
    done <<EOF
$(_beklenen_kolonlar)
EOF
    if [ "$_kol_top" -eq 0 ]; then
      uyar "columns" "no ALTER TABLE ADD COLUMN pattern found — NO MEASUREMENT WAS MADE"
    elif [ -z "$_kol_eksik" ]; then
      gec "columns" "$_kol_ok/$_kol_top (derived from ALTER TABLEs)"
    else
      dus "columns" "$_kol_ok/$_kol_top$(printf "$_kol_eksik")"
    fi
  fi
fi

bas "Crash history"
# 🔴 `journalctl -p err` DOES NOT CATCH Go panic/SIGSEGV RECORDS — they land on stderr at
# "notice" priority. In a fleet audit exactly this was seen: `-p err` said "-- No entries --"
# while a plain grep found the SIGSEGV crash. Any alarm that runs with a priority filter
# misses this class entirely.
_cok=$(journalctl -u girginospanel --since "24 hours ago" --no-pager 2>/dev/null \
       | grep -ciE 'panic:|SIGSEGV|SIGBUS|fatal error:|runtime error:')
if [ -z "$_cok" ]; then
  uyar "panel crashes" "journal UNREADABLE — not counted as passed"
elif [ "$_cok" -eq 0 ]; then
  gec "panel crashes" "none in the last 24 hours"
else
  dus "panel crashes" "$_cok record(s) in the last 24 hours (journalctl -u girginospanel | grep -iE 'panic|SIGSEGV|fatal')"
fi

bas "Panel access restriction"
# 🔴 If the panel answers to every hostname, anyone who knows the server's IP sees the
# login screen. In a fleet audit, 2 of 5 servers had NO restriction with `server_name _`.
# This is not a vulnerability but it needlessly widens the attack surface.
_pf=${GOSP_PANEL_CONF:-/etc/nginx/conf.d/_panel.conf}
if [ ! -f "$_pf" ]; then
  uyar "panel host restriction" "_panel.conf missing — COULD NOT MEASURE"
else
  _sn=$(grep -oE '^[[:space:]]*server_name[[:space:]]+[^;]*' "$_pf" 2>/dev/null | head -1 | sed 's/^[[:space:]]*server_name[[:space:]]*//')
  # 🔴 RK-OPS-07: ONE loopback listen line is NOT "loopback only". In gate + desktop mode
  # the admin gate listens on 127.0.0.1 while the reseller/customer/legacy gates listen
  # publicly; counting the loopback line alone passed that as "loopback only" and hid the
  # server_name warning. Count the UNCOMMENTED listen directives that are NOT loopback.
  # Comments are stripped first (erisim leaves "# [erisim:masaustu] listen [::]:..." behind);
  # the directive is matched at a token boundary, not only at line start, so a public
  # `server { listen 8443 ssl;` on one line is not missed (missing it = false "loopback only").
  # (read loop, not `for x in $(...)`: "[::]:8443" is also a glob pattern)
  _lo=0; _genel=0
  while read -r _la; do
    [ -z "$_la" ] && continue
    case "$_la" in
      127.*|localhost|localhost:*|'[::1]'|'[::1]:'*|unix:*) _lo=$((_lo+1)) ;;
      *) _genel=$((_genel+1)) ;;
    esac
  done <<EOF
$(sed -E 's/#.*//' "$_pf" 2>/dev/null | grep -oE '(^|[;{[:space:]])listen[[:space:]]+[^[:space:];]+' | sed -E 's/^.*listen[[:space:]]+//')
EOF
  if [ "$_lo" -gt 0 ] && [ "$_genel" -eq 0 ]; then
    gec "panel host restriction" "listening on loopback only"
  elif [ "$_sn" = "_" ]; then
    uyar "panel host restriction" "server_name _ — the panel answers to EVERY hostname (restrict with girginospanel-panelhost)"
  elif [ -n "$_sn" ]; then
    gec "panel host restriction" "allow-list defined"
  else
    uyar "panel host restriction" "server_name UNREADABLE"
  fi
fi

bas "Clock sync"
# 🔴 In a fleet audit a LIVE CUSTOMER server's clock was 24 HOURS ahead and NTP was off.
# Certificate validity, JWT expiry, backup timestamps and cron scheduling are all affected
# by this; none of them shows up as an "error".
if command -v timedatectl >/dev/null 2>&1; then
  _senk=$(timedatectl show -p NTPSynchronized --value 2>/dev/null)
  case "$_senk" in
    yes) gec "clock sync" "NTP synced" ;;
    no)  uyar "clock sync" "NTP NOT SYNCED — cert/JWT/backup time may drift" ;;
    *)   uyar "clock sync" "COULD NOT MEASURE" ;;
  esac
else
  uyar "clock sync" "no timedatectl — COULD NOT MEASURE"
fi

# ══════════════════════════════════════════════════════════════════════
if [ $JSON -eq 1 ]; then
  printf '{"gecen":%d,"kritik":%d,"uyari":%d,"dusenler":[' "$GECEN" "$KRITIK" "$UYARI"
  ilk=1
  for d in "${DUSENLER[@]:-}"; do
    [ -z "$d" ] && continue
    [ $ilk -eq 0 ] && printf ','; ilk=0
    # 🔴 " and \\ must be escaped; otherwise the detail string breaks the JSON (measured).
    _jk() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g' | tr -d '\n'; }
    printf '{"seviye":"%s","kontrol":"%s","detay":"%s"}' "$(_jk "${d%%|*}")" "$(_jk "$(echo "$d" | cut -d'|' -f2)")" "$(_jk "$(echo "$d" | cut -d'|' -f3)")"
  done
  printf ']}\n'
  [ $KRITIK -gt 0 ] && exit 1 || exit 0
fi

if [ $JSON -eq 1 ]; then exit $([ $KRITIK -gt 0 ] && echo 1 || echo 0); fi
echo
if [ $KRITIK -gt 0 ]; then
  echo -e "${c_r}${c_b}✗ VERIFICATION FAILED${c_0}  —  passed: $GECEN   ${c_r}critical: $KRITIK${c_0}   warnings: $UYARI"
  echo -e "  ${c_r}The install/update IS NOT CONSIDERED COMPLETE.${c_0} Fix the ✗ lines above and run again:"
  echo -e "    girginospanel-dogrula"
  exit 1
fi
if [ $UYARI -gt 0 ]; then
  echo -e "${c_g}${c_b}✓ Critical checks passed${c_0}  —  passed: $GECEN   warnings: ${c_y}$UYARI${c_0}"
  echo -e "  Warnings do not stop the system but mean feature loss (see above)."
  exit 0
fi
echo -e "${c_g}${c_b}✓ All checks passed${c_0}  —  $GECEN checks"
exit 0
