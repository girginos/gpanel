#!/usr/bin/env bash
# girginospanel-erisim — panel erişim modunu SSH'tan yönet.
#
# Panele iki türlü girilir:
#   web       : panel portu firewall'da DIŞARI AÇIK.
#               Herhangi bir tarayıcıdan girilir.
#   masaustu  : panel portu dışarı KAPALI. Panele yalnız GirginOS AI masaüstü
#               uygulaması, SSH (22) üzerinden kurduğu tünelle erişir.
#               En sıkı kurulum: panel arayüzü internete hiç açılmaz.
#   Rol kapıları (ADR-GP-001) kuruluysa "panel portu" ADMIN kapısıdır: masaüstü
#   modu yalnız yönetici yüzeyini kapatır, bayi/müşteri kapıları açık kalır.
#
# Kullanım:
#   girginospanel-erisim durum
#   girginospanel-erisim web
#   girginospanel-erisim desktop      (masaustu = ayni komut)
#   girginospanel-erisim baglanti-linki [host]     # panel için girginospanel:// linki üret
#
# Not: nft/firewalld/iptables otomatik seçilir. Panelin kendi tablosu
# `inet girginos_fw` tercih edilir (bkz. internal/hostuyg/firewall.go).
set -uo pipefail

c_g=$'\e[32m'; c_y=$'\e[33m'; c_r=$'\e[31m'; c_b=$'\e[1m'; c_0=$'\e[0m'
say()  { echo -e "$*"; }
ok()   { echo -e "  ${c_g}✓${c_0} $*"; }
warn() { echo -e "  ${c_y}!${c_0} $*"; }
err()  { echo -e "  ${c_r}✗${c_0} $*" >&2; }

# Yollar: GOSP_* yalnız kum havuzu testleri içindir (varsayılanlar gerçek sistem yolları).
# Usage text (English). The Turkish header comment above is developer documentation.
kullanim() {
  cat <<'KULLANIM'
girginospanel-erisim — manage the panel access mode over SSH.

The panel can be reached in two ways:
  web        the panel port is OPEN to the outside in the firewall; any browser can connect.
  desktop    the panel port is CLOSED to the outside. Only the GirginOS AI desktop app can
             reach the panel, through a tunnel over SSH (22). The strictest setup: the panel
             UI is never exposed to the internet. (alias: masaustu)
When role gates are installed, the "panel port" is the ADMIN gate: desktop mode only closes
the admin surface; the reseller/customer gates stay open.

Usage:
  girginospanel-erisim [durum | status]
  girginospanel-erisim web
  girginospanel-erisim desktop            (masaustu is the same command)
  girginospanel-erisim baglanti-linki [host]    print a girginospanel:// link for the panel
  girginospanel-erisim -h | --help

nft/firewalld/iptables is selected automatically; the panel's own table `inet girginos_fw`
is preferred.
KULLANIM
}

DURUM_DOSYA=${GOSP_ERISIM_MODU:-/etc/girginospanel/erisim-modu}

KAPI_AYAR=${GOSP_KAPI_AYAR:-/etc/girginospanel/kapi.json}
# Panelin zorlama bayrağının dosya yansıması ("acik" | "kapali"; tmpfs — açılışta ölçüm
# bitene dek YOKTUR). Bkz. internal/provisioner/panelkapi.go kapiZorlamaDosyasi.
KAPI_ZORLAMA=${GOSP_KAPI_ZORLAMA:-/run/girginospanel/kapi-zorlama}

# ---- rol kapıları (ADR-GP-001) ----
# Kapı modunda "panel portu" = ADMIN kapısı: masaüstü modu yalnız yönetici yüzeyini
# internetten çeker; bayi/müşteri kapıları açık kalır (kullanıcılar etkilenmez).
# kapi.json doğrudan okunur — panel ikilisi ÇALIŞTIRILMAZ (eski bir ikili bilinmeyen
# argümanla sunucuyu başlatırdı).
kapi_portu() { # rol
  grep -oE "\"$1\": *[0-9]+" "$KAPI_AYAR" 2>/dev/null | grep -oE '[0-9]+$' | head -1
}
kapi_eski_portlari() {
  tr -d ' \n' < "$KAPI_AYAR" 2>/dev/null | grep -oE '"eski_portlar":\[[0-9,]*\]' | grep -oE '[0-9]+' | tr '\n' ' '
}

# ---- kapı zorlaması GERÇEKTEN açık mı? (RK-OPS-06) ----
# 🔴 kapi.json'da admin portu olması rol ayrımının İŞLEDİĞİ anlamına GELMEZ. Panel
# nginx→panel zincirini ölçemezse zorlamayı kapatır (güvenli başarısızlık = eski tek-port
# davranışı): o sırada bayi, müşteri ve eski kapıların HER BİRİ yönetici girişini de kabul
# eder — admin kapısını loopback'e çekmek yönetici yüzeyini KAPATMAZ. Bu yüzden "yalnız
# yönetici yüzeyi kapandı" demeden önce iki bağımsız ölçüm:
#   1) panelin bayrağı: $KAPI_ZORLAMA = "acik"
#   2) üretim yolu: müşteri kapısında yönetici giriş ucu YOKTUR → 404. Zorlama kapalıyken
#      aynı istek 400 döner (boş gövde). Gövde '{}': kimlik bilgisi gönderilmez; denetim
#      kaydı ve kaba-kuvvet sayacı etkilenmez (sayaç yalnız 401'i sayar).
# İkisi birlikte doğrulanmadıkça başarı İDDİA EDİLMEZ; ölçülemeyen = doğrulanmamış.
# Çıktı: KAPI_ZORLAMA_DURUM = acik | kapali | olculemedi, KAPI_ZORLAMA_OLCUM = ayrıntı.
KAPI_ZORLAMA_DURUM=""; KAPI_ZORLAMA_OLCUM=""
kapi_zorlama_olc() { # -> 0 yalnız zorlama KANITLI açıksa
  local bayrak mp kod b_ac=0 b_kapali=0 u_ac=0 u_kapali=0 bd ud
  bayrak=$(head -c 32 "$KAPI_ZORLAMA" 2>/dev/null | tr -d '[:space:]')
  case "$bayrak" in
    acik)   b_ac=1;     bd="flag: on" ;;
    kapali) b_kapali=1; bd="flag: OFF ($KAPI_ZORLAMA)" ;;
    "")     bd="flag unreadable ($KAPI_ZORLAMA missing — panel measurement not finished or old version)" ;;
    *)      bd="flag not recognized ('${bayrak//[!a-zA-Z0-9_-]/?}')" ;;
  esac
  mp=$(kapi_portu musteri)
  if [ -z "$mp" ]; then
    ud="customer gate port missing in $KAPI_AYAR — login endpoint could not be measured"
  else
    kod=$(curl -sk -m 5 -o /dev/null -w '%{http_code}' -X POST \
          -H 'Content-Type: application/json' --data '{}' \
          "https://127.0.0.1:$mp/api/v1/auth/login" 2>/dev/null)
    case "$kod" in
      404)         u_ac=1;     ud="customer gate :$mp admin login: 404 (endpoint absent)" ;;
      400|401|200) u_kapali=1; ud="customer gate :$mp admin login: HTTP $kod — endpoint OPEN" ;;
      ""|000)      ud="customer gate :$mp could not connect — login endpoint could not be measured" ;;
      *)           ud="customer gate :$mp HTTP $kod — login endpoint could not be measured" ;;
    esac
  fi
  KAPI_ZORLAMA_OLCUM="$bd · $ud"
  if [ $b_ac -eq 1 ] && [ $u_ac -eq 1 ]; then
    KAPI_ZORLAMA_DURUM=acik; return 0
  fi
  if [ $b_kapali -eq 1 ] || [ $u_kapali -eq 1 ]; then
    KAPI_ZORLAMA_DURUM=kapali
  else
    KAPI_ZORLAMA_DURUM=olculemedi
  fi
  return 1
}

# ---- panel portunu bul (kapı modunda admin kapısı; değilse nginx listen satırından) ----
panel_portu() {
  local p
  p=$(kapi_portu admin)
  if [ -z "$p" ]; then
    p=$(grep -hoE '^\s*listen\s+([0-9]+)\s+ssl' "$PANEL_CONF" 2>/dev/null \
        | grep -oE '[0-9]+' | head -1)
  fi
  echo "${p:-8443}"
}

# ---- firewall arka ucu ----
fw_backend() {
  if command -v nft >/dev/null 2>&1; then
    if nft list chain inet girginos_fw input >/dev/null 2>&1; then echo "nft:girginos_fw"; return; fi
    if nft list chain inet filter input     >/dev/null 2>&1; then echo "nft:filter";      return; fi
  fi
  if command -v firewall-cmd >/dev/null 2>&1 && systemctl is-active firewalld >/dev/null 2>&1; then
    echo "firewalld"; return
  fi
  command -v iptables >/dev/null 2>&1 && { echo "iptables"; return; }
  echo "none"
}

YORUM_ONEK="gpanel-erisim kapali"

# 🔴 ZİNCİR POLİTİKASI BELİRLEYİCİ.
# Panelin nft zinciri `policy accept` ile geliyor: bu durumda AÇIK olmak için
# kural GEREKMEZ — kapatmak için AÇIK BİR DROP kuralı gerekir. Politikayı
# yok sayıp "accept kuralı var mı" diye bakmak yanlış sonuç verir
# (port aslında erişilebilirken "kapalı" görünürdü).
nft_tablo() { local be; be=$(fw_backend); echo "${be#nft:}"; }

nft_politika() { # -> accept | drop
  local t; t=$(nft_tablo)
  nft list chain inet "$t" input 2>/dev/null \
    | grep -oE 'policy [a-z]+' | awk '{print $2}' | head -1
}

# 🔴 `komut | grep -q` KULLANMA (set -o pipefail): grep -q ilk eşleşmede çıkar, üreten
# komut (nft/iptables/ss) çıktısının kalanını yazarken SIGPIPE ile ölür ve pipefail boru
# hattını BAŞARISIZ sayar → eşleşme VAR iken "yok" (ör. drop kuralı görülmez → port "AÇIK",
# SONUÇ yanlış mod; ss'te doğru değişiklik "soket bağlanmadı" diye GERİ ALINIR). Kum
# havuzunda çok parçalı yazan nft ile ölçüldü. grep'i -q'suz, >/dev/null ile kullan (tüm
# girdiyi okur); `head` gibi erken çıkanları da boru ortasında kullanma.
drop_kurali_var() { # port
  local t; t=$(nft_tablo)
  nft list chain inet "$t" input 2>/dev/null | grep -E "dport $1 (drop|reject)" >/dev/null
}

port_acik_mi() { # port
  local be pol; be=$(fw_backend)
  case "$be" in
    nft:*)
      pol=$(nft_politika)
      if [ "$pol" = "accept" ]; then
        # Politika accept: açık DROP kuralı yoksa port AÇIK
        drop_kurali_var "$1" && return 1 || return 0
      else
        # Politika drop: açık ACCEPT kuralı gerekir
        nft list chain inet "$(nft_tablo)" input 2>/dev/null | grep "dport $1 accept" >/dev/null
      fi ;;
    firewalld) firewall-cmd --list-ports 2>/dev/null | grep -w "$1/tcp" >/dev/null ;;
    iptables)
      iptables -L INPUT -n 2>/dev/null | grep -E "DROP.*dpt:$1" >/dev/null && return 1
      if iptables -L INPUT -n 2>/dev/null | sed -n '1,2p' | grep "policy ACCEPT" >/dev/null; then return 0; fi
      iptables -L INPUT -n 2>/dev/null | grep -E "ACCEPT.*dpt:$1" >/dev/null ;;
    *) return 1 ;;
  esac
}

port_ac() { # port  -> DROP kuralını kaldır (ve gerekirse accept ekle)
  local be pol t h; be=$(fw_backend)
  case "$be" in
    nft:*)
      t=$(nft_tablo); pol=$(nft_politika)
      # Bu porta ait drop/reject kurallarını sil
      while :; do
        h=$(nft -a list chain inet "$t" input 2>/dev/null \
            | awk -v p="dport $1 (drop|reject)" '$0 ~ p {for(i=1;i<=NF;i++) if($i=="handle"){print $(i+1); exit}}')
        [ -z "$h" ] && break
        nft delete rule inet "$t" input handle "$h" 2>/dev/null || break
      done
      # Politika drop ise ayrıca accept gerekir
      if [ "$pol" != "accept" ]; then
        nft list chain inet "$t" input 2>/dev/null | grep "dport $1 accept" >/dev/null || \
          printf 'add rule inet %s input tcp dport %s accept comment "gpanel-erisim acik %s"\n' "$t" "$1" "$1" | nft -f -
      fi ;;
    firewalld) firewall-cmd --permanent --add-port="$1/tcp" >/dev/null && firewall-cmd --reload >/dev/null ;;
    iptables)
      while iptables -D INPUT -p tcp --dport "$1" -j DROP 2>/dev/null; do :; done
      iptables -C INPUT -p tcp --dport "$1" -j ACCEPT 2>/dev/null || \
        iptables -I INPUT -p tcp --dport "$1" -j ACCEPT ;;
    *) return 1 ;;
  esac
}

port_kapat() { # port -> accept kurallarını sil + DROP ekle
  local be t h; be=$(fw_backend)
  case "$be" in
    nft:*)
      t=$(nft_tablo)
      # Önce bu porta ait accept kurallarını temizle
      while :; do
        h=$(nft -a list chain inet "$t" input 2>/dev/null \
            | awk -v p="dport $1 accept" '$0 ~ p {for(i=1;i<=NF;i++) if($i=="handle"){print $(i+1); exit}}')
        [ -z "$h" ] && break
        nft delete rule inet "$t" input handle "$h" 2>/dev/null || break
      done
      # Sonra AÇIK drop kuralı ekle (politika accept olsa bile kapansın).
      # 🔴 `iif lo` HARİÇ: SSH tüneli sunucunun İÇİNDEN 127.0.0.1'e bağlanır,
      # onu kapatırsak masaüstü uygulaması da giremez.
      drop_kurali_var "$1" || \
        printf 'add rule inet %s input iif != "lo" tcp dport %s drop comment "%s %s"\n' \
          "$t" "$1" "$YORUM_ONEK" "$1" | nft -f - ;;
    firewalld) firewall-cmd --permanent --remove-port="$1/tcp" >/dev/null; firewall-cmd --reload >/dev/null ;;
    iptables)
      while iptables -D INPUT -p tcp --dport "$1" -j ACCEPT 2>/dev/null; do :; done
      iptables -C INPUT ! -i lo -p tcp --dport "$1" -j DROP 2>/dev/null || \
        iptables -I INPUT ! -i lo -p tcp --dport "$1" -j DROP ;;
    *) return 1 ;;
  esac
}

# ================= nginx DİNLEME ADRESİ =================
# 🔴 Firewall'dan DAHA GÜÇLÜ katman: nginx'i 127.0.0.1'e bağlarsak port hiçbir
# dış arayüzde dinlenmez — TCP el sıkışması bile olmaz, API dahil hiçbir şeye
# dışarıdan ulaşılamaz. SSH tüneli sunucunun İÇİNDEN 127.0.0.1'e bağlandığı
# için masaüstü uygulaması çalışmaya devam eder.
PANEL_CONF=${GOSP_PANEL_CONF:-/etc/nginx/conf.d/_panel.conf}
CATCHALL_CONF=${GOSP_CATCHALL_CONF:-/etc/nginx/conf.d/_panel_catchall.conf}

nginx_loopback_mi() { # port
  grep -qE "^\s*listen\s+127\.0\.0\.1:$1\s+ssl" "$PANEL_CONF" 2>/dev/null
}

nginx_yedekle() {
  local ts; ts=$(date +%s)
  cp -a "$PANEL_CONF" "${PANEL_CONF}.erisim.${ts}" 2>/dev/null
  [ -f "$CATCHALL_CONF" ] && cp -a "$CATCHALL_CONF" "${CATCHALL_CONF}.erisim.${ts}" 2>/dev/null
  echo "$ts"
}

nginx_geri_al() { # ts
  [ -f "${PANEL_CONF}.erisim.$1" ] && cp -a "${PANEL_CONF}.erisim.$1" "$PANEL_CONF"
  [ -f "${CATCHALL_CONF}.erisim.$1" ] && cp -a "${CATCHALL_CONF}.erisim.$1" "$CATCHALL_CONF"
  systemctl restart nginx >/dev/null 2>&1 || nginx -s reload >/dev/null 2>&1
}

# Dinleme adresini değiştir. mod=loopback | genel
nginx_listen_ayarla() { # port mod
  local port="$1" mod="$2" ts f
  ts=$(nginx_yedekle)
  for f in "$PANEL_CONF" "$CATCHALL_CONF"; do
    [ -f "$f" ] || continue
    if [ "$mod" = "loopback" ]; then
      # IPv6 dinleyicisini KAPAT (yorum satırı yap) — dışarı sızmasın
      sed -i -E "s|^(\s*)listen\s+\[::\]:$port\s+ssl(.*)$|\1# [erisim:masaustu] listen [::]:$port ssl\2|" "$f"
      sed -i -E "s|^(\s*)listen\s+$port\s+ssl(.*)$|\1listen 127.0.0.1:$port ssl\2|" "$f"
    else
      sed -i -E "s|^(\s*)listen\s+127\.0\.0\.1:$port\s+ssl(.*)$|\1listen $port ssl\2|" "$f"
      sed -i -E "s|^(\s*)# \[erisim:masaustu\] listen \[::\]:$port ssl(.*)$|\1listen [::]:$port ssl\2|" "$f"
    fi
  done
  if ! nginx -t >/dev/null 2>&1; then
    err "nginx -t FAILED — rolling the change back"
    nginx -t 2>&1 | tail -3 >&2
    nginx_geri_al "$ts"
    return 1
  fi
  # 🔴 RELOAD YETMEZ: `nginx -s reload` DİNLEME SOKETLERİNİ DEĞİŞTİRMEZ —
  # yeni worker'lar master'ın açtığı eski soketleri miras alır. `listen`
  # direktifi değiştiyse soketin yeniden açılması için TAM RESTART gerekir.
  # (Belirti: config'te 127.0.0.1:9443 yazar ama `ss -tlnp` hâlâ 0.0.0.0:9443
  #  gösterir ve port dışarıdan yanıt vermeye devam eder.)
  if ! systemctl restart nginx >/dev/null 2>&1; then
    err "nginx restart failed — rolling back"; nginx_geri_al "$ts"
    systemctl restart nginx >/dev/null 2>&1
    return 1
  fi
  sleep 1
  # Soket gerçekten istenen adrese bağlandı mı? Bağlanmadıysa geri al.
  local beklenen
  if [ "$mod" = "loopback" ]; then beklenen="127.0.0.1:$port"; else beklenen="0.0.0.0:$port"; fi
  if ! ss -tln 2>/dev/null | grep -F "$beklenen" >/dev/null; then
    err "socket did not bind to the expected address ($beklenen) — rolling back"
    nginx_geri_al "$ts"; systemctl restart nginx >/dev/null 2>&1
    return 1
  fi
  return 0
}

# Dışarıdan gerçekten erişilebiliyor mu? (loopback DEĞİL, dış IP üzerinden)
dis_erisim_var_mi() { # port
  local ip; ip=$(dis_ip)
  [ -z "$ip" ] && return 1
  curl -sk -m 4 -o /dev/null "https://$ip:$1/" 2>/dev/null
}

ssh_portu() {
  local p
  p=$(grep -hoE '^\s*Port\s+[0-9]+' /etc/ssh/sshd_config 2>/dev/null | grep -oE '[0-9]+' | head -1)
  echo "${p:-22}"
}

kayitli_mod() { [ -f "$DURUM_DOSYA" ] && cat "$DURUM_DOSYA" || echo "unknown"; }
mod_yaz() { mkdir -p "$(dirname "$DURUM_DOSYA")"; echo "$1" > "$DURUM_DOSYA"; }

dis_ip() {
  local ip
  ip=$(ip -4 route get 1.1.1.1 2>/dev/null | grep -oE 'src [0-9.]+' | awk '{print $2}')
  echo "${ip:-$(hostname -I 2>/dev/null | awk '{print $1}')}"
}

cmd_durum() {
  local port sshp be kapi=0 zorlama_acik=0
  port=$(panel_portu); sshp=$(ssh_portu); be=$(fw_backend)
  say "${c_b}GirginOSPanel access status${c_0}"
  if [ -n "$(kapi_portu admin)" ]; then
    kapi=1
    say "  role gates      : admin $port · reseller $(kapi_portu bayi) · customer $(kapi_portu musteri) (reseller/customer are not affected by this mode)"
    [ -n "$(kapi_eski_portlari)" ] && warn "old gate open: $(kapi_eski_portlari)— admin login is possible there too"
    # 🔴 SON-OPS-5: kapı modunda "masaustu" sonucu zorlamaya BAĞLI — zorlama kapalıyken
    # bayi/müşteri/eski kapıların her biri yönetici girişini de kabul eder (RK-OPS-06).
    if kapi_zorlama_olc; then
      zorlama_acik=1
      ok "gate enforcement: ON (measured: $KAPI_ZORLAMA_OLCUM)"
    elif [ "$KAPI_ZORLAMA_DURUM" = "kapali" ]; then
      warn "gate enforcement: OFF — no role separation, admin login is also accepted on the reseller/customer/old gates ($KAPI_ZORLAMA_OLCUM)"
    else
      warn "gate enforcement: COULD NOT MEASURE — role separation not verified ($KAPI_ZORLAMA_OLCUM)"
    fi
  fi
  say "  panel port      : $port"
  say "  SSH port        : $sshp"
  say "  firewall backend: $be"
  # 1) nginx dinleme adresi (en belirleyici katman)
  if nginx_loopback_mi "$port"; then
    ok "nginx listen  : ${c_b}127.0.0.1:$port${c_0} — the service does NOT listen externally at all"
  else
    warn "nginx listen  : 0.0.0.0:$port — the service listens on all interfaces"
  fi
  # 2) firewall
  if [ "$be" = "none" ]; then
    warn "firewall      : none"
  elif port_acik_mi "$port"; then
    warn "firewall      : port $port OPEN to the outside"
  else
    ok "firewall      : port $port CLOSED to the outside"
  fi
  # 3) gerçek sonuç
  if nginx_loopback_mi "$port" || ! port_acik_mi "$port"; then
    if [ "$kapi" = 0 ]; then
      ok "RESULT → mode: ${c_b}desktop${c_0} (the panel is reachable only through an SSH tunnel)"
    elif [ "$zorlama_acik" = 1 ]; then
      ok "RESULT → mode: ${c_b}desktop${c_0} (the admin surface is reachable only through an SSH tunnel; reseller/customer gates are open — enforcement measured)"
    else
      warn "RESULT → mode: ${c_b}desktop${c_0} (only the admin gate is on loopback; enforcement OFF/not measurable — admin login may be open on the reseller/customer/old gates)"
    fi
  else
    ok "RESULT → mode: ${c_b}web${c_0} (reachable from a browser)"
  fi
  say "  saved mode      : $(kayitli_mod)"
  say ""
  say "  To change:  girginospanel-erisim web   |   girginospanel-erisim desktop"
}

cmd_web() {
  local port; port=$(panel_portu)
  say "${c_b}Mode: web${c_0} — opening the panel port to the outside"
  if nginx_loopback_mi "$port"; then
    if nginx_listen_ayarla "$port" genel; then ok "nginx listens on all interfaces (0.0.0.0:$port)"; else exit 1; fi
  else
    ok "nginx already listens on all interfaces"
  fi
  if port_ac "$port"; then ok "firewall: port $port/tcp opened"; else err "could not open the port (firewall backend: $(fw_backend))"; exit 1; fi
  mod_yaz web
  ok "panel address: https://$(dis_ip):$port"
  warn "The panel UI is now open to the internet. To manage it only from the desktop app: girginospanel-erisim desktop"
}

cmd_masaustu() {
  local port sshp; port=$(panel_portu); sshp=$(ssh_portu)
  say "${c_b}Mode: desktop${c_0} — closing the panel port to the outside"
  # 🔴 SSH kapalıysa kapatma: panele HİÇBİR yoldan erişilemez hale gelir.
  if ! port_acik_mi "$sshp"; then
    if [ "$(fw_backend)" = "none" ]; then
      warn "no firewall — SSH check skipped"
    else
      err "SSH port ($sshp) does NOT appear to be open in the firewall."
      err "If the panel port is closed, access to the server could be cut off completely — OPERATION STOPPED."
      err "Verify SSH access first, then try again."
      exit 1
    fi
  fi
  # 1) KATMAN: nginx'i loopback'e bağla — port dışarıda HİÇ dinlenmez.
  #    API de aynı vhost'ta olduğu için ona da dışarıdan erişilemez.
  if nginx_listen_ayarla "$port" loopback; then
    ok "nginx now listens only on 127.0.0.1:$port (closed on external interfaces)"
  else
    err "the nginx listen address could not be changed — OPERATION STOPPED"; exit 1
  fi
  # 2) KATMAN: firewall (derinlemesine savunma)
  if port_kapat "$port"; then ok "firewall: port $port/tcp closed"; else warn "the firewall rule could not be added (the nginx layer is sufficient)"; fi
  mod_yaz masaustu
  # 3) DOĞRULA: dışarıdan gerçekten kapalı mı, içeriden hâlâ açık mı?
  # Soket adresi TEK GÜVENİLİR ölçü: sunucudan kendi dış IP'sine yapılan
  # istek `lo` üzerinden gider, firewall kuralı atlanır (yanlış-pozitif).
  if ss -tln 2>/dev/null | grep -E "(0\\.0\\.0\\.0|\\[::\\]):$port " >/dev/null; then
    err "WARNING: nginx STILL listens on ALL interfaces — check manually!"
    ss -tlnp 2>/dev/null | grep ":$port " >&2
  else
    ok "verified: the socket is only 127.0.0.1:$port — NO listening on external interfaces"
  fi
  if dis_erisim_var_mi "$port"; then
    warn "note: the server can reach its own external IP from the inside (via lo — normal)"
  fi
  if curl -sk -m 4 -o /dev/null "https://127.0.0.1:$port/" 2>/dev/null; then
    ok "verified: access from inside the server (the SSH tunnel path) WORKS"
  else
    err "WARNING: the panel does not answer from inside either — the SSH tunnel may not work!"
  fi
  if [ -z "$(kapi_portu admin)" ]; then
    ok "Only the GirginOS AI desktop app can reach the panel now (SSH tunnel)."
  else
    # 🔴 Kapı modunda başarı iddiası ÖLÇÜME bağlı (RK-OPS-06): zorlama kapalıyken
    # bayi/müşteri/eski kapılar root girişini de kabul eder.
    if kapi_zorlama_olc; then
      ok "Only the GirginOS AI desktop app can reach the admin surface now (SSH tunnel)."
      ok "the reseller (:$(kapi_portu bayi)) and customer (:$(kapi_portu musteri)) gates stay OPEN — only the admin surface was closed"
      ok "enforcement measured: $KAPI_ZORLAMA_OLCUM"
    else
      if [ "$KAPI_ZORLAMA_DURUM" = "kapali" ]; then
        err "WARNING: enforcement is off: admin login may be open on the reseller/customer ports"
      else
        err "WARNING: enforcement COULD NOT BE VERIFIED: admin login may be open on the reseller/customer ports"
      fi
      err "  measurement: $KAPI_ZORLAMA_OLCUM"
      err "  The admin surface does NOT COUNT AS CLOSED: the admin gate is on loopback, but until enforcement is on"
      err "  the reseller (:$(kapi_portu bayi)), customer (:$(kapi_portu musteri)) and old gates also accept admin login."
      err "  For the cause: journalctl -u girginospanel | grep kapi   ·   girginospanel-dogrula (Role gates)"
    fi
    if [ -n "$(kapi_eski_portlari)" ]; then
      warn "the old gate ($(kapi_eski_portlari)) accepts every role, including admin, during the transition."
      warn "to close the admin surface completely: girginospanel-server kapi eski-kapat"
    fi
  fi
  say ""
  say "  In the desktop app:  gPanel → +  → tick 'Connect via SSH tunnel'"
  say "  Server: $(dis_ip)   Panel port: $port   SSH port: $sshp"
}

cmd_link() {
  local host="${1:-$(dis_ip)}" port; port=$(panel_portu)
  say "girginospanel://ac?host=${host}&port=${port}&ad=${host}"
}

case "${1:-durum}" in
  durum|status)          cmd_durum ;;
  web|acik)              cmd_web ;;
  masaustu|desktop|kapali) cmd_masaustu ;;
  baglanti-linki|link)   shift || true; cmd_link "${1:-}" ;;
  -h|--help|yardim)
    kullanim ;;
  *) err "unknown command: $1"; say "  girginospanel-erisim [durum|web|desktop|baglanti-linki]"; exit 1 ;;
esac
