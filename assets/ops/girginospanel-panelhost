#!/usr/bin/env bash
# girginospanel-panelhost — panel vhost'unun HANGİ İSİMLERE cevap vereceğini yönetir.
#
# 🔴 NEDEN: panel vhost'u `listen 8443 default_server; server_name _;` idi —
# yani ÇIPLAK IP dâhil her isimde cevap veriyordu. Bir saldırganın paneli
# bulması için IP taraması yetiyordu. Bu araç:
#   • bilinmeyen isimlere 444 (bağlantıyı sessizce kapat) döndüren bir
#     yakala-hepsi bloğu kurar,
#   • panel bloğunu YALNIZ izin verilen isimlere bağlar.
#
# 🔴 KİLİTLENME KORUMASI: `localhost` ve `127.0.0.1` HER ZAMAN listede kalır.
# Böylece isim yanlış ayarlansa bile `ssh -L ${PANEL_PORT}:127.0.0.1:${PANEL_PORT}` ile panele
# girip düzeltebilirsin. Ayrıca isim ayarlarken DNS'in BU sunucuya çözüldüğü
# doğrulanır; çözülmüyorsa değişiklik UYGULANMAZ.
set -uo pipefail

kullanim() {
  cat <<'USAGE'
Usage: girginospanel-panelhost [durum|ayarla [hostname]|sifirla]

Controls which host names the panel's nginx vhost answers to. Unknown names
get a catch-all block that closes the connection (444), so scanning bots
cannot find the panel by bare IP. Must be run as root.

Commands:
  durum              Show the current server_name and catch-all status (default)
  ayarla [hostname]  Bind the panel vhost to <hostname>. DNS must resolve to this
                     server, otherwise nothing is changed (lockout protection).
                     Without a hostname, access by IP stays open.
  sifirla            Restore the newest nginx config backup (_panel.conf.yedek.*)

Notes:
  localhost and 127.0.0.1 always stay allowed, so a wrong name can be fixed
  through: ssh -L <panel-port>:127.0.0.1:<panel-port> <server>
  A failed nginx -t, reload or health check rolls the change back.

Exit codes: 0 success, 1 failure / warning (panel rolled back or unmeasured) or bad usage
USAGE
}
case "${1:-}" in -h|--help|help) kullanim; exit 0 ;; esac

# 🔴 AYRIŞTIRMA İÇİN LC_ALL=C ZORUNLU (dogrula/update/repair/gpanel ile aynı kural).
# tr_TR collation'ında `a-z` aralığı `i` harfini KAPSAMAZ: kapi_zincir_olc'un
# grep -oE '"tip":"[a-z]+"' ayrıştırması "yonetim"/"musteri"de kesilir → tip boş →
# sağlam zincirde bile "ÖLÇÜLEMEDİ" + rc=1 (kum havuzunda LANG=tr_TR.UTF-8 ile ölçüldü).
export LC_ALL=C

# Yollar: GOSP_* yalnız kum havuzu testleri içindir (varsayılanlar gerçek sistem yolları).
PANEL_CONF=${GOSP_PANEL_CONF:-/etc/nginx/conf.d/_panel.conf}

# 🔴 PANEL PORTU DINAMIK: betik eskiden 8443 varsayiyordu. Panel portu
# degistirilmisse (ornek: 8443 doluydu -> 7443) dogrulama "https://127.0.0.1:8443"
# ile 000 doner ve betik SAGLIKLI degisikligi "panel erisilemez" sanip GERI ALIR.
# Portu panel vhost'undan oku; okunamazsa dinlenen ssl portundan, o da yoksa 8443.
# 🔴 TÜM genel portlar (rol kapıları — ADR-GP-001): panel admin / bayi / müşteri için
# ayrı portlarda dinler. Yakala-hepsi yalnız ilk porta kurulsaydı diğer kapılarda
# bilinmeyen Host da panele ulaşırdı. Loopback (erisim masaüstü) ve yorum satırları hariç.
PANEL_PORTLARI="$(sed -E 's/#.*//' "$PANEL_CONF" 2>/dev/null \
  | grep -oE '^[[:space:]]*listen[[:space:]]+(\[::\]:|0\.0\.0\.0:)?[0-9]+[[:space:]]+ssl' \
  | grep -oE '[0-9]+[[:space:]]+ssl' | grep -oE '^[0-9]+' | sort -un | tr '\n' ' ')"
PANEL_PORT="${PANEL_PORTLARI%% *}"
[ -n "$PANEL_PORT" ] || PANEL_PORT="$(ss -ltnH 2>/dev/null | grep -oE ':(7443|8443)' | head -1 | tr -d ':')"
[ -n "$PANEL_PORT" ] || PANEL_PORT=8443
[ -n "$PANEL_PORTLARI" ] || PANEL_PORTLARI="$PANEL_PORT"
CATCH_CONF=${GOSP_CATCHALL_CONF:-/etc/nginx/conf.d/_panel_catchall.conf}
# Rol kapıları (ADR-GP-001) doğruluk kaynağı: dosya varsa panel kapı modundadır.
KAPI_JSON=${GOSP_KAPI_AYAR:-/etc/girginospanel/kapi.json}
# Panelin zorlama bayrağının dosya yansıması ("acik" | "kapali"; tmpfs). Açılış Heal'i
# yazar, ölçümler günceller. Bkz. internal/provisioner/panelkapi.go kapiZorlamaDosyasi.
KAPI_ZORLAMA=${GOSP_KAPI_ZORLAMA:-/run/girginospanel/kapi-zorlama}
# Backend /healthz — girginospanel-update ile AYNI okuma: PANEL_LISTEN env'den, varsayma.
PANEL_HEALTH_ADRES=$(grep -oE '^PANEL_LISTEN=.*' "${GOSP_PANEL_ENV:-/etc/girginospanel/env}" 2>/dev/null | cut -d= -f2- | tr -d ' ')
PANEL_HEALTH_ADRES=${PANEL_HEALTH_ADRES:-127.0.0.1:8080}
case "$PANEL_HEALTH_ADRES" in
  :*)        PANEL_HEALTH_ADRES="127.0.0.1$PANEL_HEALTH_ADRES" ;;
  0.0.0.0:*) PANEL_HEALTH_ADRES="127.0.0.1:${PANEL_HEALTH_ADRES##*:}" ;;
esac
PANEL_HEALTH="http://$PANEL_HEALTH_ADRES/healthz"
SAGLIK_SN=${GOSP_SAGLIK_SN:-120}
case "$SAGLIK_SN" in ''|*[!0-9]*) SAGLIK_SN=120 ;; esac
CERT=/etc/ssl/girginospanel/panel.crt
KEY=/etc/ssl/girginospanel/panel.key

c_g="\033[32m"; c_y="\033[33m"; c_r="\033[31m"; c_0="\033[0m"
[ -t 1 ] || { c_g=; c_y=; c_r=; c_0=; }
ok(){ echo -e "  ${c_g}✓${c_0} $*"; }
uyar(){ echo -e "  ${c_y}!${c_0} $*"; }
dur(){ echo -e "  ${c_r}✗ $*${c_0}"; exit 1; }

[ "$(id -u)" = 0 ] || dur "must be run as root"
[ -f "$PANEL_CONF" ] || dur "$PANEL_CONF not found"

sunucu_ipleri() {
  # Genel (public) IPv4/IPv6 — loopback ve link-local hariç.
  ip -o addr show scope global 2>/dev/null | awk '{print $4}' | cut -d/ -f1
}

# kamu_coz — host'u KAMU DNS'ten çözer (Let's Encrypt'in göreceği kayıt).
# 🔴 NEDEN: `getent ahosts` sistem/yerel (önbellekli) çözümleyiciyi kullanır;
# bir alan adı bu sunucuya taşınınca yerel resolver eski IP'yi ya da 127.0.0.1'i
# döndürüp SSL'i YANLIŞ bloke ediyordu — oysa kamu DNS doğru sunucu IP'sini
# veriyordu (yeni sunucuda ölçüldü). dig varsa kamu NS'lerden A+AAAA çeker;
# hepsi ulaşılamazsa son çare getent'e düşer.
kamu_coz() {
  local ad="$1" ns out=""
  if command -v dig >/dev/null 2>&1; then
    for ns in 1.1.1.1 8.8.8.8 9.9.9.9; do
      out=$( { dig +short +time=3 +tries=1 "@$ns" A "$ad" 2>/dev/null | grep -E '^[0-9]+\.'; \
               dig +short +time=3 +tries=1 "@$ns" AAAA "$ad" 2>/dev/null | grep ':'; } | sort -u )
      [ -n "$out" ] && { echo "$out"; return; }
    done
  fi
  # dig yok / kamu NS ulaşılamadı → son çare yerel çözümleyici.
  getent ahosts "$ad" 2>/dev/null | awk '{print $1}' | sort -u
}

mevcut_isimler() {
  grep -oP '^\s*server_name\s+\K[^;]+' "$PANEL_CONF" | head -1
}

durum() {
  echo "Panel vhost name configuration"
  echo "──────────────────────────────────"
  echo "  server_name : $(mevcut_isimler)"
  if grep -q "default_server" "$PANEL_CONF"; then
    uyar "panel block is STILL default_server — it answers unknown names too"
  else
    ok "panel block is NOT default_server"
  fi
  if [ -f "$CATCH_CONF" ]; then
    ok "catch-all block installed (unknown name → 444)"
  else
    uyar "catch-all block MISSING"
  fi
  echo "  server IPs: $(sunucu_ipleri | tr '\n' ' ')"
  echo
  echo "  Test:"
  echo "    curl -sk -o /dev/null -w '%{http_code}\\n' https://127.0.0.1:${PANEL_PORT}/ --resolve panel.test:${PANEL_PORT}:127.0.0.1"
}

# yakala_hepsi_kur — bilinmeyen isimleri 444 ile kapatan blok (panelin HER genel
# portunda). IPv6 satırı yalnız panel vhost'unda etkin bir IPv6 listen varsa yazılır:
# IPv6'sız çekirdekte `listen [::]:p` nginx -t'yi düşürür.
yakala_hepsi_kur() {
  local p dinle="" v6=0
  grep -qE '^[[:space:]]*listen[[:space:]]+\[' "$PANEL_CONF" && v6=1
  for p in $PANEL_PORTLARI; do
    dinle+="    listen ${p} ssl default_server;"$'\n'
    [ "$v6" = 1 ] && dinle+="    listen [::]:${p} ssl default_server;"$'\n'
  done
  cat > "$CATCH_CONF" <<EOF
# OTOMATİK ÜRETİLDİ — girginospanel-panelhost
#
# 🔴 Bilinmeyen Host başlığıyla gelen istekleri SESSİZCE kapatır (444).
# Panel bloğu artık default_server değil; buraya düşen her istek, panelin
# varlığını bile öğrenemeden bağlantıyı kaybeder. IP taraması yapan botlar
# ve Host-başlığı karıştırma denemeleri buraya düşer.
server {
${dinle}    server_name _;

    ssl_certificate     $CERT;
    ssl_certificate_key $KEY;

    access_log off;
    return 444;
}
EOF
}

ayarla() {
  local istenen="${1:-}"
  local izinli="localhost 127.0.0.1"   # 🔴 tünel için HER ZAMAN

  if [ -n "$istenen" ]; then
    # DNS bu sunucuya mı çözülüyor? Değilse kilitlenirsin.
    # 🔴 KAMU DNS'ten çöz (getent yerel/bayat cache 127.0.0.1 döndürüp yanlış bloke ediyordu).
    local coz; coz=$(kamu_coz "$istenen")
    [ -n "$coz" ] || dur "'$istenen' does not resolve in DNS — not applied (lockout risk)"
    local eslesme=0
    for ip in $(sunucu_ipleri); do echo "$coz" | grep -qx "$ip" && eslesme=1; done
    if [ "$eslesme" = 0 ]; then
      dur "'$istenen' does not resolve to this server (resolved: $(echo $coz | tr '\n' ' ')) — not applied"
    fi
    # Fix: hostname + IP birlikte — IP ile yedek erişim (DNS sorunu recovery)
    izinli="$istenen $(sunucu_ipleri | tr "
" " ")$izinli"
    ok "'$istenen' resolves to this server"
  else
    # İsim verilmediyse IP'lerle çalış (panel IP ile erişilebilir kalır).
    izinli="$(sunucu_ipleri | tr '\n' ' ')$izinli"
    uyar "no panel hostname given — access by IP stays OPEN (scanning bots can see the panel)"
    uyar "to close it: girginospanel-panelhost ayarla panel.example.com"
  fi

  local yedek="$PANEL_CONF.yedek.$(date +%s)"
  cp -a "$PANEL_CONF" "$yedek"
  ok "backup: $yedek"

  # 1) panel bloğundan default_server'ı kaldır (her genel portta), 2) server_name'i yaz.
  local p
  for p in $PANEL_PORTLARI; do
    sed -i "s/\(listen[^;]*[ :]${p} [^;]*\) default_server;/\1;/" "$PANEL_CONF"
  done
  sed -i "0,/^\s*server_name\s\+[^;]*;/s//    server_name $izinli;/" "$PANEL_CONF"
  yakala_hepsi_kur

  if ! nginx -t >/tmp/nginx-test.log 2>&1; then
    cat /tmp/nginx-test.log
    cp -a "$yedek" "$PANEL_CONF"; rm -f "$CATCH_CONF"
    dur "nginx -t failed — CHANGE ROLLED BACK"
  fi
  ok "nginx -t passed"
  systemctl reload nginx || { cp -a "$yedek" "$PANEL_CONF"; rm -f "$CATCH_CONF"; nginx -t && systemctl reload nginx; dur "reload failed — rolled back"; }

  # 🔴 DOĞRULA, İDDİA ETME. reload sonrası eski işçiler bir süre daha
  # yanıt verebiliyor; "uygulandı" demek yeterli değil, DAVRANIŞI ölç.
  sleep 1
  local bilinmeyen izinli_kod
  bilinmeyen=$(curl -sk -o /dev/null -w '%{http_code}' --max-time 8       --resolve gosp-dogrulama.invalid:${PANEL_PORT}:127.0.0.1 https://gosp-dogrulama.invalid:${PANEL_PORT}/ 2>/dev/null)
  izinli_kod=$(curl -sk -o /dev/null -w '%{http_code}' --max-time 8 https://127.0.0.1:${PANEL_PORT}/ 2>/dev/null)

  if [ "$izinli_kod" != "200" ]; then
    cp -a "$yedek" "$PANEL_CONF"; rm -f "$CATCH_CONF"
    nginx -t >/dev/null 2>&1 && systemctl reload nginx
    dur "panel became UNREACHABLE (localhost=$izinli_kod) — ROLLED BACK"
  fi
  if [ "$bilinmeyen" = "200" ]; then
    uyar "unknown name still returns 200 — expected 000/444. Check the configuration."
  else
    ok "verified: unknown name is closed (code=$bilinmeyen), panel is up (200)"
  fi
  ok "applied → server_name: $izinli"
}

# kapi_portu <rol>: kapi.json'dan rol portu. Panel ikilisi ÇALIŞTIRILMAZ (erisim/dogrula
# ile aynı düz okuma — eski bir ikili bilinmeyen argümanla sunucuyu başlatırdı).
kapi_portu() { grep -oE "\"$1\": *[0-9]+" "$KAPI_JSON" 2>/dev/null | grep -oE '[0-9]+$' | head -1; }

# kapi_eksikleri <conf>: dosyada kapı düzeninden EKSİK olanları satır satır yazar (boş =
# tam). Rol portunun HERHANGİ bir listen izi (genel, loopback ya da erisim'in yoruma
# aldığı) yeter — panelin Heal'i de portu böyle "yönetiliyor" sayar (kapi.Uzlastir).
kapi_eksikleri() {
  local conf="$1" rol p
  grep -q 'proxy_set_header X-GP-Kapi ' "$conf" 2>/dev/null || echo "X-GP-Kapi header"
  for rol in admin bayi musteri; do
    p=$(kapi_portu "$rol")
    [ -n "$p" ] || continue
    grep -qE "listen[[:space:]]+([^[:space:];]*:)?${p}([[:space:];]|\$)" "$conf" 2>/dev/null \
      || echo "$rol gate listen :$p"
  done
}

# kapi_zincir_olc: her rol portu nginx ÜZERİNDEN kendi tipini dönüyor mu (admin/bayi →
# yonetim, musteri → musteri)? dogrula → Role gates ile AYNI ölçüm: loopback istemci,
# zorlama kapalı olsa bile başlığı KANITLI isteğe gerçek tipi alır; X-GP-Kapi başlığı
# yok/gizlisi tutmuyor/map yanlışsa "karma" ya da yanlış tip döner = zincir kopuk.
# Açılış reload'undan kalan eski işçiler kısa süre eski düzenle yanıt verebilir: port
# başına en çok 5 deneme × 2 sn. Sonuç _kz_zincir = tamam | kopuk | olculemedi,
# _kz_zincir_ayr = ayrıntı (yalnız port/tip; gizli ya da başlık değeri basılmaz).
_kz_zincir=""; _kz_zincir_ayr=""
kapi_zincir_olc() {
  local kr rol bek p tip i kopuk="" olcsuz=""
  for kr in admin:yonetim bayi:yonetim musteri:musteri; do
    rol=${kr%%:*}; bek=${kr#*:}; p=$(kapi_portu "$rol")
    if [ -z "$p" ]; then olcsuz="$olcsuz $rol(no port)"; continue; fi
    tip=""
    for i in 1 2 3 4 5; do
      tip=$(curl -sk --max-time 5 "https://127.0.0.1:$p/api/v1/kapi" 2>/dev/null \
        | grep -oE '"tip":"[a-z]+"' | cut -d'"' -f4) || tip=""
      [ "$tip" = "$bek" ] && break
      [ "$i" = 5 ] || sleep 2
    done
    if [ "$tip" = "$bek" ]; then continue; fi
    if [ -n "$tip" ]; then kopuk="$kopuk $rol :$p=$tip(expected $bek)"; else olcsuz="$olcsuz $rol :$p(no response)"; fi
  done
  if [ -n "$kopuk" ]; then _kz_zincir=kopuk; _kz_zincir_ayr="${kopuk# }${olcsuz:+ ·${olcsuz}}"; return 1; fi
  if [ -n "$olcsuz" ]; then _kz_zincir=olculemedi; _kz_zincir_ayr="${olcsuz# }"; return 1; fi
  _kz_zincir=tamam; _kz_zincir_ayr="3/3 gates return their own type"
  return 0
}

# kapi_giris_olc: üretim yolunda zorlama gerçekten AÇIK mı? Müşteri kapısında yönetici
# giriş ucu YOKTUR → 404; zorlama kapalıyken aynı istek 400/401 döner (dogrula/erisim
# kapi_zorlama_olc ile aynı). Gövde '{}': kimlik bilgisi gönderilmez (denetim günlüğü ve
# kaba-kuvvet sayacı etkilenmez). Çıktı: acik | kapali | olculemedi (+ HTTP kodu).
kapi_giris_olc() {
  local mp kod
  mp=$(kapi_portu musteri)
  [ -n "$mp" ] || { echo "olculemedi (customer gate port missing)"; return 0; }
  kod=$(curl -sk --max-time 5 -o /dev/null -w '%{http_code}' -X POST \
        -H 'Content-Type: application/json' --data '{}' \
        "https://127.0.0.1:$mp/api/v1/auth/login" 2>/dev/null) || true
  case "$kod" in
    404)         echo "acik (customer gate :$mp admin login 404)" ;;
    400|401|200) echo "kapali (customer gate :$mp admin login HTTP $kod — endpoint OPEN)" ;;
    *)           echo "olculemedi (customer gate :$mp HTTP ${kod:-000})" ;;
  esac
}

# kapi_yeniden_uygula: kapı düzenini HEMEN geri getirir. nginx'e kendimiz yazmıyoruz:
# kapı düzeninin TEK uygulayıcısı panelin açılış Heal'idir (EKLEYİCİ: eksik rol listen'ı
# + X-GP-Kapi başlığı; nginx -t + geri alma + dinleme ölçümü onda). Zincir kopuksa
# panelin uçtan uca ölçümü (KapiDogrulaBaslat) zorlamayı KAPATIR → tek-port davranışı,
# kimse kilitli kalmaz. `kapi rol-port` CLI'ı da aynı yolu kullanır (panelYenidenBaslat).
# NOT: panelin kendisi bu betiği `sifirla` ile çağırırsa restart onu da öldürür — bugün
# yalnız operatör CLI'ı çağırıyor.
kapi_yeniden_uygula() {
  if ! systemctl is-active --quiet girginospanel; then
    uyar "panel is not running — the gate layout is applied at the next start (nobody is locked out while the panel is down)"
    return 0
  fi
  if ! systemctl restart girginospanel; then
    uyar "could not restart the panel — apply the gate layout manually: systemctl restart girginospanel"
    return 1
  fi
  # 🔴 ÖNCE Heal'in BİTMESİNİ bekle (SON-OPS-3). Açılış Heal'i provisioner.Init içinde,
  # ListenAndServe'den ÖNCE koşar ve dosyayı önce YAZAR, sonra nginx -t / reload / dinleme
  # ölçümüne geçer; tutmazsa GERİ ALIR ve zorlamayı kapatır. Dosyayı Heal sürerken yoklamak
  # yazma ile geri alma arasındaki anı görüp yanlış "✓ uygulandı" diyordu; Heal (SELinux
  # etiket denetimi dahil) 15 sn'yi aşınca da yanlış "eksik". /healthz yanıt veriyorsa Heal
  # bitmiştir (restart eski süreci durdurup döner: yanıt yeni süreçten gelir).
  local son eksik bayrak giris rc=0
  son=$((SECONDS + SAGLIK_SN))
  until curl -fsS --max-time 5 -o /dev/null "$PANEL_HEALTH" 2>/dev/null; do
    if [ "$SECONDS" -ge "$son" ]; then
      uyar "panel restarted but /healthz did not answer within ${SAGLIK_SN} s ($PANEL_HEALTH) — startup reconciliation not finished, gate layout COULD NOT BE MEASURED"
      uyar "see: journalctl -u girginospanel -n 40   ·   then: girginospanel-dogrula (Role gates)"
      return 1
    fi
    sleep 2
  done
  # 🔴 ÖLÇ, İDDİA ETME: Heal bitti — dosyayı BİR KEZ denetle.
  eksik=$(kapi_eksikleri "$PANEL_CONF")
  if [ -n "$eksik" ]; then
    uyar "panel is up but the gate layout is missing in _panel.conf: $(printf '%s\n' "$eksik" | paste -sd, - | sed 's/,/, /g')"
    uyar "in this state the panel DISABLES the gate rules (single-port behavior) — see: journalctl -u girginospanel -n 40"
    rc=1
  else
    ok "gate layout re-applied (panel startup reconciliation finished)"
  fi
  # 🔴 OPS-3: BAYRAĞA TEK BAŞINA GÜVENME. Açılış Heal'i bayrağı uçtan uca ölçümden ÖNCE
  # iyimser "acik" yazar; panelin ölçümü (KapiDogrulaBaslat) ListenAndServe'den SONRA
  # başlar ve kopuk zincirde "kapali" kararı ~1 dk (20 deneme × 3 sn) sürer. /healthz'den
  # hemen sonra okunan "acik" bu yüzden kanıt DEĞİL: kopuk zincirde (ör. proxy gizlisi
  # kaymış → tip "karma") da "AÇIK" + rc=0 veriyordu. Zinciri ve zorlamayı BURADA ölç.
  if ! kapi_zincir_olc; then
    if [ "$_kz_zincir" = kopuk ]; then
      uyar "gate chain BROKEN: $_kz_zincir_ayr — the panel measurement DISABLES enforcement (≈1 min): no role separation, admin login is also accepted on the reseller/customer/old gates (reason: journalctl -u girginospanel | grep kapi)"
    else
      uyar "gate chain COULD NOT BE MEASURED: $_kz_zincir_ayr — role separation not verified (then: girginospanel-dogrula → Role gates)"
    fi
    return 1
  fi
  bayrak=$(head -c 32 "$KAPI_ZORLAMA" 2>/dev/null | tr -d '[:space:]')
  giris=$(kapi_giris_olc)
  case "$bayrak:${giris%% *}" in
    acik:acik)
      ok "gate enforcement: ON — measured: $_kz_zincir_ayr · ${giris#* } · panel flag acik" ;;
    kapali:*|*:kapali)
      uyar "gate enforcement: OFF — no role separation, admin login is also accepted on the reseller/customer/old gates (flag: ${bayrak:-none} · ${giris#* }; reason: journalctl -u girginospanel | grep kapi)"
      rc=1 ;;
    :*)
      uyar "gate enforcement: COULD NOT BE MEASURED ($KAPI_ZORLAMA missing/unreadable · ${giris#* }) — role separation not verified"
      rc=1 ;;
    acik:*)
      uyar "gate enforcement: COULD NOT BE MEASURED (flag is acik but ${giris#* }) — role separation not verified"
      rc=1 ;;
    *)
      uyar "gate enforcement: flag not recognized ('${bayrak//[!a-zA-Z0-9_-]/?}') — role separation not verified"
      rc=1 ;;
  esac
  return "$rc"
}

sifirla() {
  local son; son=$(ls -t "$PANEL_CONF".yedek.* 2>/dev/null | head -1)
  [ -n "$son" ] || dur "no backup to restore"
  # 🔴 KAPI MODU (ADR-GP-001): yedek rol kapısı geçişinden ÖNCE alınmışsa rol listen'ları
  # ve X-GP-Kapi satırı içermez. Yalnız geri yükleyip bıraksaydık panel belleğindeki
  # zorlama AÇIK kalırdı → bakım uzlaştırmasına dek (≤15 dk) giriş 404, API 401: TÜM
  # roller kilitli. Reddetmek de çözüm değil (sifirla bir kurtarma aracı); yedeği geri
  # yükleyip kapıyı hemen yeniden uyguluyoruz. sifirla yalnız isim kısıtlamasını (server_name
  # + yakala-hepsi) geri alır; kapı düzeni kapi.json'dan yeniden türetilir.
  local kapi=0 eksik=""
  if [ -f "$KAPI_JSON" ]; then
    kapi=1
    eksik=$(kapi_eksikleri "$son")
    if [ -n "$eksik" ]; then
      uyar "the backup predates the role-gate layout — missing: $(printf '%s\n' "$eksik" | paste -sd, - | sed 's/,/, /g')"
      uyar "the gate layout will be re-applied right away from kapi.json (panel startup reconciliation)"
    fi
  fi
  cp -a "$son" "$PANEL_CONF"; rm -f "$CATCH_CONF"
  nginx -t >/dev/null 2>&1 || dur "nginx -t failed"
  systemctl reload nginx && ok "reverted to the previous configuration ($son)"
  local rc=$?
  # reload düşse bile uygula: dosya artık yedek; bir sonraki herhangi bir reload onu yükler.
  if [ "$kapi" = 1 ]; then
    kapi_yeniden_uygula || rc=1
  fi
  return "$rc"
}

case "${1:-durum}" in
  durum)   durum ;;
  ayarla)  ayarla "${2:-}" ;;
  sifirla) sifirla ;;
  *) echo "Usage: girginospanel-panelhost {durum|ayarla [hostname]|sifirla}"; exit 1 ;;
esac
