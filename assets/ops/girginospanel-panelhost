#!/usr/bin/env bash
# girginospanel-panelhost — panel vhost'unun HANGİ İSİMLERE cevap vereceğini yönetir.
#
# 🔴 NEDEN: panel vhost'u `listen 8443 default_server; server_name _;` idi —
# yani ÇIPLAK IP dâhil her isimde cevap veriyordu. Bir saldırganın paneli
# bulması için IP taraması yetiyordu. Bu araç:
#   • bilinmeyen isimlere 444 (bağlantıyı sessizce kapat) döndüren bir
#     yakala-hepsi bloğu kurar,
#   • panel bloğunu YALNIZ izin verilen isimlere bağlar.
#
# 🔴 KİLİTLENME KORUMASI: `localhost` ve `127.0.0.1` HER ZAMAN listede kalır.
# Böylece isim yanlış ayarlansa bile `ssh -L ${PANEL_PORT}:127.0.0.1:${PANEL_PORT}` ile panele
# girip düzeltebilirsin. Ayrıca isim ayarlarken DNS'in BU sunucuya çözüldüğü
# doğrulanır; çözülmüyorsa değişiklik UYGULANMAZ.
set -uo pipefail

PANEL_CONF=/etc/nginx/conf.d/_panel.conf

# 🔴 PANEL PORTU DINAMIK: betik eskiden 8443 varsayiyordu. Panel portu
# degistirilmisse (ornek: 8443 doluydu -> 7443) dogrulama "https://127.0.0.1:8443"
# ile 000 doner ve betik SAGLIKLI degisikligi "panel erisilemez" sanip GERI ALIR.
# Portu panel vhost'undan oku; okunamazsa dinlenen ssl portundan, o da yoksa 8443.
# 🔴 TÜM genel portlar (rol kapıları — ADR-GP-001): panel admin / bayi / müşteri için
# ayrı portlarda dinler. Yakala-hepsi yalnız ilk porta kurulsaydı diğer kapılarda
# bilinmeyen Host da panele ulaşırdı. Loopback (erisim masaüstü) ve yorum satırları hariç.
PANEL_PORTLARI="$(sed -E 's/#.*//' "$PANEL_CONF" 2>/dev/null \
  | grep -oE '^[[:space:]]*listen[[:space:]]+(\[::\]:|0\.0\.0\.0:)?[0-9]+[[:space:]]+ssl' \
  | grep -oE '[0-9]+[[:space:]]+ssl' | grep -oE '^[0-9]+' | sort -un | tr '\n' ' ')"
PANEL_PORT="${PANEL_PORTLARI%% *}"
[ -n "$PANEL_PORT" ] || PANEL_PORT="$(ss -ltnH 2>/dev/null | grep -oE ':(7443|8443)' | head -1 | tr -d ':')"
[ -n "$PANEL_PORT" ] || PANEL_PORT=8443
[ -n "$PANEL_PORTLARI" ] || PANEL_PORTLARI="$PANEL_PORT"
CATCH_CONF=/etc/nginx/conf.d/_panel_catchall.conf
# Rol kapıları (ADR-GP-001) doğruluk kaynağı: dosya varsa panel kapı modundadır.
KAPI_JSON=/etc/girginospanel/kapi.json
CERT=/etc/ssl/girginospanel/panel.crt
KEY=/etc/ssl/girginospanel/panel.key

c_g="\033[32m"; c_y="\033[33m"; c_r="\033[31m"; c_0="\033[0m"
[ -t 1 ] || { c_g=; c_y=; c_r=; c_0=; }
ok(){ echo -e "  ${c_g}✓${c_0} $*"; }
uyar(){ echo -e "  ${c_y}!${c_0} $*"; }
dur(){ echo -e "  ${c_r}✗ $*${c_0}"; exit 1; }

[ "$(id -u)" = 0 ] || dur "root gerekli"
[ -f "$PANEL_CONF" ] || dur "$PANEL_CONF yok"

sunucu_ipleri() {
  # Genel (public) IPv4/IPv6 — loopback ve link-local hariç.
  ip -o addr show scope global 2>/dev/null | awk '{print $4}' | cut -d/ -f1
}

# kamu_coz — host'u KAMU DNS'ten çözer (Let's Encrypt'in göreceği kayıt).
# 🔴 NEDEN: `getent ahosts` sistem/yerel (önbellekli) çözümleyiciyi kullanır;
# bir alan adı bu sunucuya taşınınca yerel resolver eski IP'yi ya da 127.0.0.1'i
# döndürüp SSL'i YANLIŞ bloke ediyordu — oysa kamu DNS doğru sunucu IP'sini
# veriyordu (yeni sunucuda ölçüldü). dig varsa kamu NS'lerden A+AAAA çeker;
# hepsi ulaşılamazsa son çare getent'e düşer.
kamu_coz() {
  local ad="$1" ns out=""
  if command -v dig >/dev/null 2>&1; then
    for ns in 1.1.1.1 8.8.8.8 9.9.9.9; do
      out=$( { dig +short +time=3 +tries=1 "@$ns" A "$ad" 2>/dev/null | grep -E '^[0-9]+\.'; \
               dig +short +time=3 +tries=1 "@$ns" AAAA "$ad" 2>/dev/null | grep ':'; } | sort -u )
      [ -n "$out" ] && { echo "$out"; return; }
    done
  fi
  # dig yok / kamu NS ulaşılamadı → son çare yerel çözümleyici.
  getent ahosts "$ad" 2>/dev/null | awk '{print $1}' | sort -u
}

mevcut_isimler() {
  grep -oP '^\s*server_name\s+\K[^;]+' "$PANEL_CONF" | head -1
}

durum() {
  echo "Panel vhost isim yapılandırması"
  echo "──────────────────────────────────"
  echo "  server_name : $(mevcut_isimler)"
  if grep -q "default_server" "$PANEL_CONF"; then
    uyar "panel bloğu HÂLÂ default_server — bilinmeyen isimlere de cevap veriyor"
  else
    ok "panel bloğu default_server DEĞİL"
  fi
  if [ -f "$CATCH_CONF" ]; then
    ok "yakala-hepsi bloğu kurulu (bilinmeyen isim → 444)"
  else
    uyar "yakala-hepsi bloğu YOK"
  fi
  echo "  sunucu IP'leri: $(sunucu_ipleri | tr '\n' ' ')"
  echo
  echo "  Test:"
  echo "    curl -sk -o /dev/null -w '%{http_code}\\n' https://127.0.0.1:${PANEL_PORT}/ --resolve panel.test:${PANEL_PORT}:127.0.0.1"
}

# yakala_hepsi_kur — bilinmeyen isimleri 444 ile kapatan blok (panelin HER genel
# portunda). IPv6 satırı yalnız panel vhost'unda etkin bir IPv6 listen varsa yazılır:
# IPv6'sız çekirdekte `listen [::]:p` nginx -t'yi düşürür.
yakala_hepsi_kur() {
  local p dinle="" v6=0
  grep -qE '^[[:space:]]*listen[[:space:]]+\[' "$PANEL_CONF" && v6=1
  for p in $PANEL_PORTLARI; do
    dinle+="    listen ${p} ssl default_server;"$'\n'
    [ "$v6" = 1 ] && dinle+="    listen [::]:${p} ssl default_server;"$'\n'
  done
  cat > "$CATCH_CONF" <<EOF
# OTOMATİK ÜRETİLDİ — girginospanel-panelhost
#
# 🔴 Bilinmeyen Host başlığıyla gelen istekleri SESSİZCE kapatır (444).
# Panel bloğu artık default_server değil; buraya düşen her istek, panelin
# varlığını bile öğrenemeden bağlantıyı kaybeder. IP taraması yapan botlar
# ve Host-başlığı karıştırma denemeleri buraya düşer.
server {
${dinle}    server_name _;

    ssl_certificate     $CERT;
    ssl_certificate_key $KEY;

    access_log off;
    return 444;
}
EOF
}

ayarla() {
  local istenen="${1:-}"
  local izinli="localhost 127.0.0.1"   # 🔴 tünel için HER ZAMAN

  if [ -n "$istenen" ]; then
    # DNS bu sunucuya mı çözülüyor? Değilse kilitlenirsin.
    # 🔴 KAMU DNS'ten çöz (getent yerel/bayat cache 127.0.0.1 döndürüp yanlış bloke ediyordu).
    local coz; coz=$(kamu_coz "$istenen")
    [ -n "$coz" ] || dur "'$istenen' DNS'te çözülmüyor — ayarlanmadı (kilitlenme riski)"
    local eslesme=0
    for ip in $(sunucu_ipleri); do echo "$coz" | grep -qx "$ip" && eslesme=1; done
    if [ "$eslesme" = 0 ]; then
      dur "'$istenen' bu sunucuya çözülmüyor (çözülen: $(echo $coz | tr '\n' ' ')) — ayarlanmadı"
    fi
    # Fix: hostname + IP birlikte — IP ile yedek erişim (DNS sorunu recovery)
    izinli="$istenen $(sunucu_ipleri | tr "
" " ")$izinli"
    ok "'$istenen' bu sunucuya çözülüyor"
  else
    # İsim verilmediyse IP'lerle çalış (panel IP ile erişilebilir kalır).
    izinli="$(sunucu_ipleri | tr '\n' ' ')$izinli"
    uyar "panel hostname verilmedi — IP ile erişim AÇIK kalıyor (tarayan botlar paneli görebilir)"
    uyar "kapatmak için: girginospanel-panelhost ayarla panel.alanadiniz.com"
  fi

  local yedek="$PANEL_CONF.yedek.$(date +%s)"
  cp -a "$PANEL_CONF" "$yedek"
  ok "yedek: $yedek"

  # 1) panel bloğundan default_server'ı kaldır (her genel portta), 2) server_name'i yaz.
  local p
  for p in $PANEL_PORTLARI; do
    sed -i "s/\(listen[^;]*[ :]${p} [^;]*\) default_server;/\1;/" "$PANEL_CONF"
  done
  sed -i "0,/^\s*server_name\s\+[^;]*;/s//    server_name $izinli;/" "$PANEL_CONF"
  yakala_hepsi_kur

  if ! nginx -t >/tmp/nginx-test.log 2>&1; then
    cat /tmp/nginx-test.log
    cp -a "$yedek" "$PANEL_CONF"; rm -f "$CATCH_CONF"
    dur "nginx -t başarısız — DEĞİŞİKLİK GERİ ALINDI"
  fi
  ok "nginx -t geçti"
  systemctl reload nginx || { cp -a "$yedek" "$PANEL_CONF"; rm -f "$CATCH_CONF"; nginx -t && systemctl reload nginx; dur "reload başarısız — geri alındı"; }

  # 🔴 DOĞRULA, İDDİA ETME. reload sonrası eski işçiler bir süre daha
  # yanıt verebiliyor; "uygulandı" demek yeterli değil, DAVRANIŞI ölç.
  sleep 1
  local bilinmeyen izinli_kod
  bilinmeyen=$(curl -sk -o /dev/null -w '%{http_code}' --max-time 8       --resolve gosp-dogrulama.invalid:${PANEL_PORT}:127.0.0.1 https://gosp-dogrulama.invalid:${PANEL_PORT}/ 2>/dev/null)
  izinli_kod=$(curl -sk -o /dev/null -w '%{http_code}' --max-time 8 https://127.0.0.1:${PANEL_PORT}/ 2>/dev/null)

  if [ "$izinli_kod" != "200" ]; then
    cp -a "$yedek" "$PANEL_CONF"; rm -f "$CATCH_CONF"
    nginx -t >/dev/null 2>&1 && systemctl reload nginx
    dur "panel ERİŞİLEMEZ oldu (localhost=$izinli_kod) — GERİ ALINDI"
  fi
  if [ "$bilinmeyen" = "200" ]; then
    uyar "bilinmeyen isim hâlâ 200 dönüyor — beklenen 000/444. Yapılandırmayı kontrol et."
  else
    ok "doğrulandı: bilinmeyen isim kapanıyor (kod=$bilinmeyen), panel açık (200)"
  fi
  ok "uygulandı → server_name: $izinli"
}

# kapi_portu <rol>: kapi.json'dan rol portu. Panel ikilisi ÇALIŞTIRILMAZ (erisim/dogrula
# ile aynı düz okuma — eski bir ikili bilinmeyen argümanla sunucuyu başlatırdı).
kapi_portu() { grep -oE "\"$1\": *[0-9]+" "$KAPI_JSON" 2>/dev/null | grep -oE '[0-9]+$' | head -1; }

# kapi_eksikleri <conf>: dosyada kapı düzeninden EKSİK olanları satır satır yazar (boş =
# tam). Rol portunun HERHANGİ bir listen izi (genel, loopback ya da erisim'in yoruma
# aldığı) yeter — panelin Heal'i de portu böyle "yönetiliyor" sayar (kapi.Uzlastir).
kapi_eksikleri() {
  local conf="$1" rol p
  grep -q 'proxy_set_header X-GP-Kapi ' "$conf" 2>/dev/null || echo "X-GP-Kapi başlığı"
  for rol in admin bayi musteri; do
    p=$(kapi_portu "$rol")
    [ -n "$p" ] || continue
    grep -qE "listen[[:space:]]+([^[:space:];]*:)?${p}([[:space:];]|\$)" "$conf" 2>/dev/null \
      || echo "$rol kapısı listen :$p"
  done
}

# kapi_yeniden_uygula: kapı düzenini HEMEN geri getirir. nginx'e kendimiz yazmıyoruz:
# kapı düzeninin TEK uygulayıcısı panelin açılış Heal'idir (EKLEYİCİ: eksik rol listen'ı
# + X-GP-Kapi başlığı; nginx -t + geri alma + uçtan uca ölçüm onda). Zincir kurulamazsa
# Heal zorlamayı KAPATIR → tek-port davranışı, kimse kilitli kalmaz. `kapi rol-port`
# CLI'ı da aynı yolu kullanır (panelYenidenBaslat).
# NOT: panelin kendisi bu betiği `sifirla` ile çağırırsa restart onu da öldürür — bugün
# yalnız operatör CLI'ı çağırıyor.
kapi_yeniden_uygula() {
  if ! systemctl is-active --quiet girginospanel; then
    uyar "panel çalışmıyor — kapı düzeni bir sonraki açılışta uygulanır (panel kapalıyken kimse kilitlenmez)"
    return 0
  fi
  if ! systemctl restart girginospanel; then
    uyar "panel yeniden başlatılamadı — kapıyı elle uygula: systemctl restart girginospanel"
    return 1
  fi
  # 🔴 ÖLÇ, İDDİA ETME: Heal'in dosyayı gerçekten uyumladığını gör.
  local i eksik=""
  for i in $(seq 1 15); do
    eksik=$(kapi_eksikleri "$PANEL_CONF")
    if [ -z "$eksik" ]; then
      ok "kapı düzeni yeniden uygulandı (panel açılış uzlaştırması)"
      return 0
    fi
    sleep 1
  done
  uyar "panel yeniden başlatıldı ama kapı düzeni _panel.conf'ta hâlâ eksik: $(printf '%s\n' "$eksik" | paste -sd, - | sed 's/,/, /g')"
  uyar "panel bu durumda kapı kurallarını KAPATIR (tek-port davranışı) — bak: journalctl -u girginospanel -n 40"
  return 1
}

sifirla() {
  local son; son=$(ls -t "$PANEL_CONF".yedek.* 2>/dev/null | head -1)
  [ -n "$son" ] || dur "geri alınacak yedek yok"
  # 🔴 KAPI MODU (ADR-GP-001): yedek rol kapısı geçişinden ÖNCE alınmışsa rol listen'ları
  # ve X-GP-Kapi satırı içermez. Yalnız geri yükleyip bıraksaydık panel belleğindeki
  # zorlama AÇIK kalırdı → bakım uzlaştırmasına dek (≤15 dk) giriş 404, API 401: TÜM
  # roller kilitli. Reddetmek de çözüm değil (sifirla bir kurtarma aracı); yedeği geri
  # yükleyip kapıyı hemen yeniden uyguluyoruz. sifirla yalnız isim kısıtlamasını (server_name
  # + yakala-hepsi) geri alır; kapı düzeni kapi.json'dan yeniden türetilir.
  local kapi=0 eksik=""
  if [ -f "$KAPI_JSON" ]; then
    kapi=1
    eksik=$(kapi_eksikleri "$son")
    if [ -n "$eksik" ]; then
      uyar "yedek rol kapısı düzeninden ÖNCE alınmış — eksik: $(printf '%s\n' "$eksik" | paste -sd, - | sed 's/,/, /g')"
      uyar "kapı düzeni kapi.json'dan hemen yeniden uygulanacak (panel açılış uzlaştırması)"
    fi
  fi
  cp -a "$son" "$PANEL_CONF"; rm -f "$CATCH_CONF"
  nginx -t >/dev/null 2>&1 || dur "nginx -t başarısız"
  systemctl reload nginx && ok "eski yapılandırmaya dönüldü ($son)"
  local rc=$?
  # reload düşse bile uygula: dosya artık yedek; bir sonraki herhangi bir reload onu yükler.
  if [ "$kapi" = 1 ]; then
    kapi_yeniden_uygula || rc=1
  fi
  return "$rc"
}

case "${1:-durum}" in
  durum)   durum ;;
  ayarla)  ayarla "${2:-}" ;;
  sifirla) sifirla ;;
  *) echo "Kullanım: girginospanel-panelhost {durum|ayarla [hostname]|sifirla}"; exit 1 ;;
esac
