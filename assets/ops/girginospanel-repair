#!/usr/bin/env bash
# girginospanel-repair — dizin / sahiplik / izin / SELinux onarım aracı
# Idempotent + TAHRİBATSIZ: yalnızca chown/chmod/mkdir/restorecon/semanage yapar.
# Asla silmez, fuser çağırmaz, çalışan servisi bozmaz. Tekrar tekrar güvenle çalışır.
#
# Kullanım:
#   girginospanel-repair [--dry-run] [--deep] [--only <bölümler>] [--quiet]
#   bölümler (virgülle): phpmyadmin,selinux_temel,docroot_selinux,domains,htpasswd,binary,clamav,frontend,signon,firewall  (varsayılan: hepsi)
#   --dry-run : değişiklikleri UYGULAMADAN neyin düzeltileceğini göster
#   --deep    : domain ev dizinlerinde RECURSIVE sahiplik onarımı (yavaş, büyük siteler)
#
#   girginospanel-repair restore [...]  → CORE DOSYA İÇERİK onarımı (0-byte frontend / bozuk
#     binary / eksik ops-tool) canonical release'ten atomik+doğrulanmış geri yükleme. secret/veri
#     KORUNUR. Ayrı girginospanel-restore aracına devreder (arg'lar aynen iletilir).
set -uo pipefail

# 🔴 AYRISTIRMA ICIN LC_ALL=C ZORUNLU — TURKCE LOCALE REGEX ARALIGINI BOZUYOR.
# Olculdu (31.56.47.190, LANG=tr_TR.UTF-8):
#     printf '@CT@ audit_log' | grep -oE '@CT@ [a-zA-Z0-9_]+'   ->  "@CT@ aud"
#     ayni komut LC_ALL=C ile                                    ->  "@CT@ audit_log"
# tr_TR collation'inda `a-z` araligi `i` harfini KAPSAMIYOR (noktasiz i/noktali i
# ayrimi), bu yuzden karakter araligi kullanan HER ayristirma `i` harfinde kesiliyor:
#   audit_log -> aud · cp_domains -> cp_doma · cp_websec_findings -> cp_websec_f
# Sonuc: sema kontrolu 22/46 gibi SAHTE bir kritik uretip musteri guncellemesini
# BLOKLADI. Turkiye bizim ana pazarimiz — bu her musteri sunucusunu etkiler.
# LC_ALL=C bayt semantigi verir; ASCII tanimlayici ayristirmak icin dogrusu budur.
export LC_ALL=C

# 'restore' ALT-KOMUTU: içerik onarımını ayrı araca devret. GERİYE UYUMLU — mevcut çağrılar
# (bare / --quiet / --dry-run / --deep / --only) DEĞİŞMEDEN izin/sahiplik/SELinux onarır; sadece
# ilk argüman tam olarak 'restore' ise devreye girer (install.sh'ın --quiet çağrısı etkilenmez).
if [ "${1:-}" = "restore" ]; then
  shift
  command -v girginospanel-restore >/dev/null 2>&1 && exec girginospanel-restore "$@"
  _rd="$(cd "$(dirname "$0")" 2>/dev/null && pwd)/girginospanel-restore"
  [ -x "$_rd" ] && exec "$_rd" "$@"
  echo "girginospanel-restore not found (the core content repair tool is not installed)" >&2; exit 127
fi

# Usage text (English). The Turkish header comment above is developer documentation.
kullanim() {
  cat <<'KULLANIM'
girginospanel-repair — directory / ownership / permission / SELinux repair tool.
Idempotent and non-destructive: it only runs chown/chmod/mkdir/restorecon/semanage. It never
deletes anything, never calls fuser and never disturbs a running service. Safe to run repeatedly.

Usage:
  girginospanel-repair [--dry-run] [--deep] [--only <sections>] [--quiet]
  girginospanel-repair restore [...]

Options:
  --dry-run          show what would be fixed WITHOUT applying any change
  --deep             recursive ownership repair inside domain home directories
                     (slow on large sites)
  --only <sections>  comma-separated sections (default: all of them):
                     env_izin, sir_izin, phpmyadmin, selinux_temel, docroot_selinux,
                     migrations, domains, htpasswd, binary, clamav, frontend, signon,
                     firewall, nginx_cache, backup_cron (also: eklenti_runtime, mail_sieve)
  --quiet            print only the fixes, warnings and errors
  -h, --help         show this help

Subcommand:
  restore            core FILE-CONTENT repair (0-byte frontend / corrupt binary / missing
                     ops tools) by atomic, verified restore from the canonical release.
                     Secrets and data are preserved. Hands over to girginospanel-restore
                     (all arguments are passed through unchanged).

Exit codes: 0 = no errors, 1 = at least one error, 2 = invalid argument,
127 = the restore subcommand could not find girginospanel-restore.
KULLANIM
}

DRY=0; DEEP=0; QUIET=0; ONLY="env_izin,sir_izin,phpmyadmin,selinux_temel,docroot_selinux,migrations,domains,htpasswd,binary,clamav,frontend,signon,firewall,nginx_cache,backup_cron"
while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run) DRY=1 ;;
    --deep)    DEEP=1 ;;
    --quiet)   QUIET=1 ;;
    --only)    shift; ONLY="$1" ;;
    -h|--help) kullanim; exit 0 ;;
    *) echo "unknown argument: $1" >&2; exit 2 ;;
  esac; shift
done

CHK=0; FIXN=0; ERRN=0
c_g="\033[32m"; c_y="\033[33m"; c_r="\033[31m"; c_b="\033[34m"; c_0="\033[0m"
[ -t 1 ] || { c_g=; c_y=; c_r=; c_b=; c_0=; }
say()   { [ $QUIET -eq 1 ] || echo -e "$*"; }
head_() { say "\n${c_b}== $* ==${c_0}"; }
ok()    { CHK=$((CHK+1)); [ $QUIET -eq 1 ] || echo -e "  ${c_g}✓${c_0} $*"; }
act()   { CHK=$((CHK+1)); FIXN=$((FIXN+1)); echo -e "  ${c_y}$([ $DRY -eq 1 ] && echo '→ (dry) ' || echo '✔ FIXED ')${c_0}$*"; }
warn()  { echo -e "  ${c_y}!${c_0} $*"; }
err()   { ERRN=$((ERRN+1)); echo -e "  ${c_r}✗${c_0} $*"; }

SEL=0; command -v getenforce >/dev/null 2>&1 && [ "$(getenforce)" != "Disabled" ] && SEL=1
HAVE_SEMANAGE=0; command -v semanage >/dev/null 2>&1 && HAVE_SEMANAGE=1

# ---- yardımcılar (hepsi idempotent + dry-run duyarlı) ----
ensure_owner() { # path  user:group  [recursive]
  local p=$1 o=$2 r=${3:-}; [ -e "$p" ] || return 0
  local cur; cur=$(stat -c '%U:%G' "$p" 2>/dev/null) || return 0
  if [ "$cur" != "$o" ]; then
    act "chown ${r:+-R }$o  $p  (now: $cur)"
    [ $DRY -eq 0 ] && chown $r "$o" "$p" 2>/dev/null || true
  else
    ok "owner $o  $p"
  fi
}
ensure_mode() { # path  mode
  local p=$1 m=$2; [ -e "$p" ] || return 0
  local cur; cur=$(stat -c '%a' "$p" 2>/dev/null) || return 0
  # baştaki 0'ı normalize et
  if [ "$((8#$cur))" != "$((8#$m))" ]; then
    act "chmod $m  $p  (now: $cur)"
    [ $DRY -eq 0 ] && chmod "$m" "$p" 2>/dev/null || true
  else
    ok "mode $m  $p"
  fi
}
ensure_dir() { # path  mode  owner
  local p=$1 m=$2 o=$3
  if [ ! -d "$p" ]; then
    act "mkdir -p $p (mode $m, owner $o)"
    [ $DRY -eq 0 ] && { mkdir -p "$p"; chmod "$m" "$p"; chown "$o" "$p"; }
  else
    ensure_mode "$p" "$m"; ensure_owner "$p" "$o"
  fi
}
# SELinux fcontext'i KALICI kaydet + uygula (restorecon-safe). semanage yoksa chcon fallback.
ensure_context() { # path  type  [recursive]
  [ $SEL -eq 1 ] || return 0
  local p=$1 t=$2 r=${3:-}
  [ -e "$p" ] || return 0
  if [ $HAVE_SEMANAGE -eq 1 ]; then
    local spec="${p}(/.*)?" _lst
    _lst=$(semanage fcontext -l 2>/dev/null)          # önce yakala (pipefail+grep -q SIGPIPE tuzağından kaçın)
    if ! grep -qF "${spec}" <<<"$_lst"; then
      act "semanage fcontext +$t  $spec  (persistent rule)"
      [ $DRY -eq 0 ] && semanage fcontext -a -t "$t" "$spec" 2>/dev/null || true
    fi
    if [ $DRY -eq 0 ]; then
      local n; n=$(restorecon -R${r:+} -v "$p" 2>/dev/null | wc -l)
      [ "${n:-0}" -gt 0 ] && act "restorecon $p  ($n context(s) fixed)" || ok "SELinux context $t  $p"
    else
      say "  → (dry) restorecon -R $p"
    fi
  else
    local cur; cur=$(stat -c '%C' "$p" 2>/dev/null | cut -d: -f3)
    if [ "$cur" != "$t" ]; then
      act "chcon -t $t  $p  (no semanage — temporary)"
      [ $DRY -eq 0 ] && chcon ${r:+-R} -t "$t" "$p" 2>/dev/null || true
    else
      ok "SELinux context $t  $p"
    fi
  fi
}
want() { echo ",$ONLY," | grep -q ",$1,"; }

# ---- kiracı ağacı yardımcıları ----
# 🔴 KİRACI AĞACINDA YOL ÜZERİNDEN chmod/chown YAPMA. Kiracı kendi evinde
# ~/.ssh, ~/public_html ya da ~/.karantina'yı symlink yapabilir (ör. ~/.ssh -> /,
# ~/public_html -> /root). `[ -d ]`, `stat` ve `chmod` symlink'i izler; chown -h'siz
# de izler. Root bu yüzden kiracının gösterdiği sistem yolunu chmod/chown ederdi
# (chmod 700 / → sistem çapında DoS; chmod 755 /root → ifşa; .karantina -> başka
# kiracının evi → root:root 700). Linux'ta chmod'un -h karşılığı yok; bu yüzden:
#   1) symlink ise hiç dokunma,
#   2) dizine `cd -P` ile gir ve kernel'in verdiği gerçek yolu (pwd -P) beklenen
#      yolla (gerçek üst dizin + ad) karşılaştır,
#   3) işlemi '.' üzerinde yap: cwd inode'a sabitlenmiştir; kiracı adı denetimden
#      sonra symlink'le değiştirse bile chmod/chown sabitlenen inode'a gider.
kiraci_dizin_onar() { # path  mode  [user:group]
  local p=$1 m=$2 o=${3:-}
  if [ -L "$p" ]; then warn "symlink — not followed in the tenant tree, skipped: $p"; return 0; fi
  [ -d "$p" ] || return 0
  local ust ad beklenen cur curo degis=0
  ust=$(cd -P -- "$(dirname -- "$p")" 2>/dev/null && pwd -P) || { err "parent directory could not be resolved: $p"; return 0; }
  ad=$(basename -- "$p"); beklenen="$ust/$ad"
  cur=$(stat -c '%a' -- "$p" 2>/dev/null) || return 0      # stat -L'siz = lstat
  curo=$(stat -c '%U:%G' -- "$p" 2>/dev/null) || return 0
  [ "$((8#$cur & 07777))" != "$((8#$m))" ] && degis=1
  [ -n "$o" ] && [ "$curo" != "$o" ] && degis=1
  if [ $degis -eq 0 ]; then ok "mode $m${o:+ owner $o}  $p"; return 0; fi
  act "tenant directory ${o:+chown $o + }chmod $m  $p  (now: $curo $cur)"
  [ $DRY -eq 1 ] && return 0
  if ! ( cd -P -- "$p" 2>/dev/null || exit 3
         [ "$(pwd -P)" = "$beklenen" ] || exit 4
         if [ -n "$o" ]; then chown -h -- "$o" . || exit 5; fi
         chmod -- "$m" . || exit 6 ); then
    err "tenant directory could not be repaired (moved/symlink or permission error): $p"
  fi
}

# Bir domain ev dizinini onar (sec_domains gövdesi; test için ayrı fonksiyon).
domain_evi_onar() { # home  sk
  local home=$1 sk=$2 child bn
  ensure_owner "$home" "$sk:$sk"
  ensure_mode  "$home" 711
  # ÖNEMLİ: .karantina root'a ait KALMALI (müşteri zararlıya erişmesin) → hariç tut.
  # Sabit bağlı (links>1) düzenli dosya atlanır: protected_hardlinks=0 olan bir
  # sunucuda kiracı root'a ait bir dosyayı (ör. /etc/shadow) evine bağlayıp
  # repair'e kendine chown ettirebilirdi. chown -h: symlink'in kendisi değişir.
  while IFS= read -r child; do
    [ -z "$child" ] && continue
    bn=$(basename "$child")
    [ "$bn" = ".karantina" ] && continue
    # root:root 0700 dizin: kiracı .karantina'yı başka ada taşımış olabilir (aynı üst
    # dizinde rename serbest). Devredersek karantinadaki 0000 dosyalar kiracıya açılır.
    if [ -d "$child" ] && [ ! -L "$child" ] && [ "$(stat -c '%u %a' -- "$child" 2>/dev/null)" = "0 700" ]; then
      warn "root:root 0700 directory (may be a relocated quarantine) not handed over — inspect manually: $child"
      continue
    fi
    ensure_owner "$child" "$sk:$sk" -hR
  done < <(find -P "$home" -maxdepth 1 -mindepth 1 ! -user "$sk" \( -type d -o -type l -o -links 1 \) 2>/dev/null)
  kiraci_dizin_onar "$home/public_html" 755
  kiraci_dizin_onar "$home/.ssh" 700
  # karantina: root-owned + kilitli
  kiraci_dizin_onar "$home/.karantina" 700 "root:root"
  if [ $DEEP -eq 1 ]; then
    local n; n=$(find -P "$home" \( -path "$home/.karantina" -o -type d -user 0 -perm 700 \) -prune -o ! -user "$sk" \( -type d -o -type l -o -links 1 \) -print 2>/dev/null | wc -l)
    if [ "${n:-0}" -gt 0 ]; then
      act "DEEP chown -R $sk:$sk $home ($n wrongly-owned entries; excluding .karantina, root:root 0700 directories and hard-linked files)"
      # -execdir: find dizinlere fts ile (symlink izlemeden) iner ve komutu o dizinde
      # ./ad ile koşar → ara dizin symlink'e çevrilse bile yol yeniden çözülmez.
      [ $DRY -eq 0 ] && find -P "$home" \( -path "$home/.karantina" -o -type d -user 0 -perm 700 \) -prune -o ! -user "$sk" \( -type d -o -type l -o -links 1 \) -execdir chown -h "$sk:$sk" {} + 2>/dev/null
    fi
  fi
  [ $SEL -eq 1 ] && [ $DRY -eq 0 ] && restorecon -R "$home" >/dev/null 2>&1
}

# ================= BÖLÜMLER =================
sec_phpmyadmin() {
  want phpmyadmin || return 0
  head_ "phpMyAdmin"
  local PMA=/opt/phpmyadmin
  [ -d "$PMA" ] || { warn "$PMA missing, skipping"; return 0; }
  local PG; PG=$(awk -F= '/^[[:space:]]*group/{gsub(/ /,"",$2);print $2}' /etc/php-fpm.d/phpmyadmin.conf 2>/dev/null); PG=${PG:-apache}
  ensure_context "$PMA" httpd_sys_content_t -R
  if [ -f "$PMA/config.inc.php" ]; then
    # pool kullanıcısı (apache) okuyabilmeli; secret içerdiği için world-readable OLMAMALI
    ensure_owner "$PMA/config.inc.php" "root:$PG"
    ensure_mode  "$PMA/config.inc.php" 640
    if ! runuser -u "$PG" -- test -r "$PMA/config.inc.php" 2>/dev/null; then
      err "config.inc.php is STILL not readable by $PG!"
    else
      ok "config.inc.php is readable by $PG"
    fi
  else
    warn "config.inc.php missing"
  fi
  # TempDir + sessions: php-fpm (apache) yazabilmeli
  ensure_dir "/var/lib/phpmyadmin"          755 "$PG:$PG"
  ensure_dir "/var/lib/phpmyadmin/tmp"      755 "$PG:$PG"
  ensure_dir "/var/lib/phpmyadmin/sessions" 700 "$PG:$PG"
  ensure_context "/var/lib/phpmyadmin" httpd_sys_rw_content_t -R
}

sec_signon() {
  want signon || return 0
  head_ "pma-signon"
  local S=/opt/girginospanel/pma-signon
  [ -d "$S" ] || { warn "$S missing"; return 0; }
  ensure_context "$S" httpd_sys_content_t -R
}

sec_firewall() {
  want firewall || return 0
  head_ "firewall (firewalld → the panel takes over)"
  # Panel firewall'ı kendi nftables tablosunu (girginos_fw) yönetir. AlmaLinux
  # varsayılan firewalld ile ÇAKIŞIR: nftables'ta bir tablonun base chain'inde
  # 'drop' KESİNDİR → firewalld panelin portlarını (8443/80/443/53/21) düşürür,
  # panelin 'accept' politikası bunu EZEMEZ → panel UI erişilemez, siteler açılmaz.
  # Tek otorite panel olsun diye firewalld'yi durdur+kapat+mask ediyoruz.
  # firewalld durunca kendi nft tablosunu ANINDA temizler → reboot GEREKMEZ.
  if ! systemctl cat firewalld.service >/dev/null 2>&1; then
    ok "firewalld is not installed — panel nftables is already the only firewall"
    return 0
  fi
  if [ "$(systemctl is-enabled firewalld 2>/dev/null)" = "masked" ]; then
    ok "firewalld is already masked (the panel has taken over)"
    return 0
  fi
  act "firewalld active/enabled → stop + mask (the panel takes over)"
  if [ $DRY -eq 0 ]; then
    systemctl disable --now firewalld >/dev/null 2>&1 || true
    systemctl mask firewalld >/dev/null 2>&1 || true
  fi
}

sec_frontend() {
  want frontend || return 0
  head_ "frontend-dist"
  local F=/opt/girginospanel/frontend-dist
  [ -d "$F" ] || { warn "$F missing"; return 0; }
  ensure_owner "$F" "root:root"
  ensure_context "$F" httpd_sys_content_t -R
}

sec_binary() {
  want binary || return 0
  head_ "server binary"
  local B=/opt/girginospanel/bin/girginospanel-server
  [ -f "$B" ] || { warn "$B missing"; return 0; }
  ensure_mode "$B" 755
  # systemd exec bağlamı (203/EXEC hatası buradan) — restorecon varsayılana döndürür
  if [ $SEL -eq 1 ] && [ $DRY -eq 0 ]; then
    local n; n=$(restorecon -v "$B" 2>/dev/null | wc -l)
    [ "${n:-0}" -gt 0 ] && act "restorecon $B (exec context fixed)" || ok "SELinux exec context OK  $B"
  fi
}

sec_htpasswd() {
  want htpasswd || return 0
  head_ "nginx htpasswd (password-protected directories)"
  local D=/etc/nginx/htpasswd
  [ -d "$D" ] || { ok "htpasswd directory missing (no protection defined)"; return 0; }
  ensure_mode "$D" 755
  local f
  for f in "$D"/*; do
    [ -f "$f" ] || continue
    ensure_mode "$f" 644
  done
  ensure_context "$D" httpd_config_t -R   # /etc/nginx fcontext → nginx okuyabilir
}

sec_clamav() {
  want clamav || return 0
  head_ "ClamAV signature database"
  local C=${GOSP_CLAMAV_DIZIN:-/var/lib/clamav}   # (testler geçici dizin verir)
  [ -d "$C" ] || { ok "clamav not present"; return 0; }
  # 🔴 Sahip ADLA bulunur, UID ile DEĞİL. Eskiden `getent passwd 992` vardı: UID'ler kurulumdan kuruluma
  # değişir; temiz AlmaLinux 10'da 992 = valkey çıktı → imza dizini valkey'e devredildi, freshclam
  # (clamupdate olarak çalışır) "Can't create temporary directory" ile her güncellemede düştü ve imzalar
  # bayatladı (2026-10-06, test sunucusu 144.76.189.3).
  local OWN
  for OWN in clamupdate clamav; do id -u "$OWN" >/dev/null 2>&1 && break; OWN=""; done
  [ -n "$OWN" ] || { ok "no clamav user (clamupdate/clamav) — ownership skipped"; return 0; }
  local GRP; GRP=$(id -gn "$OWN" 2>/dev/null) || GRP=$OWN
  # freshclam bu dizine yazamazsa imza güncellenemez
  ensure_owner "$C" "$OWN:$GRP" -R
  ensure_mode  "$C" 755
}

# ---- veritabani gocleri (schema drift) ----
# 🔴 GERCEK ARIZA: panel gocleri /opt/girginospanel/src/migrations dizininden
# okur. Yayin sirasinda YALNIZ ikili guncellenip bu dizin senkronlanmazsa yeni
# .sql dosyalari sunucuya HIC gelmez; kolonlar eksik kalir ve sayfalar
# "Unknown column ..." ile coker (orn. Bayi Planlari / reseller_plans.mail_*).
# Burada kaynak dizin ile calisan dizin karsilastirilir, eksikler kopyalanir.
sec_migrations() {
  want migrations || return 0
  head_ "database migrations (schema drift)"

  local RUN=/opt/girginospanel/src/migrations
  local SRC=""
  local aday
  for aday in /opt/girginospanel/src/migrations /root/gpanel-temiz/migrations /opt/girginospanel/migrations; do
    [ -d "$aday" ] && [ "$aday" != "$RUN" ] && SRC="$aday" && break
  done

  if [ ! -d "$RUN" ]; then
    err "migration directory missing: $RUN"
    return 0
  fi

  # 1) Kaynak dizin varsa eksik dosyalari tasi
  if [ -n "$SRC" ]; then
    local eksik=0 f
    for f in "$SRC"/*.sql; do
      [ -e "$f" ] || continue
      if [ ! -f "$RUN/$(basename "$f")" ]; then
        eksik=$((eksik+1))
        act "copying missing migration: $(basename "$f")"
        [ $DRY -eq 0 ] && cp -n "$f" "$RUN/"
      fi
    done
    [ "$eksik" -eq 0 ] && ok "migration files up to date ($SRC -> $RUN)"
  else
    ok "no separate source migration directory — using only $RUN"
  fi

  # 2) Defterde olmayan (hic kosmamis) goc var mi?
  if command -v mysql >/dev/null 2>&1; then
    local bekleyen=0 dosya ad
    while IFS= read -r dosya; do
      ad=$(basename "$dosya")
      if ! mysql -N panel -e "SELECT 1 FROM schema_migrations WHERE dosya='$ad'" 2>/dev/null | grep -q 1; then
        bekleyen=$((bekleyen+1))
        warn "not in the ledger (will run at startup): $ad"
      fi
    done < <(ls "$RUN"/*.sql 2>/dev/null)
    if [ "$bekleyen" -gt 0 ]; then
      act "$bekleyen pending migration(s) -> restarting the panel (migrations run at startup)"
      [ $DRY -eq 0 ] && systemctl restart girginospanel && sleep 6
    else
      ok "all migrations are recorded in the ledger"
    fi

    # 3) Bilinen kritik kolonlar gercekten var mi? (goc kostu ama sessiz basarisiz olabilir)
    local kayip=0
    kolon_var() { # tablo kolon
      mysql -N panel -e "SHOW COLUMNS FROM $1 LIKE '$2'" 2>/dev/null | grep -q "$2"
    }
    for ck in "reseller_plans:mail_max_email" "reseller_plans:mail_saatlik_limit" \
              "reseller_plans:mail_kutu_kota_mb" "cp_eklenti_lisans:uyari"; do
      local t="${ck%%:*}" k="${ck##*:}"
      mysql -N panel -e "SELECT 1 FROM information_schema.TABLES WHERE TABLE_SCHEMA='panel' AND TABLE_NAME='$t'" 2>/dev/null | grep -q 1 || continue
      if kolon_var "$t" "$k"; then :; else kayip=$((kayip+1)); err "MISSING COLUMN: $t.$k — the related migration has not run"; fi
    done
    [ "$kayip" -eq 0 ] && ok "critical schema columns in place"
  else
    warn "mysql client missing — ledger/column check skipped"
  fi
}

sec_domains() {
  want domains || return 0
  head_ "domain home directories (/home/c_*)"
  local home sk
  for home in /home/c_*; do
    [ -d "$home" ] || continue
    sk=$(basename "$home")
    if ! getent passwd "$sk" >/dev/null; then warn "$sk: system user missing, skipping"; continue; fi
    domain_evi_onar "$home" "$sk"
  done
}

# ---- SELinux TEMEL — kurulum + update'in ORTAK, idempotent garantisi ----
# 🔴 Kurulum booleanları/fcontext'leri/port etiketini yazıyordu; update HİÇBİRİNİ yazmıyordu
# (yalnız panel açılışındaki Go heal'i 2 boolean + php-fpm kuralını koruyordu). Politika
# sıfırlanmış / elle bozulmuş / eski kurulumda eksik kalmış sunucu Enforcing'de sessizce
# kırılıyordu. Bu bölüm HEPSİNİ tek yerde toplar; install adım 14 (çıplak repair) ve update
# (`--only selinux_temel,...`) AYNI kodu çağırır. SELinux Disabled → sessiz geçer. Mod
# değiştirmez (setenforce / /etc/selinux/config'e DOKUNMAZ).
#
# Her `semanage fcontext -a` / `setsebool -P` TÜM politikayı yeniden derler (~12 sn) →
# yalnız eksik olan yazılır; boolean'lar tek `setsebool -P a=1 b=1` çağrısında toplanır.
SELINUX_BOOLEANLAR="httpd_can_network_connect httpd_can_network_connect_db httpd_enable_homedirs httpd_read_user_content"
SELINUX_FTP_BOOLEANLAR="ftpd_full_access ftpd_connect_db ftpd_use_passive_mode"
SELINUX_FCONTEXT='httpd_sys_content_t|/opt/phpmyadmin(/.*)?
httpd_sys_rw_content_t|/var/lib/phpmyadmin(/.*)?
httpd_sys_content_t|/opt/girginospanel/frontend-dist(/.*)?
httpd_sys_content_t|/opt/girginospanel/pma-signon(/.*)?
httpd_var_run_t|/run/php-fpm-[^/]+(/.*)?
httpd_user_rw_content_t|/home/c_[^/]+/(public_html|tmp)(/.*)?'

# etiket_duzelt DIR [F|N]: alt ağacı politika varsayılanına döndürür; düzeltilen (dry-run:
# düzeltilecek) dosya sayısını basar. Tek geçiş; 300 sn üst sınır.
#   F (varsayılan) → -F: customizable tipler (httpd_sys_content_t vb. başka yerden gelmiş) de
#                    sıfırlanır — kiracı belge kökü için ŞART.
#   N              → -F'siz (sistem yolları: kurulumun eski `restorecon -R` davranışı).
# 🔴 SAYIM yalnız TİP farkını sayar: `unconfined_u:` ↔ `system_u:` kullanıcı alanı farkı
# (181'de 5162 dosya) zararsızdır; sayılsaydı her koşuda sahte "düzeltme" raporlanırdı.
etiket_duzelt() {
  local d=$1 fl=RFv n
  [ "${2:-F}" = N ] && fl=Rv
  [ $DRY -eq 1 ] && fl="n$fl"
  n=$(timeout 300 restorecon -"$fl" "$d" 2>/dev/null \
      | awk 'NF>=5 { split($(NF-2),a,":"); split($NF,b,":"); if (a[3]!=b[3]) c++ } END { print c+0 }')
  echo "${n:-0}"
}

# WAF (ModSecurity v3, PCRE2 JIT) nginx (httpd_t) altında her başlatma/reload'da `execmem` ister;
# `httpd_execmem` kapalıysa Enforcing'de AVC üretir ve PCRE2 JIT'siz yorumlayıcıya düşer (WAF yine
# çalışır). Boolean bir güvenlik gevşetmesidir → YALNIZ WAF kuruluysa açılır; WAF yoksa dokunulmaz
# (ve açıksa KAPATILMAZ: kullanıcının kendi ayarı olabilir).
# GOSP_REPAIR_WAF_MODUL / GOSP_REPAIR_WAF_DAMGA: yalnız test kancası; üretimde ayarlanmaz.
waf_kurulu() {
  [ -f "${GOSP_REPAIR_WAF_MODUL:-/usr/lib64/nginx/modules/ngx_http_modsecurity_module.so}" ] \
    || [ -f "${GOSP_REPAIR_WAF_DAMGA:-/etc/nginx/modsec/.built_for_nginx}" ]
}

sec_selinux_temel() {
  want selinux_temel || return 0
  head_ "SELinux base (booleans + fcontext + port + labels)"
  if [ $SEL -ne 1 ]; then ok "SELinux is off — this section is not needed"; return 0; fi

  # -- booleanlar (tek setsebool -P çağrısı) --
  if ! command -v getsebool >/dev/null 2>&1 || ! command -v setsebool >/dev/null 2>&1; then
    warn "getsebool/setsebool missing (policycoreutils) — booleans could not be checked"
  else
    local liste="$SELINUX_BOOLEANLAR" b cur eksik=""
    # FTP booleanları yalnız pure-ftpd kuruluysa (ftp-setup'ın yazdığı küme).
    if command -v pure-ftpd >/dev/null 2>&1 || rpm -q pure-ftpd >/dev/null 2>&1; then
      liste="$liste $SELINUX_FTP_BOOLEANLAR"
    fi
    # WAF modülü kuruluysa httpd_execmem de istenir (yoksa listeye girmez → hiç dokunulmaz).
    if waf_kurulu; then
      liste="$liste httpd_execmem"
    fi
    for b in $liste; do
      cur=$(getsebool "$b" 2>/dev/null)
      case "$cur" in
        *"--> on") ok "boolean $b=on" ;;
        *"--> off") eksik="$eksik $b=1"
          if [ "$b" = httpd_execmem ]; then
            act "boolean $b is off → will be turned on (persistent; WAF installed: libmodsecurity PCRE2 JIT)"
          else
            act "boolean $b is off → will be turned on (persistent)"
          fi ;;
        *) warn "boolean $b not in the policy / could not be read — skipped" ;;
      esac
    done
    if [ -n "$eksik" ] && [ $DRY -eq 0 ]; then
      # shellcheck disable=SC2086
      if setsebool -P $eksik >/dev/null 2>&1; then
        ok "setsebool -P$eksik"
      else
        err "setsebool -P$eksik FAILED — httpd network/home access may be broken"
      fi
    fi
  fi

  # -- fcontext kuralları --
  if [ $HAVE_SEMANAGE -ne 1 ]; then
    warn "semanage missing (policycoreutils-python-utils) — persistent fcontext rules cannot be written (restorecon falls back to temporary labels)"
  else
    local lst spec tip satir
    lst=$(semanage fcontext -l 2>/dev/null)   # önce yakala (pipefail+grep -q SIGPIPE tuzağı)
    while IFS='|' read -r tip spec; do
      [ -n "$spec" ] || continue
      case "$lst" in
        *"$spec"*) ok "fcontext $tip  $spec" ;;
        *)
          act "semanage fcontext +$tip  $spec  (persistent rule)"
          if [ $DRY -eq 0 ]; then
            semanage fcontext -a -t "$tip" "$spec" 2>/dev/null \
              || semanage fcontext -m -t "$tip" "$spec" 2>/dev/null \
              || err "fcontext could not be written: $spec"
          fi ;;
      esac
    done <<<"$SELINUX_FCONTEXT"

    # -- Apache backend portu (kurulumda httpd varsa 127.0.0.1:10080) --
    if [ -f "${GOSP_REPAIR_HTTPD_CONF:-/etc/httpd/conf/httpd.conf}" ]; then   # (env: test kancası)
      local pl; pl=$(semanage port -l 2>/dev/null)
      satir=""
      while IFS= read -r l; do
        case "$l" in "http_port_t "*tcp*) satir=$l ;; esac
      done <<<"$pl"
      if [[ "$satir" =~ (^|[[:space:],])10080($|[[:space:],]) ]]; then
        ok "port 10080 http_port_t (Apache backend)"
      else
        act "semanage port +http_port_t tcp 10080 (Apache backend)"
        if [ $DRY -eq 0 ]; then
          semanage port -a -t http_port_t -p tcp 10080 2>/dev/null \
            || semanage port -m -t http_port_t -p tcp 10080 2>/dev/null \
            || err "port 10080 http_port_t could not be written — the Apache backend will not start"
        fi
      fi
    fi
  fi

  # -- sabit yolların etiketi (kural yazıldıktan SONRA) --
  local p n
  for p in /opt/phpmyadmin /var/lib/phpmyadmin /opt/girginospanel/frontend-dist /opt/girginospanel/pma-signon /opt/girginospanel/bin /var/named /etc/named; do
    [ -d "$p" ] || continue
    [ -L "$p" ] && { warn "symlink — skipped: $p"; continue; }
    n=$(etiket_duzelt "$p" N)
    if [ "${n:-0}" -gt 0 ]; then act "restorecon $p  ($n context(s))"; else ok "label $p"; fi
  done
}

sec_docroot_selinux() {
  want docroot_selinux || return 0
  head_ "tenant document root SELinux (WordPress/Laravel writes)"
  if [ $SEL -ne 1 ]; then ok "SELinux is off — this section is not needed"; return 0; fi

  # 🔴 RHEL/AlmaLinux'un varsayılan kuralı:
  #     /home/*/public_html(/.+)?  →  httpd_user_content_t   (SALT-OKUNUR)
  # Enforcing modda PHP siteye YAZAMAZ. WordPress bunu görünce "FTP
  # bilgileri" formu açar; eklenti/tema/güncelleme kurulamaz. Belirti
  # sinsidir: AVC kaydı bile düşmez (is_writable → access() denetimleri
  # dontaudit'li), log'a bakan sebebi bulamaz.
  #
  # 🔴 ALT AĞAÇ DA DENETLENİR (2026-10-06, 181): eskiden yalnız dizinin KENDİ etiketine
  # bakılıp "doğru" ise `continue` ediliyordu. `cp -al`/`mv`/`rsync` ile gelen dosyalar
  # kaynak etiketini (user_home_t) taşır; üst dizin doğru olsa bile içerik yanlış kalıyor,
  # Enforcing'de database.sqlite create/unlink reddi alıyordu. Artık her koşuda alt ağaç
  # restorecon -RF'ten geçer (yalnız yanlış olanı değiştirir, doğru olana yazmaz).
  local n=0 duzeltilen=0 sapma=0
  # public_html + tmp: ikisi de PHP tarafindan YAZILIR olmali.
  # tmp varsayilan olarak user_tmp_t etiketlidir ve httpd domaini
  # oraya yazamaz -> WordPress eklenti indiremez ("Permission denied").
  # GOSP_REPAIR_EV_KOKU: yalnız test kancası (varsayılan /home); üretimde ayarlanmaz.
  local evk="${GOSP_REPAIR_EV_KOKU:-/home}"
  for d in "$evk"/c_*/public_html "$evk"/c_*/tmp; do
    # Kiracı bu adı symlink yapabilir: fcontext kuralı/restorecon hedefi olarak
    # kiracının gösterdiği yolu kullanma.
    [ -L "$d" ] && { warn "symlink — skipped: $d"; continue; }
    [ -d "$d" ] || continue
    n=$((n+1))
    local mevcut; mevcut=$(ls -Zd "$d" 2>/dev/null | awk '{print $1}')
    local ustdogru=0
    case "$mevcut" in *httpd_user_rw_content_t*) ustdogru=1 ;; esac

    if [ $ustdogru -eq 0 ]; then
      act "SELinux writable label  $d  (now: ${mevcut##*:object_r:})"
      if [ $DRY -eq 0 ]; then
        # Politika bu yolu ZATEN yazılabilir tipe çözüyorsa (genel kural: selinux_temel /
        # wp-onkosul) kiracıya özel kural GEREKSİZ — her `semanage -a` ~12 sn politika derler.
        local mp; mp=$(matchpathcon -n "$d" 2>/dev/null)
        case "$mp" in
          *httpd_user_rw_content_t*) : ;;
          *)
            if [ $HAVE_SEMANAGE -eq 1 ]; then
              semanage fcontext -a -t httpd_user_rw_content_t "${d}(/.*)?" 2>/dev/null \
                || semanage fcontext -m -t httpd_user_rw_content_t "${d}(/.*)?" 2>/dev/null || true
            else
              # semanage yok: kalıcı kural yazılamaz → geçici chcon (restorecon bunu geri alır).
              warn "semanage missing — TEMPORARY chcon for $d (install policycoreutils-python-utils)"
              chcon -R -t httpd_user_rw_content_t "$d" 2>/dev/null || true
            fi ;;
        esac
      fi
    fi
    # 🔴 -F ŞART: kural yeni eklendiğinde `restorecon -R` mevcut etiketi
    # değiştirmeyebiliyor (canlıda birebir yaşandı). Alt ağaç dahil, tek geçiş.
    local kac; kac=$(etiket_duzelt "$d")
    if [ "${kac:-0}" -gt 0 ]; then
      [ $ustdogru -eq 1 ] && act "$kac file(s) in the subtree were mislabeled  $d"
      sapma=$((sapma+kac))
    fi
    if [ $DRY -eq 0 ]; then
      local sonra; sonra=$(ls -Zd "$d" 2>/dev/null | awk '{print $1}')
      case "$sonra" in
        *httpd_user_rw_content_t*) [ $ustdogru -eq 0 ] && duzeltilen=$((duzeltilen+1)) ;;
        *) err "label did not change: $d (now ${sonra##*:object_r:})" ;;
      esac
    fi
  done
  if [ "$n" -eq 0 ]; then ok "no tenant directories"
  elif [ $DRY -eq 1 ]; then say "  → (dry) $n directories scanned; $sapma file(s) would be fixed"
  else ok "$n directories: $duzeltilen parent directories + $sapma files moved to the writable label"; fi
}

sec_nginx_cache() {
  want nginx_cache || return 0
  head_ "nginx cache directory (fastcgi_cache)"
  # 🔴 /var/cache/nginx RPM tarafindan 0700 root:root birakiliyor.
  # Alt dizin (girgincache) dogru sahiplenmis olsa BILE nginx worker ust
  # dizini TRAVERSE edemiyor ve cache loader sunu veriyor:
  #   [crit] opendir() "/var/cache/nginx/girgincache" failed (13: Permission denied)
  # Belirti sinsi: nginx AYAKTA kalir, hicbir vhost patlamaz, hicbir istek
  # hata vermez -- yalnizca sayfa onbellegi SESSIZCE devre disi kalir.
  # Mevcut sunucular installer duzeltmesini almayacagi icin onarim burada.
  [ -d /var/cache/nginx ] || { ok "/var/cache/nginx missing - cache not configured"; return 0; }
  # 🔴 HAM STRING KARSILASTIRMASI YANLIS: setgid/sticky bitli mesru bir dizinde
  # (2755, 1755) `stat -c%a` "2755" doner, "755" ile esitlenmez ve `chmod 0755`
  # GNU coreutils'te dizinde setgid'i TEMIZLEMEZ -> her kosuda "DUZELTILDI"
  # yalani + hemen ardindan "✗ izin degismedi" + KALICI exit 1. Yalnizca ALT
  # 9 BITE bakiyoruz (ensure_mode zaten boyle yapiyor).
  local izin; izin=$(stat -c%a /var/cache/nginx 2>/dev/null)
  local izin9=$(( 8#${izin:-0} & 0777 ))
  if [ "$izin9" = "$(( 8#755 ))" ]; then
    ok "/var/cache/nginx mode correct (755)"
  else
    act "chmod 0755 /var/cache/nginx  (now: $izin)"
    if [ $DRY -eq 0 ]; then
      # u+rwx,go+rx yuksek bitlere (setgid/sticky) DOKUNMAZ.
      chmod u+rwx,go+rx,go-w /var/cache/nginx 2>/dev/null
      chown root:root /var/cache/nginx 2>/dev/null
      # SONUCU DOGRULA: chmod sessizce basarisiz olabilir (immutable bayrak,
      # salt-okunur fs). "calistirdim" ile "oldu" ayni sey degil.
      local y; y=$(stat -c%a /var/cache/nginx 2>/dev/null)
      if [ "$(( 8#${y:-0} & 0777 ))" = "$(( 8#755 ))" ]; then
        ok "mode $izin -> 755 (nginx can traverse it now)"
      else
        err "mode did not change (still $y)"
        return 0
      fi
    fi
  fi
  # Onbellek alt dizini nginx e ait olmali
  local CD=/var/cache/nginx/girgincache
  if [ -d "$CD" ]; then
    local sah; sah=$(stat -c%U "$CD" 2>/dev/null)
    if [ "$sah" != "nginx" ]; then
      act "chown nginx:nginx $CD  (now: $sah)"
      [ $DRY -eq 0 ] && { chown -R nginx:nginx "$CD" 2>/dev/null || err "could not take ownership of $CD"; }
    else
      ok "$CD owner correct (nginx)"
    fi
  fi
  # Gercekten acilabiliyor mu -- URETIM kullanicisiyla, izin bitine bakarak degil.
  if [ $DRY -eq 0 ] && [ -d "$CD" ] && command -v runuser >/dev/null 2>&1; then
    if runuser -u nginx -- test -r "$CD" 2>/dev/null; then
      ok "the nginx user can ACTUALLY read the cache directory"
    else
      err "the nginx user still cannot read $CD"
    fi
  fi
}

sec_eklenti_runtime() {
  want eklenti_runtime || return 0
  head_ "plugin sockets and brand directory"
  # 🔴 IKI AYRI KUSUR, AYNI BELIRTI: panelde "Bu modul su an hazirlaniyor".
  #
  # (a) Butun `girginospanel-eklenti-*` birimleri `RuntimeDirectory=girginospanel`
  #     tanimliyor. systemd bu dizini birim DURUNCA siler; bir eklentiyi
  #     yeniden baslatmak DIGER eklentilerin soketlerini de siliyor. O
  #     surecler yasamaya devam ediyor ama artik erisilemezler.
  #     Duzeltme: her birime `RuntimeDirectoryPreserve=yes` drop-in'i.
  #
  # (b) Whitelabel birimi `ReadWritePaths=-/opt/girginospanel/marka` diyor.
  #     Bastaki `-`, yol YOKSA onu sessizce atlar; dizin olusturulmadan
  #     servis baslarsa marka kaydetme "read-only file system" ile duser.
  #     Duzeltme: dizini VAR ET (birim disinda, namespace'e girmeden).
  local d=/opt/girginospanel/marka
  if [ ! -d "$d" ]; then
    install -d -m 0755 -o root -g root "$d" && ok "brand directory created ($d)" \
      || warn "brand directory could not be created ($d)"
  else
    ok "brand directory exists ($d)"
  fi

  local birim degisti=0
  for birim in $(systemctl list-unit-files --no-legend "girginospanel-eklenti-*.service" 2>/dev/null | awk "{print \$1}"); do
    [ -n "$birim" ] || continue
    if [ "$(systemctl show -p RuntimeDirectoryPreserve --value "$birim" 2>/dev/null)" = "yes" ]; then
      continue
    fi
    local dd="/etc/systemd/system/${birim}.d"
    install -d -m 0755 "$dd" 2>/dev/null || continue
    printf "[Service]\nRuntimeDirectoryPreserve=yes\n" > "$dd/20-gosp-runtime.conf" \
      && { ok "$birim: RuntimeDirectoryPreserve=yes"; degisti=1; } \
      || warn "$birim: drop-in could not be written"
  done
  if [ "$degisti" = "1" ]; then
    systemctl daemon-reload 2>/dev/null && ok "daemon-reload"
    # 🔴 Soketi ZATEN silinmis olan eklentiler yeniden baslatilmali; preserve
    # yalnizca BUNDAN SONRA silinmesini onler, kayip soketi geri getirmez.
    for birim in $(systemctl list-unit-files --no-legend "girginospanel-eklenti-*.service" 2>/dev/null | awk "{print \$1}"); do
      local ad="${birim#girginospanel-eklenti-}"; ad="${ad%.service}"
      local sk="/run/girginospanel/eklenti-${ad}.sock"
      if [ "$(systemctl is-active "$birim" 2>/dev/null)" = "active" ] && [ ! -S "$sk" ]; then
        systemctl restart "$birim" 2>/dev/null && ok "$ad: socket was missing, service restarted" \
          || warn "$ad: could not be restarted"
      fi
    done
  else
    ok "preserve is already on in all plugin units"
  fi
}

sec_env_izin() {
  want env_izin || return 0
  head_ "panel env file mode (/etc/girginospanel/env)"
  # 🔴🔴 BU DOSYA HERKESE OKUNUR OLABILIR ve icinde PANEL_JWT_SECRET,
  # PANEL_DB_DSN (DB parolasi) ve PANEL_REDIS_ADMIN_PASS var.
  #
  # Kurucu artik `chmod 600` yapiyor ama o satir sonradan eklendi: daha eski
  # bir surumle kurulmus her panelde dosya `0644` kalmis olabilir. Olculdu
  # (.181): gercek bir kiraci sistem kullanicisi dosyayi OKUYABILIYORDU.
  #
  # Etki, yedeklerle sinirli degil: JWT sirrini okuyan bir kiraci `rol=admin`
  # jetonu uretip panelin TUM yetki denetimini baypas edebilir. /proc
  # hidepid'siz bagli oldugu icin surec ortamindan da okunabiliyordu.
  local f=/etc/girginospanel/env
  # 🔴 symlink TAKIP EDILMEZ: chown/chmod symlink'in hedefini degistirirdi.
  if [ -L "$f" ]; then err "env file is a symlink — not followed, inspect manually: $f"; return 0; fi
  [ -f "$f" ] || { ok "env file missing (incomplete install?)"; return 0; }
  local mod sahip
  mod="$(stat -c %a "$f" 2>/dev/null)"
  sahip="$(stat -c %U:%G "$f" 2>/dev/null)"
  if [ "$mod" = "600" ] && [ "$sahip" = "root:root" ]; then
    ok "mode already correct ($mod $sahip)"
    return 0
  fi
  warn "env file $mod $sahip — SECRET LEAK (JWT/DB/Redis passwords)"
  if [ "$DRY" = "1" ]; then
    echo "    [dry] chmod 600 + chown root:root $f"
    return 0
  fi
  chown root:root "$f" 2>/dev/null
  chmod 600 "$f" 2>/dev/null
  # Yedek kopyalar da ayni siri tasir.
  for y in "$f".* ; do
    [ -L "$y" ] && continue
    [ -f "$y" ] || continue
    chown root:root "$y" 2>/dev/null; chmod 600 "$y" 2>/dev/null
  done
  FIXN=$((FIXN+1))
  ok "fixed: $(stat -c '%a %U:%G' "$f")"
}

# sec_sir_izin: gizli dosya envanteri (girginospanel-sir izin --onar) — panel sirlari,
# anahtarlar, TLS ozel anahtarlari, eklenti/posta/FTP/Valkey parolalari. Fazla izni
# SOYAR, yanlis sahibi duzeltir; symlink'e DOKUNMAZ (KRITIK raporlar). Envanter TEK
# yerde (girginospanel-sir); dogrula ayni tabloyla olcer.
sec_sir_izin() {
  want sir_izin || return 0
  head_ "secret file permissions (girginospanel-sir)"
  local arac
  arac=$(command -v girginospanel-sir 2>/dev/null || true)
  [ -n "$arac" ] || { _rd="$(cd "$(dirname "$0")" 2>/dev/null && pwd)/girginospanel-sir"; [ -f "$_rd" ] && arac="$_rd"; }
  [ -n "$arac" ] || { warn "girginospanel-sir missing — secret file permissions not repaired"; return 0; }
  local cikti rc=0
  if [ $DRY -eq 1 ]; then cikti=$(bash "$arac" izin --onar --kuru 2>&1) || rc=$?
  else cikti=$(bash "$arac" izin --onar 2>&1) || rc=$?; fi
  say "$cikti"
  local n; n=$(printf '%s\n' "$cikti" | grep -c '✔ repaired' || true)
  FIXN=$((FIXN + ${n:-0})); CHK=$((CHK+1))
  [ $rc -eq 0 ] || [ $DRY -eq 1 ] || err "CRITICAL secret file permissions remain (see above)"
}

sec_backup_cron() {
  want backup_cron || return 0
  head_ "stray backup cron (girginospanel-backup-all)"
  # 🔴 /etc/cron.d/girginospanel-backup her gece 03:00'te girginospanel-backup-all
  # calistiriyordu. O script `domains.backup_freq` sutununu HIC okumuyordu: panelde
  # yedegi KAPALI (none) olan domainler dahil TUM domainleri her gece tam kopyaliyor,
  # retention'i kod icinde sabit 14 gun uyguluyor ve yazmadan once bos alan
  # KONTROL ETMIYORDU. Sonuc: kok disk sessizce doluyor, dolunca panel + siteler +
  # MySQL birlikte duruyor. Yedekleme artik panel binary'sindeki Go scheduler'da
  # (backup_freq/retention + ana salter + disk kapisi + uzak hedef).
  #
  # Bu onarim yalnizca CRON GIRDISINI yorum satiri yapar. Hicbir yedek dosyasi
  # SILINMEZ (bkz. yedekleri koru kurali) ve /usr/local/bin/girginospanel-backup-all
  # kaldirilmaz -- guncelleme onu zaten no-op stub ile degistirir.
  local f=/etc/cron.d/girginospanel-backup
  [ -f "$f" ] || { ok "no stray backup cron"; return 0; }
  if ! grep -qE '^[^#]*girginospanel-backup-all' "$f"; then
    ok "backup cron already disabled"
    return 0
  fi
  if [ $DRY -eq 1 ]; then
    warn "stray backup cron is ACTIVE (dry-run: not changed)"
    return 0
  fi
  cp -a "$f" "${f}.oncesi" 2>/dev/null
  sed -i 's|^\([^#]*girginospanel-backup-all.*\)$|# girginospanel-repair: the panel scheduler took over (backup_freq + disk gate)\n#\1|' "$f"
  if grep -qE '^[^#]*girginospanel-backup-all' "$f"; then
    err "backup cron could not be disabled: $f"
    return 1
  fi
  act "stray backup cron disabled (backup: ${f}.oncesi)"
}

sec_mail_sieve() {
  want mail_sieve || return 0
  head_ "mail sieve (forwarding/auto-reply engine + forward deliverability)"
  # 🔴 Mevcut kurulumlarda dovecot-pigeonhole KURULU DEGILDI + lmtp/lda'da sieve
  # YOKtu -> forward VE oto-yanit SESSIZCE calismiyordu (mail yalniz yerelde). Ayrica
  # forward'da envelope-from orijinal gonderende kalinca hedef SPF -all ile spam/red
  # olurdu. Bu bolum kiraci izinlerine DOKUNMAZ (paket + dovecot config + restart).
  command -v doveconf >/dev/null 2>&1 || { ok "dovecot missing - skipped"; return 0; }
  [ -f /etc/dovecot/conf.d/99-gosp-mail.conf ] || { ok "mail plugin not installed - skipped"; return 0; }

  # 1) Pigeonhole (Sieve motoru)
  if ! rpm -q dovecot-pigeonhole >/dev/null 2>&1; then
    act "dovecot-pigeonhole missing - installing (Sieve engine)"
    [ $DRY -eq 0 ] && { dnf -y install dovecot-pigeonhole >/dev/null 2>&1 || err "dovecot-pigeonhole could not be installed"; }
  else
    ok "dovecot-pigeonhole installed"
  fi

  # 1b) /var/vmail domain dizin sahipligi — root:root 0700 ise vmail traverse EDEMEZ
  # (sieve+teslim "Permission denied"). Site-tasima MkdirAll'i bunu yaratabiliyordu.
  if [ -d /var/vmail ]; then
    kotu=$(find /var/vmail -maxdepth 1 -type d ! -user vmail ! -path /var/vmail 2>/dev/null)
    if [ -n "$kotu" ]; then
      if [ $DRY -eq 1 ]; then act "root-owned /var/vmail domain directories will be handed to vmail ($(echo "$kotu"|wc -l) of them)"
      else echo "$kotu" | while read d; do [ -n "$d" ] && chown vmail:vmail "$d"; done; act "vmail domain directory ownership fixed ($(echo "$kotu"|wc -l) domains)"; fi
    else ok "/var/vmail domain directory ownership correct"; fi
  fi

  # 2) Sieve teslim yolu + forward envelope-from etkin mi (doveconf ile olc)
  local has_sieve has_env
  has_sieve=$(doveconf -a 2>/dev/null | awk '/^protocol lmtp/{p=1} p&&/mail_plugins/{print; exit}' | grep -c sieve)
  has_env=$(doveconf -a 2>/dev/null | grep -c "sieve_redirect_envelope_from = user_email")
  if [ "${has_sieve:-0}" -ge 1 ] && [ "${has_env:-0}" -ge 1 ]; then
    ok "sieve delivery path + forward envelope-from enabled"
    return 0
  fi

  act "writing the sieve delivery config (lmtp/lda sieve + envelope-from=user_email)"
  [ $DRY -eq 1 ] && return 0
  local SF=/etc/dovecot/conf.d/99-gosp-sieve.conf
  cat > "$SF" <<'SIEVEEOF'
# GirginOSPanel Mail - Sieve (forwarding/auto-reply) ENABLED in the delivery path. AUTOMATIC (repair).
# quota is kept via the GLOBAL $mail_plugins; only sieve is added here.
protocol lmtp {
  mail_plugins = $mail_plugins sieve
}
protocol lda {
  mail_plugins = $mail_plugins sieve
}
plugin {
  sieve = file:/var/vmail/%d/%n/.dovecot.sieve
  # Forward deliverability: envelope-from = the mailbox's own address (target SPF passes).
  sieve_redirect_envelope_from = user_email
}
SIEVEEOF
  if doveconf -n >/dev/null 2>&1; then
    systemctl restart dovecot >/dev/null 2>&1 && ok "dovecot restarted - forward + auto-reply active" || err "dovecot restart failed"
  else
    rm -f "$SF"; err "sieve config failed the doveconf test - rolled back"
  fi
}

