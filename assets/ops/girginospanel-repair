#!/usr/bin/env bash
# girginospanel-repair — dizin / sahiplik / izin / SELinux onarım aracı
# Idempotent + TAHRİBATSIZ: yalnızca chown/chmod/mkdir/restorecon/semanage yapar.
# Asla silmez, fuser çağırmaz, çalışan servisi bozmaz. Tekrar tekrar güvenle çalışır.
#
# Kullanım:
#   girginospanel-repair [--dry-run] [--deep] [--only <bölümler>] [--quiet]
#   bölümler (virgülle): phpmyadmin,domains,htpasswd,binary,clamav,frontend,signon,firewall  (varsayılan: hepsi)
#   --dry-run : değişiklikleri UYGULAMADAN neyin düzeltileceğini göster
#   --deep    : domain ev dizinlerinde RECURSIVE sahiplik onarımı (yavaş, büyük siteler)
#
#   girginospanel-repair restore [...]  → CORE DOSYA İÇERİK onarımı (0-byte frontend / bozuk
#     binary / eksik ops-tool) canonical release'ten atomik+doğrulanmış geri yükleme. secret/veri
#     KORUNUR. Ayrı girginospanel-restore aracına devreder (arg'lar aynen iletilir).
set -uo pipefail

# 🔴 AYRISTIRMA ICIN LC_ALL=C ZORUNLU — TURKCE LOCALE REGEX ARALIGINI BOZUYOR.
# Olculdu (31.56.47.190, LANG=tr_TR.UTF-8):
#     printf '@CT@ audit_log' | grep -oE '@CT@ [a-zA-Z0-9_]+'   ->  "@CT@ aud"
#     ayni komut LC_ALL=C ile                                    ->  "@CT@ audit_log"
# tr_TR collation'inda `a-z` araligi `i` harfini KAPSAMIYOR (noktasiz i/noktali i
# ayrimi), bu yuzden karakter araligi kullanan HER ayristirma `i` harfinde kesiliyor:
#   audit_log -> aud · cp_domains -> cp_doma · cp_websec_findings -> cp_websec_f
# Sonuc: sema kontrolu 22/46 gibi SAHTE bir kritik uretip musteri guncellemesini
# BLOKLADI. Turkiye bizim ana pazarimiz — bu her musteri sunucusunu etkiler.
# LC_ALL=C bayt semantigi verir; ASCII tanimlayici ayristirmak icin dogrusu budur.
export LC_ALL=C

# 'restore' ALT-KOMUTU: içerik onarımını ayrı araca devret. GERİYE UYUMLU — mevcut çağrılar
# (bare / --quiet / --dry-run / --deep / --only) DEĞİŞMEDEN izin/sahiplik/SELinux onarır; sadece
# ilk argüman tam olarak 'restore' ise devreye girer (install.sh'ın --quiet çağrısı etkilenmez).
if [ "${1:-}" = "restore" ]; then
  shift
  command -v girginospanel-restore >/dev/null 2>&1 && exec girginospanel-restore "$@"
  _rd="$(cd "$(dirname "$0")" 2>/dev/null && pwd)/girginospanel-restore"
  [ -x "$_rd" ] && exec "$_rd" "$@"
  echo "girginospanel-restore bulunamadı (core içerik onarım aracı kurulu değil)" >&2; exit 127
fi

DRY=0; DEEP=0; QUIET=0; ONLY="phpmyadmin,docroot_selinux,migrations,domains,htpasswd,binary,clamav,frontend,signon,firewall,nginx_cache"
while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run) DRY=1 ;;
    --deep)    DEEP=1 ;;
    --quiet)   QUIET=1 ;;
    --only)    shift; ONLY="$1" ;;
    -h|--help) sed -n '2,12p' "$0"; exit 0 ;;
    *) echo "bilinmeyen argüman: $1" >&2; exit 2 ;;
  esac; shift
done

CHK=0; FIXN=0; ERRN=0
c_g="\033[32m"; c_y="\033[33m"; c_r="\033[31m"; c_b="\033[34m"; c_0="\033[0m"
[ -t 1 ] || { c_g=; c_y=; c_r=; c_b=; c_0=; }
say()   { [ $QUIET -eq 1 ] || echo -e "$*"; }
head_() { say "\n${c_b}== $* ==${c_0}"; }
ok()    { CHK=$((CHK+1)); [ $QUIET -eq 1 ] || echo -e "  ${c_g}✓${c_0} $*"; }
act()   { CHK=$((CHK+1)); FIXN=$((FIXN+1)); echo -e "  ${c_y}$([ $DRY -eq 1 ] && echo '→ (dry) ' || echo '✔ DÜZELTİLDİ ')${c_0}$*"; }
warn()  { echo -e "  ${c_y}!${c_0} $*"; }
err()   { ERRN=$((ERRN+1)); echo -e "  ${c_r}✗${c_0} $*"; }

SEL=0; command -v getenforce >/dev/null 2>&1 && [ "$(getenforce)" != "Disabled" ] && SEL=1
HAVE_SEMANAGE=0; command -v semanage >/dev/null 2>&1 && HAVE_SEMANAGE=1

# ---- yardımcılar (hepsi idempotent + dry-run duyarlı) ----
ensure_owner() { # path  user:group  [recursive]
  local p=$1 o=$2 r=${3:-}; [ -e "$p" ] || return 0
  local cur; cur=$(stat -c '%U:%G' "$p" 2>/dev/null) || return 0
  if [ "$cur" != "$o" ]; then
    act "chown ${r:+-R }$o  $p  (şu an: $cur)"
    [ $DRY -eq 0 ] && chown $r "$o" "$p" 2>/dev/null || true
  else
    ok "sahiplik $o  $p"
  fi
}
ensure_mode() { # path  mode
  local p=$1 m=$2; [ -e "$p" ] || return 0
  local cur; cur=$(stat -c '%a' "$p" 2>/dev/null) || return 0
  # baştaki 0'ı normalize et
  if [ "$((8#$cur))" != "$((8#$m))" ]; then
    act "chmod $m  $p  (şu an: $cur)"
    [ $DRY -eq 0 ] && chmod "$m" "$p" 2>/dev/null || true
  else
    ok "izin $m  $p"
  fi
}
ensure_dir() { # path  mode  owner
  local p=$1 m=$2 o=$3
  if [ ! -d "$p" ]; then
    act "mkdir -p $p (mod $m, sahip $o)"
    [ $DRY -eq 0 ] && { mkdir -p "$p"; chmod "$m" "$p"; chown "$o" "$p"; }
  else
    ensure_mode "$p" "$m"; ensure_owner "$p" "$o"
  fi
}
# SELinux fcontext'i KALICI kaydet + uygula (restorecon-safe). semanage yoksa chcon fallback.
ensure_context() { # path  type  [recursive]
  [ $SEL -eq 1 ] || return 0
  local p=$1 t=$2 r=${3:-}
  [ -e "$p" ] || return 0
  if [ $HAVE_SEMANAGE -eq 1 ]; then
    local spec="${p}(/.*)?" _lst
    _lst=$(semanage fcontext -l 2>/dev/null)          # önce yakala (pipefail+grep -q SIGPIPE tuzağından kaçın)
    if ! grep -qF "${spec}" <<<"$_lst"; then
      act "semanage fcontext +$t  $spec  (kalıcı kural)"
      [ $DRY -eq 0 ] && semanage fcontext -a -t "$t" "$spec" 2>/dev/null || true
    fi
    if [ $DRY -eq 0 ]; then
      local n; n=$(restorecon -R${r:+} -v "$p" 2>/dev/null | wc -l)
      [ "${n:-0}" -gt 0 ] && act "restorecon $p  ($n bağlam düzeltildi)" || ok "SELinux bağlam $t  $p"
    else
      say "  → (dry) restorecon -R $p"
    fi
  else
    local cur; cur=$(stat -c '%C' "$p" 2>/dev/null | cut -d: -f3)
    if [ "$cur" != "$t" ]; then
      act "chcon -t $t  $p  (semanage yok — geçici)"
      [ $DRY -eq 0 ] && chcon ${r:+-R} -t "$t" "$p" 2>/dev/null || true
    else
      ok "SELinux bağlam $t  $p"
    fi
  fi
}
want() { echo ",$ONLY," | grep -q ",$1,"; }

# ================= BÖLÜMLER =================
sec_phpmyadmin() {
  want phpmyadmin || return 0
  head_ "phpMyAdmin"
  local PMA=/opt/phpmyadmin
  [ -d "$PMA" ] || { warn "$PMA yok, atlanıyor"; return 0; }
  local PG; PG=$(awk -F= '/^[[:space:]]*group/{gsub(/ /,"",$2);print $2}' /etc/php-fpm.d/phpmyadmin.conf 2>/dev/null); PG=${PG:-apache}
  ensure_context "$PMA" httpd_sys_content_t -R
  if [ -f "$PMA/config.inc.php" ]; then
    # pool kullanıcısı (apache) okuyabilmeli; secret içerdiği için world-readable OLMAMALI
    ensure_owner "$PMA/config.inc.php" "root:$PG"
    ensure_mode  "$PMA/config.inc.php" 640
    if ! runuser -u "$PG" -- test -r "$PMA/config.inc.php" 2>/dev/null; then
      err "config.inc.php $PG tarafından HÂLÂ okunamıyor!"
    else
      ok "config.inc.php $PG tarafından okunabilir"
    fi
  else
    warn "config.inc.php yok"
  fi
  # TempDir + sessions: php-fpm (apache) yazabilmeli
  ensure_dir "/var/lib/phpmyadmin"          755 "$PG:$PG"
  ensure_dir "/var/lib/phpmyadmin/tmp"      755 "$PG:$PG"
  ensure_dir "/var/lib/phpmyadmin/sessions" 700 "$PG:$PG"
  ensure_context "/var/lib/phpmyadmin" httpd_sys_rw_content_t -R
}

sec_signon() {
  want signon || return 0
  head_ "pma-signon"
  local S=/opt/girginospanel/pma-signon
  [ -d "$S" ] || { warn "$S yok"; return 0; }
  ensure_context "$S" httpd_sys_content_t -R
}

sec_firewall() {
  want firewall || return 0
  head_ "firewall (firewalld → panel devralır)"
  # Panel firewall'ı kendi nftables tablosunu (girginos_fw) yönetir. AlmaLinux
  # varsayılan firewalld ile ÇAKIŞIR: nftables'ta bir tablonun base chain'inde
  # 'drop' KESİNDİR → firewalld panelin portlarını (8443/80/443/53/21) düşürür,
  # panelin 'accept' politikası bunu EZEMEZ → panel UI erişilemez, siteler açılmaz.
  # Tek otorite panel olsun diye firewalld'yi durdur+kapat+mask ediyoruz.
  # firewalld durunca kendi nft tablosunu ANINDA temizler → reboot GEREKMEZ.
  if ! systemctl cat firewalld.service >/dev/null 2>&1; then
    ok "firewalld kurulu değil — panel nftables zaten tek firewall"
    return 0
  fi
  if [ "$(systemctl is-enabled firewalld 2>/dev/null)" = "masked" ]; then
    ok "firewalld zaten mask'li (panel devralmış)"
    return 0
  fi
  act "firewalld aktif/etkin → durdur + mask (panel devralır)"
  if [ $DRY -eq 0 ]; then
    systemctl disable --now firewalld >/dev/null 2>&1 || true
    systemctl mask firewalld >/dev/null 2>&1 || true
  fi
}

sec_frontend() {
  want frontend || return 0
  head_ "frontend-dist"
  local F=/opt/girginospanel/frontend-dist
  [ -d "$F" ] || { warn "$F yok"; return 0; }
  ensure_owner "$F" "root:root"
  ensure_context "$F" httpd_sys_content_t -R
}

sec_binary() {
  want binary || return 0
  head_ "sunucu binary"
  local B=/opt/girginospanel/bin/girginospanel-server
  [ -f "$B" ] || { warn "$B yok"; return 0; }
  ensure_mode "$B" 755
  # systemd exec bağlamı (203/EXEC hatası buradan) — restorecon varsayılana döndürür
  if [ $SEL -eq 1 ] && [ $DRY -eq 0 ]; then
    local n; n=$(restorecon -v "$B" 2>/dev/null | wc -l)
    [ "${n:-0}" -gt 0 ] && act "restorecon $B (exec bağlamı düzeltildi)" || ok "SELinux exec bağlamı OK  $B"
  fi
}

sec_htpasswd() {
  want htpasswd || return 0
  head_ "nginx htpasswd (şifre korumalı dizinler)"
  local D=/etc/nginx/htpasswd
  [ -d "$D" ] || { ok "htpasswd dizini yok (koruma tanımlı değil)"; return 0; }
  ensure_mode "$D" 755
  local f
  for f in "$D"/*; do
    [ -f "$f" ] || continue
    ensure_mode "$f" 644
  done
  ensure_context "$D" httpd_config_t -R   # /etc/nginx fcontext → nginx okuyabilir
}

sec_clamav() {
  want clamav || return 0
  head_ "ClamAV imza veritabanı"
  local C=/var/lib/clamav
  [ -d "$C" ] || { ok "clamav yok"; return 0; }
  local OWN; OWN=$(getent passwd 992 | cut -d: -f1); OWN=${OWN:-clamupdate}
  # freshclam bu dizine yazamazsa imza güncellenemez
  ensure_owner "$C" "$OWN:$OWN" -R
  ensure_mode  "$C" 755
}

# ---- veritabani gocleri (schema drift) ----
# 🔴 GERCEK ARIZA: panel gocleri /opt/girginospanel/src/migrations dizininden
# okur. Yayin sirasinda YALNIZ ikili guncellenip bu dizin senkronlanmazsa yeni
# .sql dosyalari sunucuya HIC gelmez; kolonlar eksik kalir ve sayfalar
# "Unknown column ..." ile coker (orn. Bayi Planlari / reseller_plans.mail_*).
# Burada kaynak dizin ile calisan dizin karsilastirilir, eksikler kopyalanir.
sec_migrations() {
  want migrations || return 0
  head_ "veritabani gocleri (schema drift)"

  local RUN=/opt/girginospanel/src/migrations
  local SRC=""
  local aday
  for aday in /opt/girginospanel/src/migrations /root/gpanel-temiz/migrations /opt/girginospanel/migrations; do
    [ -d "$aday" ] && [ "$aday" != "$RUN" ] && SRC="$aday" && break
  done

  if [ ! -d "$RUN" ]; then
    err "goc dizini yok: $RUN"
    return 0
  fi

  # 1) Kaynak dizin varsa eksik dosyalari tasi
  if [ -n "$SRC" ]; then
    local eksik=0 f
    for f in "$SRC"/*.sql; do
      [ -e "$f" ] || continue
      if [ ! -f "$RUN/$(basename "$f")" ]; then
        eksik=$((eksik+1))
        act "eksik goc kopyalaniyor: $(basename "$f")"
        [ $DRY -eq 0 ] && cp -n "$f" "$RUN/"
      fi
    done
    [ "$eksik" -eq 0 ] && ok "goc dosyalari guncel ($SRC -> $RUN)"
  else
    ok "ayri kaynak goc dizini yok — yalniz $RUN kullaniliyor"
  fi

  # 2) Defterde olmayan (hic kosmamis) goc var mi?
  if command -v mysql >/dev/null 2>&1; then
    local bekleyen=0 dosya ad
    while IFS= read -r dosya; do
      ad=$(basename "$dosya")
      if ! mysql -N panel -e "SELECT 1 FROM schema_migrations WHERE dosya='$ad'" 2>/dev/null | grep -q 1; then
        bekleyen=$((bekleyen+1))
        warn "defterde yok (acilista kosacak): $ad"
      fi
    done < <(ls "$RUN"/*.sql 2>/dev/null)
    if [ "$bekleyen" -gt 0 ]; then
      act "$bekleyen bekleyen goc var -> panel yeniden baslatiliyor (gocler acilista kosar)"
      [ $DRY -eq 0 ] && systemctl restart girginospanel && sleep 6
    else
      ok "tum gocler defterde kayitli"
    fi

    # 3) Bilinen kritik kolonlar gercekten var mi? (goc kostu ama sessiz basarisiz olabilir)
    local kayip=0
    kolon_var() { # tablo kolon
      mysql -N panel -e "SHOW COLUMNS FROM $1 LIKE '$2'" 2>/dev/null | grep -q "$2"
    }
    for ck in "reseller_plans:mail_max_email" "reseller_plans:mail_saatlik_limit" \
              "reseller_plans:mail_kutu_kota_mb" "cp_eklenti_lisans:uyari"; do
      local t="${ck%%:*}" k="${ck##*:}"
      mysql -N panel -e "SELECT 1 FROM information_schema.TABLES WHERE TABLE_SCHEMA='panel' AND TABLE_NAME='$t'" 2>/dev/null | grep -q 1 || continue
      if kolon_var "$t" "$k"; then :; else kayip=$((kayip+1)); err "EKSIK KOLON: $t.$k — ilgili goc kosmamis"; fi
    done
    [ "$kayip" -eq 0 ] && ok "kritik sema kolonlari yerinde"
  else
    warn "mysql istemcisi yok — defter/kolon kontrolu atlandi"
  fi
}

sec_domains() {
  want domains || return 0
  head_ "domain ev dizinleri (/home/c_*)"
  local home sk
  for home in /home/c_*; do
    [ -d "$home" ] || continue
    sk=$(basename "$home")
    if ! getent passwd "$sk" >/dev/null; then warn "$sk: sistem kullanıcısı yok, atlanıyor"; continue; fi
    ensure_owner "$home" "$sk:$sk"
    ensure_mode  "$home" 711
    # ÖNEMLİ: .karantina root'a ait KALMALI (müşteri zararlıya erişmesin) → hariç tut
    local child bn
    while IFS= read -r child; do
      [ -z "$child" ] && continue
      bn=$(basename "$child")
      [ "$bn" = ".karantina" ] && continue
      ensure_owner "$child" "$sk:$sk" -R
    done < <(find "$home" -maxdepth 1 -mindepth 1 ! -user "$sk" 2>/dev/null)
    [ -d "$home/public_html" ] && ensure_mode "$home/public_html" 755
    [ -d "$home/.ssh" ]        && ensure_mode "$home/.ssh" 700
    # karantina: root-owned + kilitli
    if [ -d "$home/.karantina" ]; then ensure_owner "$home/.karantina" "root:root"; ensure_mode "$home/.karantina" 700; fi
    if [ $DEEP -eq 1 ]; then
      local n; n=$(find "$home" -path "$home/.karantina" -prune -o ! -user "$sk" -print 2>/dev/null | wc -l)
      if [ "${n:-0}" -gt 0 ]; then
        act "DEEP chown -R $sk:$sk $home ($n yanlış-sahipli dosya, .karantina hariç)"
        [ $DRY -eq 0 ] && find "$home" -path "$home/.karantina" -prune -o ! -user "$sk" -exec chown "$sk:$sk" {} + 2>/dev/null
      fi
    fi
    [ $SEL -eq 1 ] && [ $DRY -eq 0 ] && restorecon -R "$home" >/dev/null 2>&1
  done
}

sec_docroot_selinux() {
  want docroot_selinux || return 0
  head_ "kiracı belge kökü SELinux (WordPress yazma)"
  if [ $SEL -ne 1 ]; then ok "SELinux kapalı — bu bölüm gereksiz"; return 0; fi

  # 🔴 RHEL/AlmaLinux'un varsayılan kuralı:
  #     /home/*/public_html(/.+)?  →  httpd_user_content_t   (SALT-OKUNUR)
  # Enforcing modda PHP siteye YAZAMAZ. WordPress bunu görünce "FTP
  # bilgileri" formu açar; eklenti/tema/güncelleme kurulamaz. Belirti
  # sinsidir: AVC kaydı bile düşmez (is_writable → access() denetimleri
  # dontaudit'li), log'a bakan sebebi bulamaz.
  local n=0 duzeltilen=0
  # public_html + tmp: ikisi de PHP tarafindan YAZILIR olmali.
  # tmp varsayilan olarak user_tmp_t etiketlidir ve httpd domaini
  # oraya yazamaz -> WordPress eklenti indiremez ("Permission denied").
  for d in /home/c_*/public_html /home/c_*/tmp; do
    [ -d "$d" ] || continue
    n=$((n+1))
    local mevcut; mevcut=$(ls -Zd "$d" 2>/dev/null | awk '{print $1}')
    case "$mevcut" in
      *httpd_user_rw_content_t*) continue ;;   # zaten doğru
    esac
    act "SELinux yazılabilir etiket  $d  (şu an: ${mevcut##*:object_r:})"
    if [ $DRY -eq 0 ]; then
      if [ $HAVE_SEMANAGE -eq 1 ]; then
        semanage fcontext -a -t httpd_user_rw_content_t "${d}(/.*)?" 2>/dev/null \
          || semanage fcontext -m -t httpd_user_rw_content_t "${d}(/.*)?" 2>/dev/null || true
      fi
      # 🔴 -F ŞART: kural yeni eklendiğinde `restorecon -R` mevcut etiketi
      # değiştirmeyebiliyor (canlıda birebir yaşandı).
      restorecon -RF "$d" >/dev/null 2>&1 || true
      local sonra; sonra=$(ls -Zd "$d" 2>/dev/null | awk '{print $1}')
      case "$sonra" in
        *httpd_user_rw_content_t*) duzeltilen=$((duzeltilen+1)) ;;
        *) err "etiket değişmedi: $d (şu an ${sonra##*:object_r:})" ;;
      esac
    fi
  done
  if [ "$n" -eq 0 ]; then ok "kiracı dizini yok"
  elif [ $DRY -eq 1 ]; then say "  → (dry) $n dizin taranacak (belge kökü + tmp)"
  else ok "$n dizinden $duzeltilen tanesi yazılabilir etikete geçirildi"; fi
}

sec_nginx_cache() {
  want nginx_cache || return 0
  head_ "nginx onbellek dizini (fastcgi_cache)"
  # 🔴 /var/cache/nginx RPM tarafindan 0700 root:root birakiliyor.
  # Alt dizin (girgincache) dogru sahiplenmis olsa BILE nginx worker ust
  # dizini TRAVERSE edemiyor ve cache loader sunu veriyor:
  #   [crit] opendir() "/var/cache/nginx/girgincache" failed (13: Permission denied)
  # Belirti sinsi: nginx AYAKTA kalir, hicbir vhost patlamaz, hicbir istek
  # hata vermez -- yalnizca sayfa onbellegi SESSIZCE devre disi kalir.
  # Mevcut sunucular installer duzeltmesini almayacagi icin onarim burada.
  [ -d /var/cache/nginx ] || { ok "/var/cache/nginx yok - onbellek yapilandirilmamis"; return 0; }
  # 🔴 HAM STRING KARSILASTIRMASI YANLIS: setgid/sticky bitli mesru bir dizinde
  # (2755, 1755) `stat -c%a` "2755" doner, "755" ile esitlenmez ve `chmod 0755`
  # GNU coreutils'te dizinde setgid'i TEMIZLEMEZ -> her kosuda "DUZELTILDI"
  # yalani + hemen ardindan "✗ izin degismedi" + KALICI exit 1. Yalnizca ALT
  # 9 BITE bakiyoruz (ensure_mode zaten boyle yapiyor).
  local izin; izin=$(stat -c%a /var/cache/nginx 2>/dev/null)
  local izin9=$(( 8#${izin:-0} & 0777 ))
  if [ "$izin9" = "$(( 8#755 ))" ]; then
    ok "/var/cache/nginx izni dogru (755)"
  else
    act "chmod 0755 /var/cache/nginx  (su an: $izin)"
    if [ $DRY -eq 0 ]; then
      # u+rwx,go+rx yuksek bitlere (setgid/sticky) DOKUNMAZ.
      chmod u+rwx,go+rx,go-w /var/cache/nginx 2>/dev/null
      chown root:root /var/cache/nginx 2>/dev/null
      # SONUCU DOGRULA: chmod sessizce basarisiz olabilir (immutable bayrak,
      # salt-okunur fs). "calistirdim" ile "oldu" ayni sey degil.
      local y; y=$(stat -c%a /var/cache/nginx 2>/dev/null)
      if [ "$(( 8#${y:-0} & 0777 ))" = "$(( 8#755 ))" ]; then
        ok "izin $izin -> 755 (nginx artik traverse edebiliyor)"
      else
        err "izin degismedi (hala $y)"
        return 0
      fi
    fi
  fi
  # Onbellek alt dizini nginx e ait olmali
  local CD=/var/cache/nginx/girgincache
  if [ -d "$CD" ]; then
    local sah; sah=$(stat -c%U "$CD" 2>/dev/null)
    if [ "$sah" != "nginx" ]; then
      act "chown nginx:nginx $CD  (su an: $sah)"
      [ $DRY -eq 0 ] && { chown -R nginx:nginx "$CD" 2>/dev/null || err "$CD sahiplenemedi"; }
    else
      ok "$CD sahibi dogru (nginx)"
    fi
  fi
  # Gercekten acilabiliyor mu -- URETIM kullanicisiyla, izin bitine bakarak degil.
  if [ $DRY -eq 0 ] && [ -d "$CD" ] && command -v runuser >/dev/null 2>&1; then
    if runuser -u nginx -- test -r "$CD" 2>/dev/null; then
      ok "nginx kullanicisi onbellek dizinini GERCEKTEN okuyabiliyor"
    else
      err "nginx kullanicisi $CD i hala okuyamiyor"
    fi
  fi
}

