#!/usr/bin/env bash
# girginospanel-sir — panel sırlarının kalıcı düzeni + gizli dosya izinleri.
#
#   girginospanel-sir birim [--denetle]   panel birimini LoadCredential'a geçirir
#                                          (sırlar süreç ortamına girmez); --denetle: yalnız ölç
#   girginospanel-sir birim-geri          son birim yedeğini geri koyar (güncelleme geri alma)
#   girginospanel-sir izin [--onar] [--kuru]
#                                          gizli dosya envanteri: sahip/izin denetimi;
#                                          --onar fazla izni SOYAR / sahipliği düzeltir
#
# Sır DEĞERİ okumaz/yazdırmaz; yalnız ad, sahip, izin.
#
# Çıkış (birim): 0 geçirildi · 3 zaten geçirilmiş · 1 geçirilemedi (birime DOKUNULMADI)
#        (birim --denetle): 0 kimlikli · 1 eski (EnvironmentFile)
#        (izin): 0 temiz · 1 KRİTİK kaldı
set -uo pipefail
export LC_ALL=C

SIR_KOK=${SIR_KOK:-}                                   # test: tüm yolların öneki
SIR_BIRIM=${SIR_BIRIM:-$SIR_KOK/etc/systemd/system/girginospanel.service}
SIR_ENV=${SIR_ENV:-/etc/girginospanel/env}             # birim satırına yazılan GERÇEK yol
SIR_ENV_DOSYA=${SIR_ENV_DOSYA:-$SIR_KOK$SIR_ENV}       # denetlenen dosya
SIR_YEDEK_DIZIN=${SIR_YEDEK_DIZIN:-$SIR_KOK/var/lib/girginospanel/birim-yedek}
SIR_DAEMON_RELOAD=${SIR_DAEMON_RELOAD:-systemctl daemon-reload}
SIR_KIMLIK_SATIRI="LoadCredential=panel-env:$SIR_ENV"

sir_systemd_surum() {
  if [ -n "${SIR_SYSTEMD_SURUM:-}" ]; then echo "$SIR_SYSTEMD_SURUM"; return; fi
  systemctl --version 2>/dev/null | awk 'NR==1{print $2+0}'
}

# sir_birim_durum <birim> → "kimlik" | "eski" | "yok"
sir_birim_durum() {
  local b=$1
  [ -f "$b" ] || { echo yok; return; }
  local kimlik envf
  kimlik=$(awk -v h="LoadCredential=panel-env:$SIR_ENV" '{s=$0; gsub(/^[ \t]+|[ \t]+$/,"",s); if (s==h) {print 1; exit}}' "$b")
  envf=$(awk -v e="$SIR_ENV" '{s=$0; gsub(/^[ \t]+|[ \t]+$/,"",s); if (s=="EnvironmentFile=" e || s=="EnvironmentFile=-" e) {print 1; exit}}' "$b")
  kimlik=${kimlik:-0}; envf=${envf:-0}
  if [ $kimlik = 1 ] && [ $envf = 0 ]; then echo kimlik; else echo eski; fi
}

# sir_birim_gecis: EnvironmentFile=<env> satırını LoadCredential ile değiştirir.
# Önkoşul düşerse birime HİÇ dokunmaz (eski birimle panel çalışmaya devam eder).
sir_birim_gecis() {
  local b=$SIR_BIRIM durum
  durum=$(sir_birim_durum "$b")
  case "$durum" in
    kimlik) echo "  ✓ birim zaten LoadCredential ile (sırlar ortama girmiyor)"; return 3 ;;
    yok)    echo "  ✗ birim yok: $b"; return 1 ;;
  esac
  if [ -L "$b" ]; then echo "  ✗ birim symlink — dokunulmadı: $b"; return 1; fi
  local sv; sv=$(sir_systemd_surum)
  case "$sv" in ''|*[!0-9]*) sv=0 ;; esac
  if [ "$sv" -lt 247 ]; then
    echo "  ✗ systemd $sv < 247 (LoadCredential yok) — birim ESKİ kaldı; sırlar config.Load sonrası ortamdan silinir (1. katman)"
    return 1
  fi
  # LoadCredential kaynağı yoksa servis 243/CREDENTIALS ile AÇILMAZ → önce doğrula.
  if [ -L "$SIR_ENV_DOSYA" ] || [ ! -f "$SIR_ENV_DOSYA" ] || [ ! -s "$SIR_ENV_DOSYA" ]; then
    echo "  ✗ $SIR_ENV_DOSYA yok/boş/symlink — birim değiştirilmedi"
    return 1
  fi
  if ! grep -qE '^[[:space:]]*PANEL_JWT_SECRET=.{32,}' "$SIR_ENV_DOSYA"; then
    echo "  ✗ $SIR_ENV_DOSYA içinde geçerli PANEL_JWT_SECRET yok — birim değiştirilmedi"
    return 1
  fi
  mkdir -p "$SIR_YEDEK_DIZIN" && chmod 700 "$SIR_YEDEK_DIZIN" || { echo "  ✗ yedek dizini yok: $SIR_YEDEK_DIZIN"; return 1; }
  local ts yedek gecici
  ts=$(date +%Y%m%d%H%M%S)
  yedek="$SIR_YEDEK_DIZIN/girginospanel.service.$ts"
  cp -p "$b" "$yedek" || { echo "  ✗ birim yedeklenemedi — dokunulmadı"; return 1; }
  printf '%s\n' "$yedek" > "$SIR_YEDEK_DIZIN/son" || { echo "  ✗ yedek işareti yazılamadı — dokunulmadı"; return 1; }
  gecici=$(mktemp "$(dirname "$b")/.girginospanel.service.XXXXXX") || { echo "  ✗ geçici dosya yok"; return 1; }
  # EnvironmentFile=<env> (ya da =-<env>) → kimlik satırı; satır yoksa [Service] altına ekle.
  awk -v env="$SIR_ENV" -v yeni="$SIR_KIMLIK_SATIRI" '
    BEGIN { yapildi = 0 }
    {
      s = $0; gsub(/^[ \t]+|[ \t]+$/, "", s)
      if (s == "EnvironmentFile=" env || s == "EnvironmentFile=-" env) {
        if (!yapildi) { print yeni; yapildi = 1 }
        next
      }
      print
    }
    END { if (!yapildi) exit 7 }
  ' "$b" > "$gecici"
  local rc=$?
  if [ $rc = 7 ]; then
    awk -v yeni="$SIR_KIMLIK_SATIRI" '{ print } /^[ \t]*\[Service\][ \t]*$/ && !y { print yeni; y = 1 }' "$b" > "$gecici"
    rc=0
  fi
  if [ $rc != 0 ] || ! grep -qxF "$SIR_KIMLIK_SATIRI" "$gecici"; then
    rm -f "$gecici"; echo "  ✗ birim dönüştürülemedi — dokunulmadı"; return 1
  fi
  chmod 644 "$gecici"; chown root:root "$gecici" 2>/dev/null || true
  mv -f "$gecici" "$b" || { rm -f "$gecici"; echo "  ✗ birim yazılamadı — dokunulmadı"; return 1; }
  command -v restorecon >/dev/null 2>&1 && [ -z "$SIR_KOK" ] && restorecon "$b" >/dev/null 2>&1
  if ! $SIR_DAEMON_RELOAD >/dev/null 2>&1; then
    cp -p "$yedek" "$b"; $SIR_DAEMON_RELOAD >/dev/null 2>&1
    echo "  ✗ daemon-reload başarısız — eski birim geri kondu"; return 1
  fi
  echo "  ✓ birim LoadCredential'a geçirildi (yedek: $yedek) — panel restart'ında etkin"
  return 0
}

# sir_birim_geri: sir_birim_gecis'in son yedeğini geri koyar (+ daemon-reload).
sir_birim_geri() {
  local yedek
  yedek=$(cat "$SIR_YEDEK_DIZIN/son" 2>/dev/null)
  if [ -z "$yedek" ] || [ ! -f "$yedek" ]; then echo "  ✗ birim yedeği yok"; return 1; fi
  cp -p "$yedek" "$SIR_BIRIM" || { echo "  ✗ birim geri konamadı"; return 1; }
  $SIR_DAEMON_RELOAD >/dev/null 2>&1
  rm -f "$SIR_YEDEK_DIZIN/son"
  echo "  ✓ eski birim geri kondu ($yedek)"
  return 0
}

# ── Gizli dosya envanteri ──────────────────────────────────────────────
# yol(glob olabilir) | tür f/d | sahip | izinli gruplar (virgüllü; ilki onarım hedefi) | en çok mod | not
# Mod kuralı: (mevcut & ~enÇok) != 0 → KRİTİK (fazla izin); onarım fazlayı soyar.
SIR_ENVANTER='
/etc/girginospanel/env|f|root|root|600|panel JWT/DB/Redis sırları (LoadCredential kaynağı)
/etc/girginospanel/env.*|f|root|root|600|env yedekleri (port-swap) — eski sırlar
/etc/girginospanel/.sir-yenile-bekleyen|f|root|root|600|yarım sır yenileme (eski+yeni değerler)
/etc/girginospanel/db.key|f|root|root|600|at-rest şifreleme anahtarı
/etc/girginospanel/proxy.secret|f|root|root|600|X-Gosp-Proxy gizlisi
/etc/girginospanel/eklenti-*.key|f|root|root|600|eklenti anahtarları
/etc/girginospanel/eklenti-*.env|f|root|root|600|eklenti ortamları (DSN/webmail parolaları)
/etc/girginospanel/pma-internal.token|f|root|apache,root|640|phpMyAdmin signon jetonu (apache okur)
/etc/girginospanel/kurulum-kimlik|f|root|root,apache|640|lisans parmak izi (webmail apache okur)
/etc/ssl/girginospanel/*.key*|f|root|root|600|panel TLS özel anahtarı + yedekleri
/etc/pki/girginospanel/*/*.key|f|root|root|600|alan adı TLS özel anahtarları
/etc/pki/mail/*.key*|f|root|root|600|posta TLS özel anahtarı
/etc/nginx/conf.d/_panel.conf|f|root|nginx,root|640|panel vhost (proxy gizlisi içerir)
/etc/nginx/conf.d/_panel.conf.*|f|root|root,nginx|640|panel vhost yedekleri (proxy gizlisi)
/var/lib/girginospanel/acme|d|root|root|700|ACME hesap anahtarları
/var/lib/girginospanel/eklenti-anahtar|d|root|root|700|eklenti anahtar deposu
/var/lib/girginospanel/tasima|d|root|root|700|taşıma SSH anahtarı
/var/lib/girginospanel/tasima-yedek|d|root|root|700|taşıma yedekleri
/var/lib/girginospanel/birim-yedek|d|root|root|700|birim yedekleri
/var/backups/girginospanel/db|d|root|root|700|panel DB dökümleri
/var/backups/girginospanel-sistem|d|root|root|700|sistem yedeği (env + tüm DB)
/root/.acme.sh|d|root|root|700|acme.sh hesap/DNS API anahtarları
/etc/pure-ftpd/.pfsql_pass|f|root|root|600|pure-ftpd DB parolası
/etc/pure-ftpd/pureftpd-mysql.conf|f|root|root|640|pure-ftpd DB parolası
/etc/valkey/users.acl|f|valkey|valkey,root|640|Valkey ACL (parola özetleri)
/etc/postfix/mysql-*.cf|f|root|postfix|640|postfix DB parolası
/etc/dovecot/dovecot-sql.conf.ext|f|root|root,dovecot|640|dovecot DB parolası
/etc/dovecot/dovecot-sql.conf.ext.*|f|root|root|600|dovecot SQL yedekleri
/opt/phpmyadmin/config.inc.php|f|root|apache|640|phpMyAdmin blowfish/kontrol kullanıcısı
/etc/roundcubemail/config.inc.php|f|root|apache|640|webmail DB parolası / des_key
/etc/opendkim/keys|d|opendkim|opendkim|750|DKIM özel anahtarları
/root/.ssh/id_*|f|root|root|600|root SSH özel anahtarı
'

SIR_KRITIK=0; SIR_ONARILAN=0
sir_kritik() { SIR_KRITIK=$((SIR_KRITIK+1)); echo "  KRİTİK $*"; }

# sir_izin_tek <yol> <tür> <sahip> <gruplar> <enÇok> <onar 0/1> <kuru 0/1> <not>
sir_izin_tek() {
  local p=$1 tur=$2 sahip=$3 gruplar=$4 enCok=$5 onar=$6 kuru=$7 notu=$8
  if [ -L "$p" ]; then
    sir_kritik "$p: symlink — gizli dosya symlink OLMAMALI (takip edilmedi, elle inceleyin) [$notu]"
    return
  fi
  case "$tur" in
    f) [ -f "$p" ] || return 0 ;;
    d) [ -d "$p" ] || return 0 ;;
  esac
  local m u g fazla sorun="" hedefMod hedefGrup
  m=$(stat -c '%a' -- "$p" 2>/dev/null) || return 0      # stat -L'siz = lstat
  u=$(stat -c '%U' -- "$p" 2>/dev/null)
  g=$(stat -c '%G' -- "$p" 2>/dev/null)
  fazla=$(( 8#$m & ~8#$enCok & 07777 ))
  [ "$fazla" -ne 0 ] && sorun="fazla izin $m (en çok $enCok)"
  [ "$u" != "$sahip" ] && sorun="${sorun:+$sorun, }sahip $u (beklenen $sahip)"
  case ",$gruplar," in *",$g,"*) ;; *) sorun="${sorun:+$sorun, }grup $g (izinli: $gruplar)" ;; esac
  [ -z "$sorun" ] && return 0
  if [ "$onar" = 1 ]; then
    if [ "$kuru" = 1 ]; then
      echo "  → (kuru) onarılacak: $p — $sorun"
      SIR_KRITIK=$((SIR_KRITIK+1)); return
    fi
    hedefMod=$(printf '%o' $(( 8#$m & 8#$enCok & 07777 )))
    hedefGrup=$g
    case ",$gruplar," in *",$g,"*) ;; *) hedefGrup=${gruplar%%,*} ;; esac
    local tamam=1
    # Sahiplik ÖNCE: chown setuid/setgid'i temizler; mod sonra kesinleşir.
    if [ "$u" != "$sahip" ] || [ "$g" != "$hedefGrup" ]; then
      if id -u "$sahip" >/dev/null 2>&1 && getent group "$hedefGrup" >/dev/null 2>&1; then
        chown -h -- "$sahip:$hedefGrup" "$p" 2>/dev/null || tamam=0
      else
        tamam=0
      fi
    fi
    [ -L "$p" ] && { sir_kritik "$p: işlem sırasında symlink oldu — durduruldu"; return; }
    chmod -- "$hedefMod" "$p" 2>/dev/null || tamam=0
    if [ $tamam = 1 ]; then
      SIR_ONARILAN=$((SIR_ONARILAN+1))
      echo "  ✔ onarıldı: $p — $sorun → $(stat -c '%a %U:%G' -- "$p")"
    else
      sir_kritik "$p: $sorun — ONARILAMADI [$notu]"
    fi
    return
  fi
  sir_kritik "$p: $sorun [$notu]"
}

# sir_valkey_umask: Valkey ACL SAVE users.acl'i kendi umask'ıyla (0022 → 0644)
# yeniden yazar; onarılan izin bir sonraki SAVE'de geri gelirdi. Kalıcı: UMask=0027.
sir_valkey_umask() {
  local onar=$1 kuru=$2 d="$SIR_KOK/etc/systemd/system/valkey.service.d" f
  f="$d/50-gosp-umask.conf"
  [ -f "$SIR_KOK/usr/lib/systemd/system/valkey.service" ] || [ -f "$SIR_KOK/etc/systemd/system/valkey.service" ] || return 0
  grep -qs '^UMask=0027' "$f" && return 0
  if [ "$onar" != 1 ]; then
    echo "  ! valkey UMask drop-in yok — ACL SAVE users.acl'i 0644 yazar (onar: girginospanel-sir izin --onar)"
    return 0
  fi
  [ "$kuru" = 1 ] && { echo "  → (kuru) $f yazılacak (UMask=0027)"; return 0; }
  mkdir -p "$d" && printf '[Service]\n# girginospanel-sir: ACL SAVE users.acl dosyasını 0640 yazsın (parola özetleri)\nUMask=0027\n' > "$f" \
    && { [ -n "$SIR_KOK" ] || systemctl daemon-reload >/dev/null 2>&1; echo "  ✔ valkey UMask=0027 drop-in (sonraki valkey restart'ında etkin)"; }
}

sir_izin() {
  local onar=0 kuru=0
  while [ $# -gt 0 ]; do
    case "$1" in --onar) onar=1 ;; --kuru) kuru=1 ;; *) echo "bilinmeyen: $1" >&2; return 2 ;; esac; shift
  done
  SIR_KRITIK=0; SIR_ONARILAN=0
  local satir yol tur sahip gruplar enCok notu p top=0
  while IFS= read -r satir; do
    [ -z "$satir" ] && continue
    IFS='|' read -r yol tur sahip gruplar enCok notu <<<"$satir"
    for p in $SIR_KOK$yol; do
      [ -e "$p" ] || [ -L "$p" ] || continue
      case "$p" in *.pub) continue ;; esac
      top=$((top+1))
      sir_izin_tek "$p" "$tur" "$sahip" "$gruplar" "$enCok" "$onar" "$kuru" "$notu"
    done
  done <<<"$SIR_ENVANTER"
  sir_valkey_umask "$onar" "$kuru"
  if [ "$SIR_KRITIK" -eq 0 ]; then
    if [ "$SIR_ONARILAN" -gt 0 ]; then echo "  ✓ gizli dosyalar: $top denetlendi, $SIR_ONARILAN onarıldı, sorun kalmadı"; else echo "  ✓ gizli dosyalar: $top denetlendi, sorun yok"; fi
    return 0
  fi
  echo "  ✗ gizli dosyalar: $top denetlendi, $SIR_KRITIK KRİTİK"
  return 1
}

# Test kancası: GOSP_SIR_KUTUPHANE=1 ile source edilince yalnız fonksiyonlar yüklenir.
if [ "${GOSP_SIR_KUTUPHANE:-0}" = 1 ]; then return 0 2>/dev/null || exit 0; fi

[ "$(id -u)" = 0 ] || { echo "root gerekli" >&2; exit 2; }
komut=${1:-}; [ $# -gt 0 ] && shift
case "$komut" in
  birim)
    if [ "${1:-}" = "--denetle" ]; then
      d=$(sir_birim_durum "$SIR_BIRIM"); echo "birim: $d"
      [ "$d" = kimlik ]; exit $?
    fi
    sir_birim_gecis; exit $? ;;
  birim-geri) sir_birim_geri; exit $? ;;
  izin) sir_izin "$@"; exit $? ;;
  *) sed -n '2,16p' "$0"; exit 2 ;;
esac
