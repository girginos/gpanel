#!/usr/bin/env bash
# girginospanel-sir — panel sırlarının kalıcı düzeni + gizli dosya izinleri.
#
#   girginospanel-sir birim [--denetle]   panel birimini LoadCredential'a geçirir
#                                          (sırlar süreç ortamına girmez); --denetle: yalnız ölç
#   girginospanel-sir birim-geri          son birim yedeğini geri koyar (güncelleme geri alma)
#   girginospanel-sir izin [--onar] [--kuru]
#                                          gizli dosya envanteri: sahip/izin denetimi;
#                                          --onar fazla izni SOYAR / sahipliği düzeltir
#
# Sır DEĞERİ okumaz/yazdırmaz; yalnız ad, sahip, izin.
#
# Çıkış (birim): 0 geçirildi · 3 zaten geçirilmiş · 1 geçirilemedi (birime DOKUNULMADI)
#        (birim --denetle): 0 kimlikli · 1 eski (EnvironmentFile)
#        (izin): 0 temiz · 1 KRİTİK kaldı
set -uo pipefail
export LC_ALL=C

SIR_KOK=${SIR_KOK:-}                                   # test: tüm yolların öneki
SIR_BIRIM=${SIR_BIRIM:-$SIR_KOK/etc/systemd/system/girginospanel.service}
SIR_ENV=${SIR_ENV:-/etc/girginospanel/env}             # birim satırına yazılan GERÇEK yol
SIR_ENV_DOSYA=${SIR_ENV_DOSYA:-$SIR_KOK$SIR_ENV}       # denetlenen dosya
SIR_YEDEK_DIZIN=${SIR_YEDEK_DIZIN:-$SIR_KOK/var/lib/girginospanel/birim-yedek}
SIR_DAEMON_RELOAD=${SIR_DAEMON_RELOAD:-systemctl daemon-reload}
SIR_KIMLIK_SATIRI="LoadCredential=panel-env:$SIR_ENV"

# Usage text (English). The Turkish header comment above is developer documentation.
kullanim() {
  cat <<'KULLANIM'
girginospanel-sir — persistent layout of the panel secrets + permissions of secret files.

Usage:
  girginospanel-sir birim [--denetle]   switch the panel unit to LoadCredential (secrets do not
                                         enter the process environment); --denetle: only measure
  girginospanel-sir birim-geri          put back the latest unit backup (update rollback)
  girginospanel-sir izin [--onar] [--kuru]
                                         secret-file inventory: owner/mode check;
                                         --onar strips excess permissions / fixes ownership;
                                         --kuru (dry run, with --onar): show what would change

It never reads or prints secret VALUES; only names, owners and modes.

Exit codes:
  birim              0 switched · 3 already switched · 1 could not switch (unit left UNTOUCHED)
  birim --denetle    0 uses credentials · 1 old (EnvironmentFile)
  izin               0 clean · 1 CRITICAL findings remain
  other              2 (usage / invalid option / not root)
KULLANIM
}

sir_systemd_surum() {
  if [ -n "${SIR_SYSTEMD_SURUM:-}" ]; then echo "$SIR_SYSTEMD_SURUM"; return; fi
  systemctl --version 2>/dev/null | awk 'NR==1{print $2+0}'
}

# sir_birim_durum <birim> → "kimlik" | "eski" | "yok"
sir_birim_durum() {
  local b=$1
  [ -f "$b" ] || { echo yok; return; }
  local kimlik envf
  kimlik=$(awk -v h="LoadCredential=panel-env:$SIR_ENV" '{s=$0; gsub(/^[ \t]+|[ \t]+$/,"",s); if (s==h) {print 1; exit}}' "$b")
  envf=$(awk -v e="$SIR_ENV" '{s=$0; gsub(/^[ \t]+|[ \t]+$/,"",s); if (s=="EnvironmentFile=" e || s=="EnvironmentFile=-" e) {print 1; exit}}' "$b")
  kimlik=${kimlik:-0}; envf=${envf:-0}
  if [ $kimlik = 1 ] && [ $envf = 0 ]; then echo kimlik; else echo eski; fi
}

# sir_birim_gecis: EnvironmentFile=<env> satırını LoadCredential ile değiştirir.
# Önkoşul düşerse birime HİÇ dokunmaz (eski birimle panel çalışmaya devam eder).
sir_birim_gecis() {
  local b=$SIR_BIRIM durum
  durum=$(sir_birim_durum "$b")
  case "$durum" in
    kimlik) echo "  ✓ unit already uses LoadCredential (secrets do not enter the environment)"; return 3 ;;
    yok)    echo "  ✗ unit missing: $b"; return 1 ;;
  esac
  if [ -L "$b" ]; then echo "  ✗ unit is a symlink — untouched: $b"; return 1; fi
  local sv; sv=$(sir_systemd_surum)
  case "$sv" in ''|*[!0-9]*) sv=0 ;; esac
  if [ "$sv" -lt 247 ]; then
    echo "  ✗ systemd $sv < 247 (no LoadCredential) — unit stays OLD; secrets are removed from the environment after config.Load (layer 1)"
    return 1
  fi
  # LoadCredential kaynağı yoksa servis 243/CREDENTIALS ile AÇILMAZ → önce doğrula.
  if [ -L "$SIR_ENV_DOSYA" ] || [ ! -f "$SIR_ENV_DOSYA" ] || [ ! -s "$SIR_ENV_DOSYA" ]; then
    echo "  ✗ $SIR_ENV_DOSYA missing/empty/symlink — unit not changed"
    return 1
  fi
  if ! grep -qE '^[[:space:]]*PANEL_JWT_SECRET=.{32,}' "$SIR_ENV_DOSYA"; then
    echo "  ✗ no valid PANEL_JWT_SECRET in $SIR_ENV_DOSYA — unit not changed"
    return 1
  fi
  mkdir -p "$SIR_YEDEK_DIZIN" && chmod 700 "$SIR_YEDEK_DIZIN" || { echo "  ✗ backup directory unavailable: $SIR_YEDEK_DIZIN"; return 1; }
  local ts yedek gecici
  ts=$(date +%Y%m%d%H%M%S)
  yedek="$SIR_YEDEK_DIZIN/girginospanel.service.$ts"
  cp -p "$b" "$yedek" || { echo "  ✗ unit could not be backed up — untouched"; return 1; }
  printf '%s\n' "$yedek" > "$SIR_YEDEK_DIZIN/son" || { echo "  ✗ backup marker could not be written — untouched"; return 1; }
  gecici=$(mktemp "$(dirname "$b")/.girginospanel.service.XXXXXX") || { echo "  ✗ no temporary file"; return 1; }
  # EnvironmentFile=<env> (ya da =-<env>) → kimlik satırı; satır yoksa [Service] altına ekle.
  awk -v env="$SIR_ENV" -v yeni="$SIR_KIMLIK_SATIRI" '
    BEGIN { yapildi = 0 }
    {
      s = $0; gsub(/^[ \t]+|[ \t]+$/, "", s)
      if (s == "EnvironmentFile=" env || s == "EnvironmentFile=-" env) {
        if (!yapildi) { print yeni; yapildi = 1 }
        next
      }
      print
    }
    END { if (!yapildi) exit 7 }
  ' "$b" > "$gecici"
  local rc=$?
  if [ $rc = 7 ]; then
    awk -v yeni="$SIR_KIMLIK_SATIRI" '{ print } /^[ \t]*\[Service\][ \t]*$/ && !y { print yeni; y = 1 }' "$b" > "$gecici"
    rc=0
  fi
  if [ $rc != 0 ] || ! grep -qxF "$SIR_KIMLIK_SATIRI" "$gecici"; then
    rm -f "$gecici"; echo "  ✗ unit could not be converted — untouched"; return 1
  fi
  chmod 644 "$gecici"; chown root:root "$gecici" 2>/dev/null || true
  mv -f "$gecici" "$b" || { rm -f "$gecici"; echo "  ✗ unit could not be written — untouched"; return 1; }
  command -v restorecon >/dev/null 2>&1 && [ -z "$SIR_KOK" ] && restorecon "$b" >/dev/null 2>&1
  if ! $SIR_DAEMON_RELOAD >/dev/null 2>&1; then
    cp -p "$yedek" "$b"; $SIR_DAEMON_RELOAD >/dev/null 2>&1
    echo "  ✗ daemon-reload failed — the old unit was put back"; return 1
  fi
  echo "  ✓ unit switched to LoadCredential (backup: $yedek) — takes effect at the next panel restart"
  return 0
}

# sir_birim_geri: sir_birim_gecis'in son yedeğini geri koyar (+ daemon-reload).
sir_birim_geri() {
  local yedek
  yedek=$(cat "$SIR_YEDEK_DIZIN/son" 2>/dev/null)
  if [ -z "$yedek" ] || [ ! -f "$yedek" ]; then echo "  ✗ no unit backup"; return 1; fi
  cp -p "$yedek" "$SIR_BIRIM" || { echo "  ✗ unit could not be restored"; return 1; }
  $SIR_DAEMON_RELOAD >/dev/null 2>&1
  rm -f "$SIR_YEDEK_DIZIN/son"
  echo "  ✓ old unit restored ($yedek)"
  return 0
}

# ── Gizli dosya envanteri ──────────────────────────────────────────────
# yol(glob olabilir) | tür f/d | sahip | izinli gruplar (virgüllü; ilki onarım hedefi) | en çok mod | not
# Mod kuralı: (mevcut & ~enÇok) != 0 → KRİTİK (fazla izin); onarım fazlayı soyar.
SIR_ENVANTER='
/etc/girginospanel/env|f|root|root|600|panel JWT/DB/Redis secrets (LoadCredential source)
/etc/girginospanel/env.*|f|root|root|600|env backups (port-swap) — old secrets
/etc/girginospanel/.sir-yenile-bekleyen|f|root|root|600|half-finished secret rotation (old+new values)
/etc/girginospanel/db.key|f|root|root|600|at-rest encryption key
/etc/girginospanel/proxy.secret|f|root|root|600|X-Gosp-Proxy secret
/etc/girginospanel/eklenti-*.key|f|root|root|600|plugin keys
/etc/girginospanel/eklenti-*.env|f|root|root|600|plugin environments (DSN/webmail passwords)
/etc/girginospanel/pma-internal.token|f|root|apache,root|640|phpMyAdmin signon token (read by apache)
/etc/girginospanel/kurulum-kimlik|f|root|root,apache|640|license fingerprint (webmail/apache read it)
/etc/ssl/girginospanel/*.key*|f|root|root|600|panel TLS private key + backups
/etc/pki/girginospanel/*/*.key|f|root|root|600|domain TLS private keys
/etc/pki/mail/*.key*|f|root|root|600|mail TLS private key
/etc/nginx/conf.d/_panel.conf|f|root|nginx,root|640|panel vhost (contains the proxy secret)
/etc/nginx/conf.d/_panel.conf.*|f|root|root,nginx|640|panel vhost backups (proxy secret)
/var/lib/girginospanel/acme|d|root|root|700|ACME account keys
/var/lib/girginospanel/eklenti-anahtar|d|root|root|700|plugin key store
/var/lib/girginospanel/tasima|d|root|root|700|migration SSH key
/var/lib/girginospanel/tasima-yedek|d|root|root|700|migration backups
/var/lib/girginospanel/birim-yedek|d|root|root|700|unit backups
/var/backups/girginospanel/db|d|root|root|700|panel DB dumps
/var/backups/girginospanel-sistem|d|root|root|700|system backup (env + all DBs)
/root/.acme.sh|d|root|root|700|acme.sh account/DNS API keys
/etc/pure-ftpd/.pfsql_pass|f|root|root|600|pure-ftpd DB password
/etc/pure-ftpd/pureftpd-mysql.conf|f|root|root|640|pure-ftpd DB password
/etc/valkey/users.acl|f|valkey|valkey,root|640|Valkey ACL (password hashes)
/etc/postfix/mysql-*.cf|f|root|postfix|640|postfix DB password
/etc/dovecot/dovecot-sql.conf.ext|f|root|root,dovecot|640|dovecot DB password
/etc/dovecot/dovecot-sql.conf.ext.*|f|root|root|600|dovecot SQL backups
/opt/phpmyadmin/config.inc.php|f|root|apache|640|phpMyAdmin blowfish/control user
/etc/roundcubemail/config.inc.php|f|root|apache|640|webmail DB password / des_key
/etc/opendkim/keys|d|opendkim|opendkim|750|DKIM private keys
/root/.ssh/id_*|f|root|root|600|root SSH private key
'

SIR_KRITIK=0; SIR_ONARILAN=0
sir_kritik() { SIR_KRITIK=$((SIR_KRITIK+1)); echo "  CRITICAL $*"; }

# sir_izin_tek <yol> <tür> <sahip> <gruplar> <enÇok> <onar 0/1> <kuru 0/1> <not>
sir_izin_tek() {
  local p=$1 tur=$2 sahip=$3 gruplar=$4 enCok=$5 onar=$6 kuru=$7 notu=$8
  if [ -L "$p" ]; then
    sir_kritik "$p: symlink — a secret file must NOT be a symlink (not followed, inspect manually) [$notu]"
    return
  fi
  case "$tur" in
    f) [ -f "$p" ] || return 0 ;;
    d) [ -d "$p" ] || return 0 ;;
  esac
  local m u g fazla sorun="" hedefMod hedefGrup
  m=$(stat -c '%a' -- "$p" 2>/dev/null) || return 0      # stat -L'siz = lstat
  u=$(stat -c '%U' -- "$p" 2>/dev/null)
  g=$(stat -c '%G' -- "$p" 2>/dev/null)
  fazla=$(( 8#$m & ~8#$enCok & 07777 ))
  [ "$fazla" -ne 0 ] && sorun="excess mode $m (at most $enCok)"
  [ "$u" != "$sahip" ] && sorun="${sorun:+$sorun, }owner $u (expected $sahip)"
  case ",$gruplar," in *",$g,"*) ;; *) sorun="${sorun:+$sorun, }group $g (allowed: $gruplar)" ;; esac
  [ -z "$sorun" ] && return 0
  if [ "$onar" = 1 ]; then
    if [ "$kuru" = 1 ]; then
      echo "  → (dry) will be repaired: $p — $sorun"
      SIR_KRITIK=$((SIR_KRITIK+1)); return
    fi
    hedefMod=$(printf '%o' $(( 8#$m & 8#$enCok & 07777 )))
    hedefGrup=$g
    case ",$gruplar," in *",$g,"*) ;; *) hedefGrup=${gruplar%%,*} ;; esac
    local tamam=1
    # Sahiplik ÖNCE: chown setuid/setgid'i temizler; mod sonra kesinleşir.
    if [ "$u" != "$sahip" ] || [ "$g" != "$hedefGrup" ]; then
      if id -u "$sahip" >/dev/null 2>&1 && getent group "$hedefGrup" >/dev/null 2>&1; then
        chown -h -- "$sahip:$hedefGrup" "$p" 2>/dev/null || tamam=0
      else
        tamam=0
      fi
    fi
    [ -L "$p" ] && { sir_kritik "$p: became a symlink during the operation — stopped"; return; }
    chmod -- "$hedefMod" "$p" 2>/dev/null || tamam=0
    if [ $tamam = 1 ]; then
      SIR_ONARILAN=$((SIR_ONARILAN+1))
      echo "  ✔ repaired: $p — $sorun → $(stat -c '%a %U:%G' -- "$p")"
    else
      sir_kritik "$p: $sorun — COULD NOT BE REPAIRED [$notu]"
    fi
    return
  fi
  sir_kritik "$p: $sorun [$notu]"
}

# sir_valkey_umask: Valkey ACL SAVE users.acl'i kendi umask'ıyla (0022 → 0644)
# yeniden yazar; onarılan izin bir sonraki SAVE'de geri gelirdi. Kalıcı: UMask=0027.
sir_valkey_umask() {
  local onar=$1 kuru=$2 d="$SIR_KOK/etc/systemd/system/valkey.service.d" f
  f="$d/50-gosp-umask.conf"
  [ -f "$SIR_KOK/usr/lib/systemd/system/valkey.service" ] || [ -f "$SIR_KOK/etc/systemd/system/valkey.service" ] || return 0
  grep -qs '^UMask=0027' "$f" && return 0
  if [ "$onar" != 1 ]; then
    echo "  ! valkey UMask drop-in missing — ACL SAVE writes users.acl as 0644 (repair: girginospanel-sir izin --onar)"
    return 0
  fi
  [ "$kuru" = 1 ] && { echo "  → (dry) $f will be written (UMask=0027)"; return 0; }
  mkdir -p "$d" && printf '[Service]\n# girginospanel-sir: make ACL SAVE write users.acl as 0640 (password hashes)\nUMask=0027\n' > "$f" \
    || return 0
  if [ -n "$SIR_KOK" ]; then echo "  ✔ valkey UMask=0027 drop-in"; return 0; fi
  # Drop-in ancak restart'ta etkin olur; restart'sız bırakılırsa panelin bir sonraki
  # ACL SAVE'i (kiracı Redis kullanıcısı açma/kapama) dosyayı yine 0644 yazar
  # (181'de ölçüldü). Tek seferlik: drop-in zaten varsa bu dala hiç gelinmez.
  systemctl daemon-reload >/dev/null 2>&1
  if systemctl try-restart valkey >/dev/null 2>&1; then
    echo "  ✔ valkey UMask=0027 drop-in + valkey restarted (one-time)"
  else
    echo "  ! valkey UMask=0027 drop-in written but valkey could not be restarted — manually: systemctl restart valkey"
  fi
}

sir_izin() {
  local onar=0 kuru=0
  while [ $# -gt 0 ]; do
    case "$1" in --onar) onar=1 ;; --kuru) kuru=1 ;; *) echo "unknown option: $1" >&2; return 2 ;; esac; shift
  done
  SIR_KRITIK=0; SIR_ONARILAN=0
  local satir yol tur sahip gruplar enCok notu p top=0
  while IFS= read -r satir; do
    [ -z "$satir" ] && continue
    IFS='|' read -r yol tur sahip gruplar enCok notu <<<"$satir"
    for p in $SIR_KOK$yol; do
      [ -e "$p" ] || [ -L "$p" ] || continue
      case "$p" in *.pub) continue ;; esac
      top=$((top+1))
      sir_izin_tek "$p" "$tur" "$sahip" "$gruplar" "$enCok" "$onar" "$kuru" "$notu"
    done
  done <<<"$SIR_ENVANTER"
  sir_valkey_umask "$onar" "$kuru"
  if [ "$SIR_KRITIK" -eq 0 ]; then
    if [ "$SIR_ONARILAN" -gt 0 ]; then echo "  ✓ secret files: $top checked, $SIR_ONARILAN repaired, no problems left"; else echo "  ✓ secret files: $top checked, no problems"; fi
    return 0
  fi
  echo "  ✗ secret files: $top checked, $SIR_KRITIK CRITICAL"
  return 1
}

# Test kancası: GOSP_SIR_KUTUPHANE=1 ile source edilince yalnız fonksiyonlar yüklenir.
if [ "${GOSP_SIR_KUTUPHANE:-0}" = 1 ]; then return 0 2>/dev/null || exit 0; fi

[ "$(id -u)" = 0 ] || { echo "root required" >&2; exit 2; }
komut=${1:-}; [ $# -gt 0 ] && shift
case "$komut" in
  birim)
    if [ "${1:-}" = "--denetle" ]; then
      d=$(sir_birim_durum "$SIR_BIRIM"); echo "unit: $d"
      [ "$d" = kimlik ]; exit $?
    fi
    sir_birim_gecis; exit $? ;;
  birim-geri) sir_birim_geri; exit $? ;;
  izin) sir_izin "$@"; exit $? ;;
  *) kullanim; exit 2 ;;
esac
