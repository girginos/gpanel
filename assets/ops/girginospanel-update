#!/usr/bin/env bash
# girginospanel-update — GirginOSPanel'i KENDI YAYIN ALTYAPIMIZDAN güvenli
# in-place günceller (sha256 doğrulamalı). GitHub varsayılan yolda DEĞİL.
#
#   girginospanel-update            # son sürümü çek → binary+frontend+migration değiştir → yeniden başlat
#   girginospanel-update --dry-run  # sadece ne yapacağını göster, dokunma
#   girginospanel-update --force    # binary aynı olsa bile yeniden uygula
#   girginospanel-update --branch X # farklı dal (varsayılan: main)
#
# KORUR (asla dokunmaz): /etc/girginospanel/env (JWT/DB/Redis secret),
# MariaDB `panel` DB + tüm müşteri verisi, /home/c_* siteleri.
# Yeni migration'lar servis yeniden başlarken otomatik + idempotent uygulanır.
#
# DB DAYANIKLILIĞI:
#  • Migration'lardan ÖNCE panel DB'sinin tam dump'ı alınır (/var/backups/girginospanel/db).
#  • FAIL-CLOSED: dump alınamazsa güncelleme HİÇ BAŞLAMAZ (yedeksiz migration reddedilir).
#  • Yeni sürüm sağlıklı başlamazsa ESKİ binary'ye + güncelleme öncesi DB'ye rollback yapar.
#  • Günlük 03:30 yedek timer'ı (girginospanel-db-backup.timer) kurulur + enable edilir.
set -euo pipefail

# 🔴 PATH'İ KENDİMİZ KURUYORUZ — `sudo` /usr/local/bin'i ATAR.
# AlmaLinux/RHEL varsayılanı:  Defaults secure_path = /sbin:/bin:/usr/sbin:/usr/bin
# Belgelenen kurulum/güncelleme komutu `curl ... | sudo bash` olduğu için bu
# yol HER MÜŞTERİDE çalışır ve kendi araçlarımız (girginospanel-*, composer,
# wp) bare-name çağrıldığında "command not found" verir. Ölçüldü: araç dosya
# olarak VARDI, yalnızca PATH'te yoktu; kurulum yine de yeşil bitiyordu.
case ":$PATH:" in
  *:/usr/local/bin:*) : ;;
  *) export PATH="/usr/local/sbin:/usr/local/bin:$PATH" ;;
esac

# 🔴 AYRISTIRMA ICIN LC_ALL=C ZORUNLU — TURKCE LOCALE REGEX ARALIGINI BOZUYOR.
# Olculdu (31.56.47.190, LANG=tr_TR.UTF-8):
#     printf '@CT@ audit_log' | grep -oE '@CT@ [a-zA-Z0-9_]+'   ->  "@CT@ aud"
#     ayni komut LC_ALL=C ile                                    ->  "@CT@ audit_log"
# tr_TR collation'inda `a-z` araligi `i` harfini KAPSAMIYOR (noktasiz i/noktali i
# ayrimi), bu yuzden karakter araligi kullanan HER ayristirma `i` harfinde kesiliyor:
#   audit_log -> aud · cp_domains -> cp_doma · cp_websec_findings -> cp_websec_f
# Sonuc: sema kontrolu 22/46 gibi SAHTE bir kritik uretip musteri guncellemesini
# BLOKLADI. Turkiye bizim ana pazarimiz — bu her musteri sunucusunu etkiler.
# LC_ALL=C bayt semantigi verir; ASCII tanimlayici ayristirmak icin dogrusu budur.
export LC_ALL=C


REPO="${GOSP_REPO:-girginos/gpanel}"
BRANCH="main"; DRY=0; FORCE=0
PREFIX=/opt/girginospanel
BIN="$PREFIX/bin/girginospanel-server"
SEED="$PREFIX/bin/girginospanel-seed-admin"
FDIST="$PREFIX/frontend-dist"
MIGR="$PREFIX/src/migrations"
SCRIPTS="$PREFIX/src/scripts"
DBBK=/usr/local/bin/girginospanel-db-backup   # panel DB dump aracı (assets/ops'tan kurulur)
DBDIR=/var/backups/girginospanel/db           # dump'ların yeri (kardeş dizinler = domain yedeği)
PREDUMP=""                                    # güncelleme öncesi dump yolu (rollback'te geri yüklenir)
KAPI_JSON=/etc/girginospanel/kapi.json        # rol kapıları (ADR-GP-001) doğruluk kaynağı
KAPI_YENI=0                                   # 1 = kapi.json'u BU koşu (10c) yarattı → rollback kaldırır
DESTEK_AJAN_YENI=0                            # 1 = pakette destek ajanı ikilisi vardı ve /usr/local/bin'e yazıldı (adım 6)
SIR_BIRIM_YENI=0                              # 1 = panel birimini BU koşu (10e) LoadCredential'a geçirdi → rollback geri koyar
SIR_ARAC=""                                   # girginospanel-sir (paketteki tercih edilir)
# Restart sonrası sağlık penceresi (sn) ve çöküş sonrası kararlılık (ardışık başarılı yoklama).
# GOSP_SAGLIK_SN yalnız kum havuzu testleri içindir.
SAGLIK_SN=${GOSP_SAGLIK_SN:-120}
case "$SAGLIK_SN" in ''|*[!0-9]*) SAGLIK_SN=120 ;; esac
SAGLIK_KARARLI=5
SAGLIK_GECEN=""                               # sağlık penceresinde geçen süre (rapor için)

# Usage text (English). The Turkish header comment above is developer documentation.
kullanim() {
  cat <<'KULLANIM'
girginospanel-update — safely updates GirginOSPanel in place from our own release
infrastructure (sha256 verified). GitHub is not on the default path.

Usage:
  girginospanel-update [--dry-run] [--force] [--branch <name>]

Options:
  --dry-run        only show what would be done; change nothing
  --force          re-apply even if the package is identical to the installed one
  --branch <name>  branch used by the GitHub emergency fallback (default: main)
  -h, --help       show this help

Environment:
  GOSP_AYNALAR           space-separated mirror base URLs (default: https://surum.girginos.io/panel)
  GOSP_GITHUB_YEDEK      1 = fall back to GitHub when every mirror fails
  GOSP_GERI_DONUS_ZORLA  1 = allow installing a package older than the database schema
  GOSP_SIR_YENILE        0 = skip the one-time panel secret rotation

Preserved (never touched): /etc/girginospanel/env (JWT/DB/Redis secrets), the MariaDB `panel`
database and all customer data, the /home/c_* sites. New migrations are applied automatically
and idempotently when the service restarts.

Database safety:
  - A full dump of the panel DB is taken BEFORE migrations (/var/backups/girginospanel/db).
  - Fail-closed: if the dump cannot be taken, the update does not start at all.
  - If the new version does not start healthy, the update rolls back to the old binary and
    the pre-update database.
  - A daily 03:30 backup timer (girginospanel-db-backup.timer) is installed and enabled.

Exit codes: 0 = success (or already up to date), 1 = failure / verification failed / rolled back,
2 = invalid argument.
KULLANIM
}

while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run) DRY=1 ;;
    --force) FORCE=1 ;;
    --branch) BRANCH="$2"; shift ;;
    --branch=*) BRANCH="${1#*=}" ;;
    -h|--help) kullanim; exit 0 ;;
    *) echo "unknown argument: $1" >&2; exit 2 ;;
  esac
  shift
done

c_b="\033[1;34m"; c_g="\033[32m"; c_r="\033[31m"; c_y="\033[33m"; c_0="\033[0m"
[ -t 1 ] || { c_b=; c_g=; c_r=; c_y=; c_0=; }
ok()   { echo -e "  ${c_g}✓${c_0} $*"; }
warn() { echo -e "  ${c_y}!${c_0} $*"; }
die()  { echo -e "${c_r}✗ $*${c_0}" >&2; exit 1; }
step() { echo -e "${c_b}══ $* ══${c_0}"; }

# >>> geri-donus-kapisi — girginospanel-update ve girginospanel-restore'da BİREBİR aynı
# (internal/opsbetik/geridonus_test.go iki kopyayı karşılaştırır ve davranışı sınar).
#
# GERİ DÖNÜŞSÜZ GÖÇLER: uygulandıktan sonra DB'yi o göçü bilmeyen (daha ESKİ) ikili
# YANLIŞ okur. 0120 (D1 "özel plan = üst yazım"): hostinge özel limitler artık
# hosting_limit_ust'ta, eski "<alan> — Özel" kopya planlar arşivde ve hosting katalog
# planına bağlı. Eski ikili hosting_limit_ust'u bilmez → hostingi katalog planının
# limitleriyle görür ve açılıştaki UygulaHepsi/LimitleriReAssert cgroup/FPM/disk
# kotası/governor sınırlarını SESSİZCE DEĞİŞTİRİR. Böyle bir DB'ye bu göçü içermeyen
# paket kurulmaz. Bilerek (sonucu kabul ederek): GOSP_GERI_DONUS_ZORLA=1.
# Not: başarısız güncellemenin KENDİ geri dönüşü bu kapıya takılmaz — orada DB de
# güncelleme öncesi dump'a döner (eski ikili + eski DB tutarlı).
GERI_DONUSSUZ_GOCLER="0120_hosting_limit_ust.sql"
GOSP_DB_ADI="${GOSP_DB_ADI:-panel}"

# paket_gocleri <assets dizini> — paketteki göç dosya adları (satır başına bir).
# Paket göç listesi taşımıyorsa 1 döner (bilinmiyor ≠ "göç yok").
paket_gocleri() {
  if [ -f "$1/migrations.tar.gz" ]; then
    tar tzf "$1/migrations.tar.gz" 2>/dev/null | sed 's#.*/##' || return 1
  elif [ -d "$1/migrations" ]; then
    ls -1 "$1/migrations" 2>/dev/null || return 1
  else
    return 1
  fi
}

# geri_donus_kapisi <paketin assets dizini> — DB'de uygulanmış geri dönüşsüz bir göç
# pakette YOKSA kurulumu reddeder (die). Göç defteri okunamıyorsa (mysql yok/kapalı,
# defter tablosu yok = çok eski kurulum) denetim atlanır: o durumda DB yedeği adımı
# zaten fail-closed'dur ve defteri olmayan DB 0120'yi hiç görmemiştir.
geri_donus_kapisi() {
  local uygulanan paket g eksik=""
  command -v mysql >/dev/null 2>&1 || { warn "downgrade guard: mysql not found — version floor could not be checked"; return 0; }
  uygulanan=$(mysql -N -e "SELECT dosya FROM \`$GOSP_DB_ADI\`.schema_migrations" 2>/dev/null) \
    || { warn "downgrade guard: migration ledger could not be read — version floor could not be checked"; return 0; }
  paket=$(paket_gocleri "$1") || paket=""
  for g in $GERI_DONUSSUZ_GOCLER; do
    grep -qxF -- "$g" <<<"$uygulanan" || continue
    grep -qxF -- "$g" <<<"$paket" && continue
    eksik="$eksik $g"
  done
  [ -z "$eksik" ] && return 0
  if [ "${GOSP_GERI_DONUS_ZORLA:-0}" = 1 ]; then
    warn "🔴 DOWNGRADE FORCED (GOSP_GERI_DONUS_ZORLA=1): the package does not contain the irreversible migrations already applied to the DB:$eksik — the older binary will NOT see per-hosting custom limits; those hostings fall back to their catalog plan limits"
    return 0
  fi
  die "DOWNGRADE REFUSED: this package does not contain the irreversible migrations already applied to the DB:$eksik — the package is OLDER than this DB. The older binary cannot see per-hosting custom limits (hosting_limit_ust) and at startup would reset cgroup/FPM/quota/governor limits to the catalog plan. Nothing was touched. Install a current/newer package; to accept the consequences knowingly: GOSP_GERI_DONUS_ZORLA=1"
}

# yeni_tablolari_kenara_al <güncelleme öncesi dump.sql.gz> — geri dönüşte, dump GERİ
# YÜKLENDİKTEN SONRA (panel DURMUŞKEN) çağrılır. Dump yalnız KENDİ tablolarını
# DROP+CREATE eder; başarısız sürümün göçlerinin YARATTIĞI tablolar (ör. 0120
# hosting_limit_ust / service_plans_ozel_arsiv) geri alınmış zaman çizgisinin
# verisiyle kalırdı. Eski ikili onları görmez ama yeniden güncellemede göç defteri
# (dump'tan geri geldi) o göçü yeniden koşar, CREATE IF NOT EXISTS no-op olur ve BAYAT
# satırlar canlı sayılırdı (hostinge yanlış limit, takılı/çift dönüşüm). Bu tablolar
# önce ayrı bir dump'a yedeklenir (veri kaybı yok), sonra kaldırılır → DB güncelleme
# öncesiyle BİREBİR aynı. Yedek alınamazsa ya da liste şüpheliyse HİÇBİR ŞEY silinmez.
yeni_tablolari_kenara_al() {
  local onceki simdi ek t sayi=0 ts yedek dizin
  onceki=$(zcat "$1" 2>/dev/null | sed -n 's/^CREATE TABLE \(IF NOT EXISTS \)\{0,1\}`\([^`]*\)`.*/\2/p' | LC_ALL=C sort -u) || onceki=""
  if [ -z "$onceki" ]; then
    warn "rollback leftovers could not be checked (table list could not be read from the dump) — new migration tables left in place"
    return 1
  fi
  simdi=$(mysql -N -e "SELECT table_name FROM information_schema.tables WHERE table_schema='$GOSP_DB_ADI' AND table_type='BASE TABLE'" 2>/dev/null | LC_ALL=C sort -u) \
    || { warn "rollback leftovers could not be checked (table list could not be read)"; return 1; }
  ek=$(LC_ALL=C comm -13 <(printf '%s\n' "$onceki") <(printf '%s\n' "$simdi")) || ek=""
  [ -z "$ek" ] && return 0
  for t in $ek; do
    case "$t" in *[!A-Za-z0-9_]*) warn "unexpected table name ($t) — rollback leftovers left in place"; return 1 ;; esac
    sayi=$((sayi + 1))
  done
  if [ "$sayi" -gt 20 ]; then
    warn "$sayi tables are not in the dump (suspiciously many) — none were removed; inspect manually"
    return 1
  fi
  ts=$(date +%Y%m%d%H%M%S)
  dizin="${DBDIR:-/var/backups/girginospanel/db}"
  yedek="$dizin/geri-donus-artik-$ts.sql.gz"
  mkdir -p "$dizin" 2>/dev/null || true
  # shellcheck disable=SC2086 # $ek tablo adları (yukarıda doğrulandı), ayrı argüman olmalı
  if ! mysqldump --single-transaction "$GOSP_DB_ADI" $ek 2>/dev/null | gzip > "$yedek"; then
    rm -f "$yedek" 2>/dev/null || true
    warn "rollback leftovers could not be backed up — tables left in place:" $ek
    return 1
  fi
  for t in $ek; do
    if mysql -e "SET FOREIGN_KEY_CHECKS=0; DROP TABLE \`$GOSP_DB_ADI\`.\`$t\`" 2>/dev/null; then
      ok "table of the rolled-back version removed: $t (backup: $yedek)"
    else
      warn "table of the rolled-back version could not be removed: $t — manually: DROP TABLE $GOSP_DB_ADI.$t (backup: $yedek)"
    fi
  done
}
# <<< geri-donus-kapisi

# >>> goc-dizini-geri
# 🔴 GÖÇ DİZİNİ DE ROLLBACK'TE GERİ ALINIR. 8. adım paketin göç dosyalarını $MIGR'e açar. Rollback
# ikiliyi ve DB'yi geri alır; dizine dokunmazsa ESKİ ikili geri alınmış DB ile açılırken dizindeki TÜM
# .sql dosyalarını okur ve defterde (dump'tan geri geldi) olmayanı YENİDEN UYGULAR → "geri alınmış"
# sistem eski ikili + YENİ şema olur. 181 provasında ölçüldü: sağlıksız açılış → rollback → eski ikili
# 0217'yi yeniden çalıştırdı (FK yeniden düştü, tablo geri geldi, defter 128).
MIGR_BAK=""

# goc_dizini_yedekle — 8. adımdan ÖNCE çağrılır. Başarısızlık güncellemeyi DURDURMAZ; yalnız
# rollback dizini geri alamaz (uyarı verilir).
goc_dizini_yedekle() {
  MIGR_BAK="${MIGR%/}.bak"
  rm -rf "$MIGR_BAK" 2>/dev/null || true
  if [ -d "$MIGR" ] && cp -a "$MIGR" "$MIGR_BAK" 2>/dev/null; then
    return 0
  fi
  warn "migration directory could not be backed up — rollback may not restore the migration files (the older binary may re-apply the new migration)"
  MIGR_BAK=""
  return 1
}

# goc_dizini_geri_al — rollback'te panel DURMUŞKEN çağrılır: bu güncellemenin eklediği göç dosyalarını
# kaldırır, değişen/silinenleri yedekten geri koyar. Dizin hiçbir anda boş kalmaz (önce sil, sonra
# üstüne kopyala; rm -rf + cp DEĞİL).
goc_dizini_geri_al() {
  [ -n "$MIGR_BAK" ] && [ -d "$MIGR_BAK" ] || return 1
  local f n=0
  for f in "$MIGR"/*.sql; do
    [ -e "$f" ] || continue
    [ -e "$MIGR_BAK/$(basename "$f")" ] && continue
    rm -f "$f" && n=$((n + 1))
  done
  if ! cp -af "$MIGR_BAK"/. "$MIGR"/ 2>/dev/null; then
    warn "migration directory could not be restored — manually: cp -af $MIGR_BAK/. $MIGR/"
    return 1
  fi
  ok "migration directory restored to its pre-update state ($n new migration file(s) removed)"
}

# goc_dizini_temizle — başarıda yedeği kaldırır (bayat .bak kalmasın).
goc_dizini_temizle() {
  [ -n "$MIGR_BAK" ] && rm -rf "$MIGR_BAK" 2>/dev/null
  MIGR_BAK=""
  return 0
}
# <<< goc-dizini-geri

# >>> frontend-geri
# 🔴 FRONTEND DE ROLLBACK'TE GERİ ALINIR. 7. adım frontend-dist'i atomik takas eder ve güncelleme
# öncesini ${FDIST}.old olarak bırakır. Rollback ikiliyi, DB'yi ve göç dizinini geri alıp frontend'e
# dokunmazsa "geri alınmış" sistem ESKİ ikili + YENİ arayüz olur: yeni arayüz henüz olmayan uç
# noktaları çağırır ve yeni alanları eski ikiliye gönderir. 181 provasında ölçüldü: rollback sonrası
# index-<yeni>.js sürdü, eskisi frontend-dist.old'da kaldı.
FDIST_TAKAS=0   # 1 = BU koşu frontend-dist'i takas etti: ${FDIST}.old güncelleme öncesidir (eski koşudan kalan .old DEĞİL)

# frontend_geri_al — rollback'te panel DURMUŞKEN çağrılır. Dizin kalıcı olarak yok kalmaz: yeni arayüz
# kenara alınır, eskisi yerine konur; ikinci adım başarısızsa yeni arayüz geri konur.
frontend_geri_al() {
  [ "$FDIST_TAKAS" = 1 ] && [ -d "${FDIST}.old" ] || return 1
  local kenar="${FDIST}.red.$$"
  rm -rf "$kenar" 2>/dev/null || true
  if [ -e "$FDIST" ] && ! mv "$FDIST" "$kenar"; then
    warn "frontend-dist could not be rolled back — manually: mv $FDIST $FDIST.red; mv $FDIST.old $FDIST"
    return 1
  fi
  if ! mv "${FDIST}.old" "$FDIST"; then
    [ -e "$kenar" ] && mv "$kenar" "$FDIST" 2>/dev/null || true
    warn "frontend-dist could not be rolled back (new UI left in place) — manually: mv $FDIST.old $FDIST"
    return 1
  fi
  rm -rf "$kenar" 2>/dev/null || true
  command -v restorecon >/dev/null && restorecon -R "$FDIST" >/dev/null 2>&1 || true
  FDIST_TAKAS=0
  ok "frontend-dist restored to its pre-update state"
}
# <<< frontend-geri

# çalışan panelin /healthz'inden sürüm (binary'nin --version flag'i YOK, asla çalıştırmıyoruz)
# 🔴 SAGLIK URL'INI VARSAYMA — env'den OKU. Sabit :8080, portu degistirilmis
# (girginospanel-port-swap.sh) saglikli bir sunucuda saglik kontrolunu HIC
# gecirmez ve asagidaki rollback dalini tetikler: eski binary + GUNCELLEME
# ONCESI DB geri yuklenir. Yani tamamen saglikli bir panelde VERI GERI SARMA.
# 🔴 OPS-1: set -e + pipefail altında `X=$(boru hattı)` boru hattı düşerse betiği HİÇBİR
# mesaj basmadan bitirir. PANEL_LISTEN satırı olmayan env'de grep 1 döner → güncelleyici
# tek satır yazmadan exit 1 veriyordu; `|| X=""` varsayılana düşürür.
PANEL_HEALTH_ADRES=$(grep -oE '^PANEL_LISTEN=.*' /etc/girginospanel/env 2>/dev/null | cut -d= -f2- | tr -d ' ') || PANEL_HEALTH_ADRES=""
PANEL_HEALTH_ADRES=${PANEL_HEALTH_ADRES:-127.0.0.1:8080}
case "$PANEL_HEALTH_ADRES" in
  :*)        PANEL_HEALTH_ADRES="127.0.0.1$PANEL_HEALTH_ADRES" ;;
  0.0.0.0:*) PANEL_HEALTH_ADRES="127.0.0.1:${PANEL_HEALTH_ADRES##*:}" ;;
esac
PANEL_HEALTH="http://$PANEL_HEALTH_ADRES/healthz"
# surum: çalışan panelin sürümü; panel kapalı/yanıtsızsa BOŞ çıktı ve 0 (asla hata değil).
# 🔴 OPS-1: eskiden panel kapalıyken curl düşüyor, grep boş girdiyle 1 dönüyor, pipefail
# boru hattını 1 sayıyordu → `CURVER=$(surum)` basit atama olduğundan set -e betiği
# SESSİZCE bitiriyordu: güncelleyici (--dry-run dahil) tam da onarması gereken durumda
# (panel kapalı) hiç çalışmıyordu; restart sonrası `NEWVER=$(surum)` de aynı yoldan,
# MARKER yazıldıktan sonra doğrulamasız ölebiliyordu. --max-time: asılı panel güncelleyiciyi
# sonsuza dek bekletmesin.
surum() { curl -fsS --max-time 5 "$PANEL_HEALTH" 2>/dev/null | grep -oE '"surum":"[^"]*"' | cut -d'"' -f4 || true; }

# kapi_adresleri: rol kapısı adreslerini gösterir (kapı modu yoksa sessiz). Otomatik
# geçişten sonra yöneticinin YENİ admin adresini öğrendiği yer burası + eski kapıdaki
# panel uyarısıdır.
kapi_adresleri() {
  local a b m ip
  a=$("$BIN" kapi port admin 2>/dev/null) || return 0
  b=$("$BIN" kapi port bayi 2>/dev/null); m=$("$BIN" kapi port musteri 2>/dev/null)
  ip=$(hostname -I 2>/dev/null | awk '{print $1}')
  step "Panel gates"
  echo "   Administrator: https://${ip:-SERVER_IP}:$a   ← keep this address PRIVATE"
  echo "   Reseller:      https://${ip:-SERVER_IP}:$b"
  echo "   Customer:      https://${ip:-SERVER_IP}:$m"
  if "$BIN" kapi durum 2>/dev/null | grep -E '^  (eski|old) '; then
    warn "the old address stays open until you sign in once from the NEW admin address"
  fi
  warn "if your cloud provider has a firewall, open TCP ports $a, $b, $m there too"
}

# kapi_selinux_etiketle: kapı portlarını restart'tan ÖNCE SELinux'ta http_port_t yapar
# (`girginospanel-server kapi selinux`; etiketleri /run/girginospanel/kapi-selinux
# önbelleğine yazar → yeni panelin açılış Heal'i önbellekteki portlar için semanage
# KOŞMAZ). 🔴 SON-OPS-1: etiketleme eskiden YALNIZ açılış Heal'indeydi ve Heal
# ListenAndServe'den ÖNCE koşar: `semanage port -l` + port başına `semanage port -a`
# (181'de 3-12 sn) bitmeden /healthz'e yanıt veren yoktu, kısa sağlık penceresi
# sağlıklı güncellemeyi geri alıyordu. Önceden kapı moduna geçmiş sunucular da dahil
# (önbellek tmpfs'te: reboot'ta silinir) kapi.json varsa HER güncellemede çağrılır.
# Güncellemeyi ASLA durdurmaz (her yolda 0 döner): etiketlenemeyen port güvenli
# başarısızlıktır — panel kapı düzenini uygulamaz, tek-port davranışı sürer.
# $BIN burada YENİ ikilidir (adım 6'da kuruldu); eski ikili bilinmeyen kapı alt
# komutunda kullanım yazıp 2 döner (sunucu başlatmaz).
kapi_selinux_etiketle() {
  [ -f "$KAPI_JSON" ] || return 0
  local rc=0 cikti portlar kj ebit adog eski
  if command -v timeout >/dev/null 2>&1; then
    cikti=$(timeout 300 "$BIN" kapi selinux 2>&1) || rc=$?
  else
    cikti=$("$BIN" kapi selinux 2>&1) || rc=$?
  fi
  case "$rc" in
    0) ok "gate ports are ready for SELinux (http_port_t, or SELinux is off) — startup does not wait for semanage" ;;
    3) : ;;   # kapı modu yapılandırılmamış (kapi.json yok/okunamadı) — sessiz
    *)
      # 🔴 OPS-4: YALNIZ üst düzey alanlar. İç içe nesneler (ilk_giris: rol → unix zaman
      # damgası, anahtarları "bayi"/"musteri") ÖNCE atılır; yoksa "bayi":1758700000 "kapı
      # portu" diye basılıyor, operatör semanage'i geçersiz portla deniyordu. Eski portlar
      # `kapi selinux` ile AYNI kuralla (kapi.Ayar.PortHaritasi → EskiAcik: listede VE
      # (şimdi < eski_bitis YA DA admin_dogrulandi == 0)) — kapanmış eski port listelenmez.
      kj=$(tr -d ' \t\r\n' < "$KAPI_JSON" 2>/dev/null | sed -E 's/"[A-Za-z0-9_]+":\{[^{}]*\}//g') || kj=""
      portlar=$(printf '%s' "$kj" | grep -oE '"(admin|bayi|musteri)":[0-9]+' | grep -oE '[0-9]+$') || portlar=""
      ebit=$(printf '%s' "$kj" | grep -oE '"eski_bitis":[0-9]+' | grep -oE '[0-9]+$') || ebit=0
      adog=$(printf '%s' "$kj" | grep -oE '"admin_dogrulandi":[0-9]+' | grep -oE '[0-9]+$') || adog=0
      if [ "$(date +%s)" -lt "${ebit:-0}" ] || [ "${adog:-0}" -eq 0 ]; then
        eski=$(printf '%s' "$kj" | grep -oE '"eski_portlar":\[[0-9,]*\]' | grep -oE '[0-9]+') || eski=""
        portlar="$portlar $eski"
      fi
      # $portlar TIRNAKSIZ: bilinçli bölme (yalnız rakam — glob yok), her port bir satır.
      portlar=$(printf '%s\n' $portlar | grep -E '^[0-9]+$' | sort -un | tr '\n' ' ') || portlar=""
      portlar=${portlar% }
      case "$rc" in
        1)   warn "gate ports could not be labeled in SELinux — the panel will not apply the gate layout and keeps the old single-port behavior; manually: semanage port -a -t http_port_t -p tcp <p>  (gate ports: ${portlar:-kapi.json could not be read})" ;;
        124) warn "gate port SELinux labeling did not finish within 300 s (kapi selinux timed out) — labeling is left to panel startup; manually: semanage port -a -t http_port_t -p tcp <p>  (gate ports: ${portlar:-kapi.json could not be read})" ;;
        *)   warn "kapi selinux could not be run (exit $rc — does the binary not know the command?) — labeling is left to panel startup (startup may be slow); manually: semanage port -a -t http_port_t -p tcp <p>  (gate ports: ${portlar:-kapi.json could not be read})" ;;
      esac
      if [ -n "$cikti" ]; then
        printf '%s\n' "$cikti" | tail -n 8 | sed 's/^/      /' || true
      fi
      ;;
  esac
  return 0
}

# saglik_bekle: restart sonrası panel ACTIVE + /healthz bekler; 0 = sağlıklı.
# 🔴 SON-OPS-1: pencere eskiden 6×2 sn ≈ 12 sn idi. Yeni ikili ListenAndServe'den ÖNCE
# açılış Heal'lerini koşar (kapı uzlaştırması: SELinux etiket denetimi, nginx -t /
# reload / dinleme ölçümü; ilk kurulumda migration'lar); o sürede /healthz'e yanıt veren
# YOKTUR. Sağlıklı bir güncelleme "sağlıksız" sayılıp GERİ ALINIYORDU (ikili + DB: dump
# ile restart arasındaki yazmalar kaybolur) ve her yeniden denemede aynısı oluyordu.
# Şimdi en fazla SAGLIK_SN (120) sn; başarıda HEMEN çıkar.
# Çöküş döngüsü yine yakalanır: birim Restart=always → çöken süreç yeniden başlar ve
# NRestarts artar. Artış RAPORLANIR ve süreç ancak SAGLIK_KARARLI ardışık yoklamada
# (≈10 sn) yeniden başlamadan /healthz verirse sağlıklı sayılır — arada bir yanıt
# veren çöküş döngüsü uzun pencerede "sağlıklı" geçmesin. Süre dolarsa 1 → geri alma.
saglik_bekle() {
  local bas son nr0 nr nr_son yb=0 kararli=0
  bas=$SECONDS; son=$((SECONDS + SAGLIK_SN))
  nr0=$(systemctl show -p NRestarts --value girginospanel 2>/dev/null) || nr0=""
  case "$nr0" in ''|*[!0-9]*) nr0="" ;; esac
  nr_son=$nr0
  echo "  waiting for /healthz (up to ${SAGLIK_SN} s — the startup reconcile runs before ListenAndServe)…"
  while [ "$SECONDS" -lt "$son" ]; do
    sleep 2
    if [ -n "$nr0" ]; then
      nr=$(systemctl show -p NRestarts --value girginospanel 2>/dev/null) || nr=""
      case "$nr" in ''|*[!0-9]*) nr="" ;; esac
      if [ -n "$nr" ] && [ "$nr" != "$nr_son" ]; then
        # ilk yeniden başlamada uyar (döngüde her turda satır basma; toplam sonda raporlanır)
        if [ "$yb" = 0 ]; then
          warn "panel process RESTARTED while waiting (NRestarts $nr0 → $nr) — it may be crashing: journalctl -u girginospanel -n 40"
        fi
        nr_son=$nr; yb=1; kararli=0
      fi
    fi
    if systemctl is-active --quiet girginospanel && curl -fsS --max-time 5 "$PANEL_HEALTH" >/dev/null 2>&1; then
      if [ "$yb" = 0 ]; then
        SAGLIK_GECEN=$((SECONDS - bas)); return 0
      fi
      kararli=$((kararli + 1))
      if [ "$kararli" -ge "$SAGLIK_KARARLI" ]; then
        SAGLIK_GECEN=$((SECONDS - bas))
        warn "panel crashed and restarted while waiting (NRestarts $nr0 → $nr_son), then stayed stable for ${SAGLIK_KARARLI} consecutive probes — counted as healthy; cause: journalctl -u girginospanel -n 80"
        return 0
      fi
    else
      kararli=0
    fi
  done
  SAGLIK_GECEN=$((SECONDS - bas))
  if [ "$yb" = 1 ]; then
    warn "panel did not start stably within ${SAGLIK_GECEN} s and crashed and restarted during the wait (NRestarts $nr0 → $nr_son) — crash loop"
  else
    warn "panel was not ACTIVE + answering /healthz within ${SAGLIK_GECEN} s ($PANEL_HEALTH)"
  fi
  return 1
}

# ftp_servis_canlandir: pure-ftpd ETKİN (enabled) ama ÇALIŞMIYORSA başlatmayı dener ve
# sonucu uyarıyla raporlar. 🔴 FTP-1: 181'de pure-ftpd 3 hafta DURDU (enabled ama
# inactive, çıkış 0 — yedek-offsite FTP testi servisi durdurup geri başlatmamıştı); 11a
# yalnız MYSQLCrypt'e bakıyor, dogrula'da FTP denetimi yoktu → kimse görmedi.
# Bilerek kapatılmış kurulum (disabled / masked), static/indirect birim ve pure-ftpd'siz
# sunucu: DOKUNULMAZ. Güncellemeyi ASLA durdurmaz (her yolda 0; set -e altında her komut
# koşul içinde ya da korumalı).
ftp_servis_canlandir() {
  local en
  en=$(systemctl is-enabled pure-ftpd 2>/dev/null || true)
  en=${en%%$'\n'*}
  case "$en" in
    enabled|enabled-runtime) : ;;
    *) return 0 ;;
  esac
  if systemctl is-active --quiet pure-ftpd; then return 0; fi
  if systemctl start pure-ftpd >/dev/null 2>&1; then
    sleep 1   # hemen çöken süreci "başladı" sayma (ftp-setup ile aynı bekleme)
  fi
  if systemctl is-active --quiet pure-ftpd; then
    warn "pure-ftpd is enabled but was NOT RUNNING — started it; ALL FTP logins failed during that time (cause: journalctl -u pure-ftpd -n 40)"
  else
    warn "pure-ftpd is enabled but NOT RUNNING and could not be started — ALL FTP logins fail; manually: systemctl start pure-ftpd · journalctl -u pure-ftpd -n 40"
  fi
  return 0
}

[ "$(id -u)" = 0 ] || die "root required (sudo girginospanel-update)"
[ -x "$BIN" ] || die "GirginOSPanel is not installed ($BIN missing) — run install.sh first"
command -v curl >/dev/null || die "curl required"
command -v tar  >/dev/null || die "tar required"

step "GirginOSPanel update"

# 1) indir
TMP=$(mktemp -d); trap 'rm -rf "$TMP"' EXIT

# Kendini guncelleyip yeniden calisan surum, ustteki surumun indirdigi
# paketi devralir — ayni dosyayi iki kez indirmenin anlami yok.
DEVRALINDI=0
if [ -n "${GOSP_HAZIR_PAKET:-}" ] && [ -d "${GOSP_HAZIR_PAKET:-}" ]; then
  rm -rf "$TMP"
  TMP="$GOSP_HAZIR_PAKET"
  trap 'rm -rf "$TMP"' EXIT
  DEVRALINDI=1
  echo "  package taken over (not downloaded again)"
fi

[ "$DEVRALINDI" = 1 ] || echo "  downloading…"
# ══════════════════════════════════════════════════════════════════
# KAYNAK: YALNIZ KENDI ALTYAPIMIZ
#
# 🔴 GitHub artik varsayilan yolda DEGIL. Iki kez musteri sunucusu
# kilitledi: codeload 429 (panel guncellemesi hic inmedi) ve
# raw.githubusercontent 429/503 (wp-cli inmedi, WordPress calisma
# aninda patladi). Kimliksiz GitHub indirmeleri IP basina hiz sinirli
# ve bunu bizim kontrol edebilecegimiz bir yani yok.
#
# AYNALAR: bosluklu liste, SIRAYLA denenir. Yeni bir ayna eklemek tek
# satir; boylece tek sunucuya bagimlilik ileride kolayca kirilir.
# surum.girginos.io Cloudflare arkasinda oldugu icin origin blip'lerini
# CDN katmani zaten yutuyor.
#
# GitHub yalnizca ACIKCA istenirse denenir:  GOSP_GITHUB_YEDEK=1
# ══════════════════════════════════════════════════════════════════
AYNALAR=${GOSP_AYNALAR:-${GOSP_TABAN:-https://surum.girginos.io/panel}}

indir_aynadan() {   # $1 = taban URL
  local taban="$1" latest paket bek ger
  latest=$(curl -fsSL --max-time 60 "$taban/latest.txt" 2>/dev/null) || {
    echo "  $taban → could not fetch version info"; return 1; }
  paket=$(printf '%s' "$latest" | awk -F': ' '/^paket:/{print $2}')
  bek=$(printf '%s'  "$latest" | awk -F': ' '/^sha256:/{print $2}')
  if [ -z "$paket" ] || [ -z "$bek" ]; then
    echo "  $taban → latest.txt incomplete (package/sha256 missing)"; return 1; fi
  curl -fsSL --max-time 900 -o "$TMP/paket.tgz" "$taban/$paket" 2>/dev/null || {
    echo "  $taban → package download failed"; return 1; }
  ger=$(sha256sum "$TMP/paket.tgz" | cut -d' ' -f1)
  if [ "$ger" != "$bek" ]; then
    echo "  $taban → sha256 MISMATCH (expected ${bek:0:16}…, got ${ger:0:16}…)"
    return 1
  fi
  tar xzf "$TMP/paket.tgz" -C "$TMP" 2>/dev/null || {
    echo "  $taban → could not extract archive"; return 1; }
  echo "  source: $taban ($paket, sha256 verified)"
  return 0
}

# Opsiyonel acil yedek — VARSAYILAN OLARAK KAPALI.
indir_github() {
  local kod
  kod=$(curl -sSL -w '%{http_code}' -o "$TMP/github.tgz" --max-time 900 \
        "https://codeload.github.com/$REPO/tar.gz/refs/heads/$BRANCH" 2>/dev/null)
  case "$kod" in
    200) tar xzf "$TMP/github.tgz" -C "$TMP" 2>/dev/null || return 1
         echo "  source: github.com/$REPO@$BRANCH (emergency fallback)"; return 0 ;;
    429) echo "  GitHub rate limit (429)"; return 1 ;;
    404) echo "  GitHub 404 — repo/branch not found"; return 1 ;;
    "")  echo "  could not reach GitHub (network/DNS)"; return 1 ;;
    *)   echo "  GitHub HTTP $kod"; return 1 ;;
  esac
}

if [ "$DEVRALINDI" = 0 ]; then
  INDI=0
  for _ayna in $AYNALAR; do
    if indir_aynadan "$_ayna"; then INDI=1; break; fi
  done
  if [ "$INDI" = 0 ] && [ "${GOSP_GITHUB_YEDEK:-0}" = "1" ]; then
    echo "  mirrors unavailable, trying the GitHub emergency fallback…"
    indir_github && INDI=1
  fi
  if [ "$INDI" = 0 ]; then
    die "update download failed — mirrors tried: $AYNALAR
     Check network/DNS and try again. In an emergency, the GitHub fallback:
       GOSP_GITHUB_YEDEK=1 girginospanel-update
     To use a different mirror:
       GOSP_AYNALAR='https://ayna2.example/panel' girginospanel-update"
  fi
fi

# 🔴 Dizin adi kaynaga gore DEGISIR: GitHub tarball'i "gpanel-main/",
# kendi paketimiz "gpanel-installer/" olarak acilir. Sabit isim yerine
# assets/girginospanel-server'i ARAYARAK bul; iki duzen de calisir.
NEWBIN=$(find "$TMP" -maxdepth 3 -type f -name girginospanel-server -path '*/assets/*' ! -path '*/assets/ops/*' 2>/dev/null | head -1)
[ -n "$NEWBIN" ] || die "assets/girginospanel-server missing in the package (unexpected layout)"
A=$(dirname "$NEWBIN")
SRC=$(dirname "$A")

# 🔴 GERİ DÖNÜŞ KAPISI — kendini güncellemeden ÖNCE: daha eski bir paketin (eski)
# updater'ı bu denetimi bilmez; şu an koşan (kurulu) updater paketi burada süzer.
geri_donus_kapisi "$A"

# ── Kendini ONCE guncelle ──────────────────────────────────────────
# 🔴 Eskiden updater kendini adim 9'da, yani TUM isi bitirdikten SONRA
# guncelliyordu. Sonuc: yeni surumdeki duzeltmeler ancak BIR SONRAKI
# kosuda devreye giriyordu. Bu iki kez canimizi yakti — port-swap
# helper'i ilk guncellemede hep eksik kaldi, ve GitHub 429 duzeltmesi
# tam da onu indirmesi gereken updater'a ulasamadi (tavuk-yumurta).
# Artik: paket dogrulandiktan HEMEN sonra kendini kurar ve YENI surumle
# yeniden calisir; boylece guncellemeyi her zaman EN GUNCEL mantik yurutur.
# 🔴 DERLEME MAKINESI KORUMASI: kaynak agaci varsa burasi gelistirme
# makinesidir ve /usr/local/bin'deki surum YAYINDAKINDEN YENI olabilir.
# Kendini guncellersek yerel degisiklik sessizce geri alinir (iki kez
# yasandi: AYNALAR yamasi boyle kayboldu).
if [ -f /root/gpanel-temiz/assets/ops/girginospanel-update ]; then
  echo "  build machine — the updater does not self-update (local version kept)"
  GOSP_SELF_GUNCEL=1
fi
SELF_KURULU=/usr/local/bin/girginospanel-update
SELF_YENI="$A/ops/girginospanel-update"
if [ -z "${GOSP_SELF_GUNCEL:-}" ] && [ ! -f "$SELF_YENI" ]; then
  warn "ops/girginospanel-update missing in the package — the updater cannot self-update"
fi
if [ -z "${GOSP_SELF_GUNCEL:-}" ] && [ -f "$SELF_YENI" ] && [ -f "$SELF_KURULU" ] \
   && ! cmp -s "$SELF_YENI" "$SELF_KURULU"; then
  install -m 0755 "$SELF_YENI" "$SELF_KURULU" \
    || die "updater could not update itself ($SELF_KURULU is not writable)"
  ok "updater switched to the new version — the update continues with the new logic"
  trap - EXIT                       # paketi silme: yeni surum devralacak
  GOSP_SELF_GUNCEL=1 GOSP_HAZIR_PAKET="$TMP" exec "$SELF_KURULU" "$@"
fi

# 2) yeni binary'yi ÇALIŞTIRMADAN doğrula (ELF header) + değişiklik tespiti.
# ÖNEMLİ: sadece binary'yi değil TÜM release'i (binary + frontend-dist + migrations)
# hash'le. Aksi halde frontend-only / migration-only bir güncellemede binary sha
# aynı kaldığı için güncelleme yanlışlıkla ATLANIRDI.
head -c4 "$NEWBIN" | grep -q $'\x7fELF' || die "downloaded binary is not a valid ELF — aborting"
CURVER=$(surum); [ -n "$CURVER" ] || CURVER="?"
echo "  current version: $CURVER"
# NOT: her sha256sum'u cut ile SADECE hash'e indir — aksi halde çıktıdaki (rastgele
# tmp) dosya yolu RELHASH'i her çalıştırmada değiştirir ve no-op asla çalışmazdı.
RELHASH=$( { sha256sum "$NEWBIN" | cut -d' ' -f1
  [ -f "$A/frontend-dist.tar.gz" ] && sha256sum "$A/frontend-dist.tar.gz" | cut -d' ' -f1
  [ -f "$A/migrations.tar.gz" ] && sha256sum "$A/migrations.tar.gz" | cut -d' ' -f1
  # ops/ + systemd/ de hash'e DAHİL: aksi halde yalnızca script/unit değişen bir sürümde
  # (ör. DB yedek aracı + timer'ın eklenmesi) RELHASH sabit kalır ve güncelleme "zaten
  # en güncel" deyip sessizce ATLANIRDI — düzeltme sunucuya hiç ulaşmazdı.
  # LC_ALL=C sort: dosya sırası deterministik olmalı, yoksa hash her çalıştırmada oynar.
  find "$A/ops" "$A/systemd" -type f 2>/dev/null | LC_ALL=C sort \
    | xargs -r sha256sum 2>/dev/null | cut -d' ' -f1
  true; } | sha256sum | cut -d' ' -f1)
MARKER="$PREFIX/.release_hash"
CURREL=$(cat "$MARKER" 2>/dev/null || echo yok)
if [ "$RELHASH" = "$CURREL" ] && [ "$FORCE" = 0 ]; then
  ok "already up to date (release hash matched) — nothing to do (use --force to force)"
  exit 0
fi

if [ "$DRY" = 1 ]; then
  step "DRY-RUN — what would change (nothing applied)"
  echo "  • $BIN  (if the binary changed: swap + backup $BIN.bak)"
  echo "  • $FDIST/  (frontend-dist is rewritten)"
  echo "  • $MIGR/  (new .sql files are added, existing ones are kept)"
  echo "  • /usr/local/bin ops tools + $SCRIPTS"
  echo "  • $DBBK + /etc/systemd/system/girginospanel-db-backup.{service,timer} (timer enable --now)"
  echo "  • panel DB dump BEFORE migrations → $DBDIR  (NO dump is taken in DRY-RUN)"
  echo "  • if kapi.json exists, BEFORE restart: girginospanel-server kapi selinux (gate ports → http_port_t)"
  echo "  • the panel unit switches to LoadCredential (girginospanel-sir birim; secrets stay out of the process environment)"
  echo "  • systemctl restart girginospanel  (env/DB/sites PRESERVED; waits up to ${SAGLIK_SN} s for /healthz)"
  [ -f /var/lib/girginospanel/sir-yenile-2026-10 ] || echo "  • ONE-TIME secret rotation (JWT/DB/Valkey; sessions are dropped): girginospanel-server sir yenile --hepsi"
  exit 0
fi

# 3) DB yedek aracı + günlük timer'ı kur.
# SIRA ÖNEMLİ: dump'ı adım 4'te alacağız, aracın o an KURULU olması şart. Adım 9'daki
# genel ops döngüsü çok geç kalıyor (migration'lar adım 6'da çoktan açılmış olurdu) ve
# aracı hiç olmayan eski kurulumlarda dump imkânsız olurdu. Burada yalnızca db-backup'ı
# kuruyoruz — çalışan updater'ın kendi dosyasını bu noktada ezmiyoruz (bash script'i
# satır satır okur; kendini ortasından değiştirmek tehlikeli), o iş adım 9'da kalıyor.
if [ -f "$A/ops/girginospanel-db-backup" ]; then
  install -m 0755 "$A/ops/girginospanel-db-backup" "$DBBK"
  ok "DB backup tool installed ($DBBK)"
fi
# systemd unit'leri: dosyayı kopyalamak YETMEZ — daemon-reload + enable --now olmadan
# timer asla ateşlenmez (kurulumda unutulursa günlük yedek sessizce hiç çalışmaz).
UNITS=0
for u in girginospanel-db-backup.service girginospanel-db-backup.timer; do
  if [ -f "$A/systemd/$u" ]; then install -m 0644 "$A/systemd/$u" "/etc/systemd/system/$u"; UNITS=1; fi
done
if [ "$UNITS" = 1 ]; then
  systemctl daemon-reload >/dev/null 2>&1 || true
  systemctl enable --now girginospanel-db-backup.timer >/dev/null 2>&1 || true
  if systemctl is-active --quiet girginospanel-db-backup.timer; then
    ok "daily DB backup timer ACTIVE ($(systemctl show -p TimersCalendar --value girginospanel-db-backup.timer 2>/dev/null | grep -oE '[0-9]{2}:[0-9]{2}:[0-9]{2}' | head -1))"
  else
    warn "DB backup timer could not be started — the daily backup may not run"
  fi
fi

# Antivirüs birimleri: slice + izleyici + zamanlı tarama.
# 🔴 $A burada TANIMLI (dirname NEWBIN); yanlışlıkla dosya başına, $A/$TMP
# tanımlanmadan koymuştum ve birimler HİÇ kurulmuyordu (49'da doğrulandı).
if [ ! -f /etc/systemd/system/girginos-av.slice ]; then
  cat > /etc/systemd/system/girginos-av.slice <<'AVSLICE'
[Unit]
Description=GirginOSPanel antivirus scan slice
Before=slices.target
[Slice]
CPUAccounting=yes
MemoryAccounting=yes
IOAccounting=yes
CPUQuota=50%
MemoryMax=512M
IOWeight=50
TasksMax=64
AVSLICE
fi
AVUNITS=0
for u in girginospanel-avizle.service girginospanel-avsurec.service girginospanel-avtara.service girginospanel-avtara.timer; do
  if [ -f "$A/systemd/$u" ]; then install -m 0644 "$A/systemd/$u" "/etc/systemd/system/$u"; AVUNITS=1; fi
done
if [ "$AVUNITS" = 1 ]; then
  systemctl daemon-reload >/dev/null 2>&1 || true
  # 🔴 Timer enable, ama izleyiciyi DEĞİŞTİRME: gercek_zamanli ayarına panel
  # karar verir (avayar.IzleyiciSenkron). Updater kullanıcının açtığını kapatmasın.
  systemctl enable girginospanel-avtara.timer >/dev/null 2>&1 || true
  systemctl is-active --quiet girginospanel-avtara.timer     && ok "antivirus scheduled-scan timer ACTIVE"     || systemctl enable --now girginospanel-avtara.timer >/dev/null 2>&1
fi

# 4) GÜNCELLEME ÖNCESİ DB DUMP — FAIL-CLOSED.
# Migration'lar geri alınamaz; yedeksiz migration kabul edilemez. Dump alınamıyorsa
# güncellemeye HİÇ BAŞLAMA (binary'ye, frontend'e, migration'lara dokunmadan çık).
step "Pre-update DB backup"
[ -x "$DBBK" ] || die "DB backup tool missing/not executable ($DBBK) — migration without a backup REFUSED, update not started"
PREDUMP=$("$DBBK") || die "pre-update DB backup FAILED — update not started (DB/binary untouched)"
[ -n "$PREDUMP" ] && [ -f "$PREDUMP" ] \
  || die "pre-update DB backup could not be verified (returned path empty or file missing) — update not started"
ok "pre-update dump: $PREDUMP ($(du -h "$PREDUMP" 2>/dev/null | cut -f1))"

# 5) yedek (binary + seed)
cp -f "$BIN" "$BIN.bak"
[ -x "$SEED" ] && cp -f "$SEED" "$SEED.bak" 2>/dev/null || true
ok "current binary backed up ($BIN.bak)"

# 6) binary swap (install = atomik replace; çalışan process eski inode'u restart'a kadar tutar — cp -f KULLANMA)
install -m 0755 "$NEWBIN" "$BIN"
[ -f "$A/girginospanel-seed-admin" ] && install -m 0755 "$A/girginospanel-seed-admin" "$SEED"
ok "binary updated"

# 🔴 Eklenti baslaticisi — sifreli eklentilerin ExecStart'i BUDUR.
# Panelle AYNI pakette gelir ve atomik kurulur (calisan surec eski inode'u
# tutar). Guncellenmezse: yeni panel duz ikiliyi silip ExecStart'i baslaticiya
# cevirir, baslatici eski/eksik olur ve eklenti bir daha acilmaz.
NEWBAS=$(find "$TMP" -maxdepth 3 -type f -name girginospanel-eklenti-baslatici -path '*/assets/*' ! -path '*/assets/ops/*' 2>/dev/null | head -1)
if [ -n "$NEWBAS" ]; then
  install -m 0755 "$NEWBAS" /opt/girginospanel/bin/girginospanel-eklenti-baslatici \
    && ok "plugin launcher updated" || warn "could not update the plugin launcher"
fi

# Antivirus ajani — server ile ayni turden binary. Pakette varsa atomik kur.
NEWAV=$(find "$TMP" -maxdepth 3 -type f -name girginospanel-avajan -path '*/assets/*' ! -path '*/assets/ops/*' 2>/dev/null | head -1)
if [ -n "$NEWAV" ]; then
  install -m 0755 "$NEWAV" /usr/local/bin/girginospanel-avajan || warn "avajan could not be updated"
  ok "antivirus agent updated"
fi

# Telegram destek ajani — panelden AYRI hizmet. Burada yalniz ikili atomik yazilir (calisan surec
# eski inode'u tutar); hizmet panel yeni ikiliyle SAGLIKLI acildiktan sonra (adim 11a) baslatilir.
NEWDA=$(find "$TMP" -maxdepth 3 -type f -name girginospanel-destek-ajan -path '*/assets/*' ! -path '*/assets/ops/*' 2>/dev/null | head -1)
if [ -n "$NEWDA" ]; then
  install -m 0755 "$NEWDA" /usr/local/bin/girginospanel-destek-ajan || warn "support agent could not be updated"
  DESTEK_AJAN_YENI=1
fi

# Eklenti YUKLERI (src/eklentiler) — installer bunu yapar, updater ESKIDEN
# YAPMIYORDU. Sonuc: guncellenen eski sunucularda whitelabel (panelle birlikte
# gelen ucretsiz eklenti) payload'i hic gelmiyor, panel 'Marka eklentisi dosyasi
# yok' ile kuramiyordu. Installer ile AYNI: tum agac 0700/0600 kopyalanir
# (ucretli ikili de 0600 = yalniz root; kapi license girilene dek KAPALI).
if [ -d "$A/eklentiler" ]; then
  mkdir -p /opt/girginospanel/src/eklentiler
  if cp -a "$A/eklentiler/." /opt/girginospanel/src/eklentiler/ 2>/dev/null; then
    chmod 0700 /opt/girginospanel/src/eklentiler 2>/dev/null
    find /opt/girginospanel/src/eklentiler -mindepth 1 -type d -exec chmod 0700 {} + 2>/dev/null
    find /opt/girginospanel/src/eklentiler -mindepth 1 -type f -exec chmod 0600 {} + 2>/dev/null
    # 🔴 KACAK/ARTIK DUZ-METIN UCRETLI IKILI TEMIZLIGI — GUNCELLEMEDE kendini duzeltir.
    # Ucretli eklenti (mail, calistirici) DUZ ELF olarak diskte ASLA kalmamali:
    # runtime .gosp dosyasini BELLEKTEN calistirir (cmd/gosp-baslatici), duz ELF
    # gerekmez. Ustteki cp -a ekler ama hedefteki fazlaligi SILMEZ; kapi-oncesi
    # kurulumdan kalan ya da kacak kopyalanan DUZ ELF boyle kaliyordu.
    for _u in mail calistirici; do
      for _b in /opt/girginospanel/src/eklentiler/$_u /opt/girginospanel/eklentiler/$_u; do
        if [ -f "$_b/girginospanel-eklenti-$_u" ]; then
          rm -f "$_b/girginospanel-eklenti-$_u" && ok "stray/leftover plain paid binary removed: $_u ($_b)"
        fi
      done
    done
    ok "plugin payloads updated (src/eklentiler)"
  else
    warn "plugin payloads could not be copied (can be added via whitelabel Install)"
  fi
fi

# 7) frontend-dist — ATOMİK + DOĞRULANMIŞ swap.
# Eski hata: `rm -rf "${FDIST:?}/"* && tar xzf ...` ÖNCE çalışan frontend'i siliyordu; extraction
# kesilir ya da flush olmadan reboot olursa → 0-byte dosyalar → BEYAZ EKRAN outage (geri dönüş YOK).
# Artık yeni sürüm ayrı bir geçici dizine açılır, bütünlüğü DOĞRULANIR, sonra atomik mv ile takas
# edilir. Bozuk/kesik extraction çalışan frontend'e ASLA dokunmaz.
if [ -f "$A/frontend-dist.tar.gz" ]; then
  FDNEW="${FDIST}.new.$$"
  # Bozuk extraction'da temizlik: geçici dizini sil + binary'yi (adım 6'da swap edilmişti) yedeğe
  # geri al ki başarısız güncelleme on-disk'te de tam no-op olsun. Servis HENÜZ restart edilmedi
  # (restart adım 11) → çalışan panel eski binary + eski frontend ile kesintisiz ayakta kalır.
  fdist_abort() {
    rm -rf "$FDNEW" 2>/dev/null || true
    install -m 0755 "$BIN.bak" "$BIN" 2>/dev/null || true
    [ -f "$SEED.bak" ] && install -m 0755 "$SEED.bak" "$SEED" 2>/dev/null || true
    command -v restorecon >/dev/null && restorecon "$BIN" >/dev/null 2>&1 || true
    die "$1"
  }
  rm -rf "$FDNEW"; mkdir -p "$FDNEW"
  if ! tar xzf "$A/frontend-dist.tar.gz" -C "$FDNEW"; then
    fdist_abort "frontend-dist extraction failed — current frontend + old binary KEPT"
  fi
  # bütünlük kapısı: index.html DOLU + en az bir JS bundle olmalı (0-byte/kesik tarball reddedilir)
  if [ ! -s "$FDNEW/index.html" ] || ! ls "$FDNEW"/assets/index-*.js >/dev/null 2>&1; then
    fdist_abort "frontend-dist is corrupt (index.html/JS empty or missing) — current frontend + old binary KEPT"
  fi
  rm -rf "${FDIST}.old"
  [ -d "$FDIST" ] && mv "$FDIST" "${FDIST}.old"
  mv "$FDNEW" "$FDIST"
  FDIST_TAKAS=1   # rollback ${FDIST}.old'u geri koyabilsin (bkz. frontend-geri bloğu)
  sync   # reboot-güvenli: delayed-alloc veri kaybını önlemek için diske flush et
  ok "frontend-dist updated (atomic verified swap)"
fi

# 8) migration'lar (idempotent — startup'ta uygulanır). Adım 4'te dump'ı ALDIK.
if [ -f "$A/migrations.tar.gz" ]; then
  # 🔴 Bu betikteki TEK korumasiz kritik komuttu. `set -e` altinda tar
  # duserse HICBIR kirmizi satir basilmaz (die cagrilmaz), saglik/rollback
  # blogu HIC calismaz ve yeni binary + yeni frontend diskte, eksik migration
  # ile kalir. Ilk reboot'ta panel bozuk semayla acilir.
  mkdir -p "$MIGR" || die "migration directory could not be created"
  goc_dizini_yedekle || true   # rollback için (bkz. goc-dizini-geri bloğu)
  tar xzf "$A/migrations.tar.gz" -C "$MIGR" || die "migration archive could not be extracted — binary/frontend must be rolled back: $BIN.bak"
  ok "migrations in sync ($(ls "$MIGR"/*.sql 2>/dev/null | wc -l) sql)"
fi

# 9) ops-tool'lar (updater kendini de günceller; db-backup adım 3'te zaten kuruldu — tekrar idempotent)
if [ -d "$A/ops" ]; then
  # 🔴 `.sh` uzantisi soyuldugu icin `X` ve `X.sh` AYNI hedefe kurulur ve
  # glob sirasi geregi sonuncusu kazanir. Sessizce yanlis dosyanin
  # kurulmasindansa durup soylemek dogrusu.
  IKIZ=""
  for t in "$A"/ops/*.sh; do
    [ -f "$t" ] || continue
    [ -f "${t%.sh}" ] && IKIZ="$IKIZ $(basename "${t%.sh}")"
  done
  [ -z "$IKIZ" ] || die "package contains .sh twins, ambiguous which one to install:$IKIZ"

  # 🔴 Hatalari YUTMA. Eskiden `install ... 2>/dev/null || true` idi:
  # disk dolu / salt-okunur / izin hatasinda arac kurulmuyor ama
  # guncelleme yine "✓ ops-tool'lar guncellendi" diyordu.
  # >>> ops-kur-dongusu
  OPS_HATA=""
  for t in "$A"/ops/*; do
    [ -f "$t" ] || continue
    bn=$(basename "$t")
    # 🔴 Artik/yedek dosyalar KURULMAZ. Bunlar BAYAT kod olur ve root
    # yetkisiyle /usr/local/bin e 0755 kurulursa yanlislikla calistirilabilir
    # (pakette girginospanel-repair.bak.<zaman> bulundu ve kuruluyordu).
    case "$bn" in *.bak|*.bak.*|*.orig|*.rej|*~) continue ;; esac
    case "$bn" in
      # Yapilandirma dosyalari /usr/local/bin'e 0755 ile KURULMAZ
      *.conf|*.service|*.timer) continue ;;
    esac
    # 🔴 IKILILER ops/ dongusunden KURULMAZ (2026-10-09 VPS provasi): ops/ altinda kalan bir ELF (elle
    # kurulu eski girginospanel-destek-ajan / -avajan kopyasi) bu dongude assets/ kokundeki TAZE ikilinin
    # USTUNE yaziliyordu -> guncellenen sunucu KVKK maskesiz destek ajani + bayat AV ajaniyla kaliyordu.
    # Ikililer yalniz assets/ kokunden kurulur (yukaridaki find adimlari).
    if [ "$(head -c4 "$t" | od -An -c | tr -d ' ')" = '177ELF' ]; then
      warn "ops/$bn is a BINARY — skipped (binaries install from the assets/ root; an ops/ copy goes stale)"
      continue
    fi
    install -m 0755 "$t" "/usr/local/bin/${bn%.sh}" || OPS_HATA="$OPS_HATA ${bn%.sh}"
  done
  [ -z "$OPS_HATA" ] || die "ops tools could not be installed:$OPS_HATA"
  # <<< ops-kur-dongusu

  mkdir -p "$SCRIPTS" || die "$SCRIPTS could not be created"
  cp "$A"/ops/* "$SCRIPTS/" || die "ops files could not be copied to $SCRIPTS"
  # 🔴 Panel helper-i TAM olarak /usr/local/sbin/girginospanel-port-swap.sh
  # yolunda arar (internal/portyonetim/degistir.go: BackendHelperYolu).
  # Yukaridaki dongu ".sh" uzantisini soyup /usr/local/bin'e attigi icin
  # ESLESMIYOR -> guncellenen sunucularda helper bayat kalir veya hic olmaz.
  if [ -f "$A/ops/girginospanel-port-swap.sh" ]; then
    install -D -m 0700 "$A/ops/girginospanel-port-swap.sh" \
      /usr/local/sbin/girginospanel-port-swap.sh \
      || die "port-swap helper could not be installed (/usr/local/sbin) — the panel cannot change ports"
    rm -f /usr/local/bin/girginospanel-port-swap 2>/dev/null || true
  fi
  ok "ops tools updated"
fi

# 9a) wp-cli heal — 🔴 updater eskiden wp-cli'a HIC dokunmuyordu, dolayisiyla
# kurulumda inmemis bir wp-cli'i olan sunucu kendini ASLA onaramiyordu
# (musteride tam olarak bu oldu: WordPress sayfasi "Could not open input
# file: /usr/local/bin/wp" veriyordu). Idempotent: calisan wp-cli'a dokunmaz.
if command -v girginospanel-wpcli-kur >/dev/null 2>&1; then
  girginospanel-wpcli-kur || warn "wp-cli could not be repaired — WordPress features will not work"
fi

# 9a2) WordPress on kosullari heal — SELinux kiraci dizin etiketleri +
# imagick. 🔴 Ikisi de eski kurulumlarda EKSIK; updater dokunmazsa sunucu
# kendini onaramaz (wp-cli ile birebir ayni arıza sinifi).
if command -v girginospanel-wp-onkosul >/dev/null 2>&1; then
  girginospanel-wp-onkosul || warn "WordPress prerequisites left incomplete"
fi

# ══════════════════════════════════════════════════════════════════════
# 🔴 HEDEFLI ONARIM — mevcut sunucularin KENDINI ONARMASI
# Installer adim 14'te `girginospanel-repair` calistiriyordu ama UPDATER
# CALISTIRMIYORDU. Sonuc: repair'e eklenen onarimlar yalnizca YENI kurulumlara
# gidiyor, mevcut filo hic almiyordu. Uc canli sunucuda birebir goruldu:
# guncelleme "tamam" dedi, kritik kontroller gecti, ama /var/cache/nginx 0700
# kaldi ve fastcgi_cache olu kalmaya devam etti.
#
# 🔴 CIPLAK `girginospanel-repair` CALISTIRMIYORUZ: o, kiraci izinlerini
# GEVSETMEK ister (chmod 711 /home/c_*, 755 public_html) oysa sertlestirilmis
# model 710/750. Yalnizca kiraci izin bitlerine DOKUNMAYAN bolumler:
#   nginx_cache      -> /var/cache/nginx ust dizin izni
#   selinux_temel    -> booleanlar + kalici fcontext kurallari + 10080 portu + sabit yol
#                       etiketleri (kurulumla AYNI rutin; eksik olani yazar, mod degistirmez)
#   docroot_selinux  -> yalnizca SELinux ETIKETI degistirir (canli sunucuda
#                       dogrulandi: 710/750 korundu, sadece etiket degisti)
#   mail_sieve       -> dovecot-pigeonhole + sieve teslim + forward envelope-from
#                       (kiraci izinlerine DOKUNMAZ: paket + dovecot config + restart)
# ══════════════════════════════════════════════════════════════════════
if command -v girginospanel-repair >/dev/null 2>&1; then
  if girginospanel-repair --only nginx_cache,selinux_temel,docroot_selinux,mail_sieve,backup_cron,sir_izin >/dev/null 2>&1; then
    ok "targeted repair (nginx cache + SELinux base + docroot SELinux + mail sieve + secret-file permissions)"
  else
    warn "targeted repair returned an error — manually: girginospanel-repair --only nginx_cache,selinux_temel,docroot_selinux,mail_sieve,backup_cron,sir_izin"
  fi
else
  warn "girginospanel-repair missing — cache/SELinux repair skipped"
fi

# 9b) WAF (ModSecurity + OWASP CRS) heal — IDEMPOTENT (her sey hazirsa saniyeler icinde ATLAR).
# nginx sürümü değişmişse connector'ı ABI için yeniden derler. nginx -t GATE + rollback icerir →
# ana nginx'i asla bozmaz. Modül yüklü değilse panel WAF'ı graceful atlar (site etkilenmez).
# 🔴 YALNIZ WAF ZATEN KURULUYSA: kurulum betiği WAF'ı varsayılan KURMAZ (--waf ile isteğe bağlı).
# Eskiden bu çağrı koşulsuzdu → WAF'ı hiç istememiş sunucuda her güncelleme libmodsecurity v3'ü
# KAYNAKTAN derliyordu (2 çekirdekte ~6 dk; prova: güncelleme 8 dk sürdü, 6'sı bu). Heal yalnız
# modül ya da ABI damgası VARSA anlamlı (nginx sürümü değiştiyse connector'ı yeniden derler).
if command -v girginospanel-waf-setup >/dev/null 2>&1; then
  if [ -f /usr/lib64/nginx/modules/ngx_http_modsecurity_module.so ] || [ -f /etc/nginx/modsec/.built_for_nginx ]; then
    girginospanel-waf-setup >/dev/null 2>&1 && ok "WAF infrastructure in sync (ModSecurity+CRS)" || warn "waf-setup skipped (WAF degrades gracefully without the module)"
  else
    ok "WAF not installed — skipped (optional: girginospanel-waf-setup)"
  fi
fi

# 10) izolasyon + araç prereq (eski kurulumlarda yoksa gelsin; idempotent) + SELinux context
command -v bwrap >/dev/null 2>&1 || dnf install -y bubblewrap >/dev/null 2>&1 || true
# acl (setfacl): per-user dosya izin modeli (nginx user-ACL) için ŞART — yoksa panel fail-safe
# grup=nginx moduna düşer. Idempotent.
command -v setfacl >/dev/null 2>&1 || dnf install -y acl >/dev/null 2>&1 || true
# RAR açıcı (dosya yöneticisi .rar extract): PRİMER bsdtar (libarchive, base repo, güvenilir
# RAR/RAR5 + path-traversal reddeder). 7z (7-Zip 26.02) RAR codec içermez → kullanılmaz.
if ! command -v bsdtar >/dev/null 2>&1 && ! command -v unar >/dev/null 2>&1 && ! command -v unrar >/dev/null 2>&1; then
  dnf install -y bsdtar >/dev/null 2>&1 || dnf install -y unar >/dev/null 2>&1 || dnf install -y unrar >/dev/null 2>&1 || true
fi
command -v restorecon >/dev/null && restorecon -R "$PREFIX/bin" "$FDIST" >/dev/null 2>&1 || true

# 10b) Disk kotası (XFS user quota) GRUB yapılandırma — 🔴 CANLI SUNUCU: OTO-REBOOT ETME.
# Kök fs XFS + noquota ise `rootflags=uquota`'yı /etc/default/grub'a idempotent yaz; kota ancak
# MOUNT anında (reboot ile) açılır. Reboot'u OPERATÖR zamanlar → sentinel dosyası + net uyarı
# bırak. Panel açılışındaki HealKotaOnStartup, fs kota aktif olduğunda limitleri kendi uygular.
command -v quota >/dev/null 2>&1 || dnf install -y quota xfsprogs >/dev/null 2>&1 || true
QROOTFS=$(findmnt -no FSTYPE / 2>/dev/null || echo "")
QROOTOPTS=$(findmnt -no OPTIONS / 2>/dev/null || echo "")
QSENTINEL=/etc/girginospanel/reboot-required-quota
if [ "$QROOTFS" = "xfs" ] && ! echo "$QROOTOPTS" | grep -qwE 'usrquota|uquota|quota'; then
  if ! grep -q 'rootflags=uquota' /etc/default/grub 2>/dev/null; then
    if grep -q '^GRUB_CMDLINE_LINUX=' /etc/default/grub 2>/dev/null; then
      sed -i 's/^\(GRUB_CMDLINE_LINUX="[^"]*\)"/\1 rootflags=uquota"/' /etc/default/grub
    else
      echo 'GRUB_CMDLINE_LINUX="rootflags=uquota"' >> /etc/default/grub
    fi
    command -v grubby >/dev/null 2>&1 && grubby --update-kernel=ALL --args="rootflags=uquota" >/dev/null 2>&1 || true
    grub2-mkconfig -o /boot/grub2/grub.cfg >/dev/null 2>&1 || true
    for cfg in /boot/efi/EFI/*/grub.cfg; do [ -f "$cfg" ] && grub2-mkconfig -o "$cfg" >/dev/null 2>&1 || true; done
  fi
  mkdir -p /etc/girginospanel
  echo "rootflags=uquota written to GRUB $(date -Is 2>/dev/null) — reboot pending" > "$QSENTINEL" 2>/dev/null || true
  warn "🔴 Disk quota written to GRUB — a one-time REBOOT is required to activate it (the operator schedules it on a live server). NO AUTO-REBOOT was performed."
elif [ "$QROOTFS" = "xfs" ]; then
  [ -f "$QSENTINEL" ] && rm -f "$QSENTINEL" 2>/dev/null && ok "disk quota active — reboot sentinel cleared" || ok "disk quota active (root XFS user quota)"
fi

# 10c) Rol kapıları (ADR-GP-001) — mevcut kurulumu KİLİTLENMESİZ geçir: admin / bayi /
# müşteri ayrı rastgele portlara alınır; bugünkü genel port(lar) "eski kapı" olur ve en
# az 60 gün VE admin yeni admin kapısından bir kez girene dek açık kalır. RESTART'TAN
# ÖNCE: yeni binary'nin açılış Heal'i uygular (tek restart). İdempotent (geçiş
# yapılmışsa dokunmaz); yalnız loopback'te dinleyen (erisim masaüstü) sunucu atlanır.
# 🔴 ROLLBACK: eski ikili kapi.json'u tanımaz AMA erisim/dogrula onu DOĞRUDAN okur ve
# sunucuyu kapı modunda sanır (dogrula olmayan kapıları ölçer, erisim admin kapısını
# "panel portu" alır). Bu yüzden kapi.json'u BU koşu yarattıysa KAPI_YENI=1 işaretlenir ve
# geri alma dalı onu kaldırır (yedekleyerek); önceden var olan kapi.json'a DOKUNULMAZ.
if [ ! -f "$KAPI_JSON" ]; then
  if "$BIN" kapi gecis >/dev/null 2>&1; then
    if [ -f "$KAPI_JSON" ]; then
      ok "role-gate transition prepared (applied at panel startup)"
    fi
  else
    warn "role-gate transition could not be prepared — the panel continues on a single port (later: girginospanel-server kapi gecis)"
  fi
  # Önceden yoktu; şimdi varsa BU koşu yarattı (gecis hata dönse bile yazmış olabilir).
  if [ -f "$KAPI_JSON" ]; then KAPI_YENI=1; fi
fi

# 10d) Kapı portlarının SELinux etiketi — 10c'den SONRA, restart'tan ÖNCE (SON-OPS-1).
# Yeni geçişin portları da, önceden kapı modundaki sunucunun portları da burada etiketlenir;
# açılış Heal'i yalnız önbelleği doğrular. Etiketlenemezse uyarır, güncellemeyi DURDURMAZ.
kapi_selinux_etiketle

# 10e) Panel sırları — KALICI DÜZEN (2026-10 sır sızıntısı). Birim env dosyasını
# EnvironmentFile ile DEĞİL LoadCredential ile verir: sırlar panel sürecinin ortamına
# HİÇ girmez (kiracı çocukları + /proc/<pid>/environ). env dosyasının BİÇİMİ ve YERİ
# DEĞİŞMEZ (yan araçlar aynen okur). Yeni ikili (adım 6) iki birimi de anlar; ESKİ ikili
# kimlikli birimle açılamaz → geri alma dalı birimi de geri koyar (SIR_BIRIM_YENI).
# Önkoşul düşerse (systemd<247, env yok/bozuk) birime dokunulmaz, eski birimle sürer.
if [ -f "$A/ops/girginospanel-sir" ]; then SIR_ARAC="$A/ops/girginospanel-sir"
else SIR_ARAC=$(command -v girginospanel-sir 2>/dev/null || true); fi
if [ -n "$SIR_ARAC" ]; then
  _sir_rc=0; bash "$SIR_ARAC" birim || _sir_rc=$?
  case "$_sir_rc" in
    0) SIR_BIRIM_YENI=1 ;;
    3) : ;;
    *) warn "panel unit could not be switched to LoadCredential — continuing with the old unit (secrets are removed from the environment at startup)" ;;
  esac
else
  warn "girginospanel-sir missing — panel unit not switched"
fi

# 11) yeniden başlat + sağlık kontrolü (başarısızsa binary + DB rollback)
step "Restarting"
systemctl restart girginospanel
HEALTHY=0
if saglik_bekle; then HEALTHY=1; fi

if [ "$HEALTHY" = 1 ]; then
  systemctl reload nginx >/dev/null 2>&1 || true
  echo "$RELHASH" > "$MARKER" 2>/dev/null || true   # bu release'i uygulandı olarak işaretle
  NEWVER=$(surum); [ -n "$NEWVER" ] || NEWVER="?"
  ok "panel ACTIVE + /healthz OK (${SAGLIK_GECEN:-?} s)"
  goc_dizini_temizle   # rollback gerekmedi: göç dizini yedeği bayat kalmasın
  # SELinux modu bildirimi: kurallar/etiketler HER modda yazılır (selinux_temel); burada yalnız mod
  # raporlanır, ASLA değiştirilmez.
  case "$(getenforce 2>/dev/null || echo Disabled)" in
    Enforcing)  ok "SELinux: Enforcing (labels and rules in place)" ;;
    Permissive) warn "SELinux: Permissive — rules are ready but nothing is blocked; Enforcing is recommended for production: setenforce 1 (persistent: SELINUX=enforcing in /etc/selinux/config)" ;;
    *)          warn "SELinux: Disabled — rules were written but are inactive; to enable: SELINUX=enforcing in /etc/selinux/config + touch /.autorelabel && reboot (full relabel)" ;;
  esac
  ok "resource limits are being applied from plans + existing sites are being moved SAFELY to per-tenant PHP-FPM isolation (self-check + auto-rollback) (in the background)"

  # 11a) TELEGRAM DESTEK AJANI — panelden AYRI hizmet. SIRA BİLİNÇLİ: yalnız panel yeni ikiliyle
  # SAĞLIKLI açıldıktan SONRA başlatılır/yeniden başlatılır. Eski panelin (gömülü ajanlı) süreci
  # restart'ta öldü; bu noktada aynı cihaz anahtarıyla merkeze bağlanan TEK ajan bu hizmettir
  # (ayrıca hizmet tek-örnek flock kilidiyle iki kopyaya karşı korunur). Ajanın hatası güncellemeyi
  # BAŞARISIZ saymaz: panel ajana bağımlı değil.
  if [ "$DESTEK_AJAN_YENI" = 1 ] && [ -f "$A/systemd/girginospanel-destek-ajan.service" ]; then
    install -m 0644 "$A/systemd/girginospanel-destek-ajan.service" /etc/systemd/system/girginospanel-destek-ajan.service \
      && systemctl daemon-reload >/dev/null 2>&1 || true
    systemctl enable girginospanel-destek-ajan >/dev/null 2>&1 || true
    systemctl restart girginospanel-destek-ajan >/dev/null 2>&1 || true
    sleep 2
    if systemctl is-active --quiet girginospanel-destek-ajan; then
      ok "Telegram support agent ACTIVE (separate from the panel)"
    else
      warn "Telegram support agent did not start (panel unaffected) — journalctl -u girginospanel-destek-ajan -n 40"
    fi
  fi

  # 11b) TEK SEFERLİK SIR YENİLEME — 2026-10 sızıntısı (JWT/DB/Redis sırları kiracı
  # süreçlerine geçebiliyordu): sızmış olabilecek değerler geçersiz kılınır. İşaret
  # dosyası yalnız BAŞARIDA yazılır (başarısızlık sonraki güncellemede yeniden denenir).
  # `sir yenile` kendi içinde işlemseldir: DB/Valkey/env adım adım doğrulanır, panel yeni
  # sırlarla sağlıklı açılmazsa HEPSİ eski sırlara döner → güncelleme KİLİTLENMEZ,
  # panel eski sırlarla çalışmaya devam eder. Atlamak: GOSP_SIR_YENILE=0.
  SIR_ISARET=/var/lib/girginospanel/sir-yenile-2026-10
  if [ ! -f "$SIR_ISARET" ] && [ "${GOSP_SIR_YENILE:-1}" != 0 ]; then
    step "Rotating panel secrets (one-time; all sessions are dropped)"
    _sy_rc=0
    "$BIN" sir yenile --hepsi --saglik-sn "$SAGLIK_SN" || _sy_rc=$?
    case "$_sy_rc" in
      0) { mkdir -p /var/lib/girginospanel && date -Is > "$SIR_ISARET"; } 2>/dev/null || warn "marker could not be written: $SIR_ISARET"; ok "panel secrets rotated (marker: $SIR_ISARET)" ;;
      3) warn "🔴 CRITICAL: secret rotation rollback is INCOMPLETE — journalctl -u girginospanel -n 60; then: girginospanel-server sir kurtar" ;;
      *) warn "secret rotation NOT applied (continuing with the old secrets; retried on the next update) — manually: girginospanel-server sir yenile --hepsi" ;;
    esac
  fi

  # 11a) FTP kimlik-modu uyumu (pure-ftpd MYSQLCrypt) — 🔴 updater eskiden FTP
  # config'ine HİÇ dokunmuyordu. Panel restart'ta sifreheal (cmd/server/sifreheal.go)
  # eski DÜZ-metin ftp_accounts.password_md5 satırlarını $6$ crypt hash'e çevirir; ama
  # /etc/pure-ftpd/pureftpd-mysql.conf MYSQLCrypt=cleartext kalırsa pure-ftpd girilen
  # parolayı $6$ hash string'iyle DÜZ-metin karşılaştırır → o sunucudaki TÜM müşteriler
  # 530 (331 user OK → 530); panel login FTP'den ayrı olduğu için sorun SESSİZ kalır.
  # Bu adım MYSQLCrypt'i GERÇEK at-rest formata hizalar (idempotent; MYSQLPassword /
  # .pfsql_pass KORUNUR — yalnız MYSQLCrypt satırı). sifreheal restart'tan SONRA koştuğu
  # için burada (panel ACTIVE sonrası) password_md5 zaten $6$'dır.
  PFCONF=/etc/pure-ftpd/pureftpd-mysql.conf
  if command -v mysql >/dev/null 2>&1 && [ -f "$PFCONF" ]; then
    _h6='$6$'
    _hn=$(mysql -N -e "SELECT COUNT(*) FROM panel.ftp_accounts WHERE status='active' AND password_md5 LIKE '${_h6}%'" 2>/dev/null) || _hn=0
    _pn=$(mysql -N -e "SELECT COUNT(*) FROM panel.ftp_accounts WHERE status='active' AND password_md5 <> '' AND password_md5 NOT LIKE '${_h6}%'" 2>/dev/null) || _pn=0
    case "$_hn" in ''|*[!0-9]*) _hn=0 ;; esac
    case "$_pn" in ''|*[!0-9]*) _pn=0 ;; esac
    # $6$ mevcut (ya da tablo boş) → crypt; TÜM aktif hesaplar düz-metin (sifreheal
    # koşmamış) → cleartext, çalışan düz-metin FTP'yi KIRMA.
    if [ "$_hn" -eq 0 ] && [ "$_pn" -gt 0 ]; then _want=cleartext; else _want=crypt; fi
    # set -e: okuma/yazma hatası güncellemeyi SESSİZCE bitirmesin (MARKER zaten yazıldı).
    _cur=$(awk 'tolower($1)=="mysqlcrypt"{print $2; exit}' "$PFCONF" 2>/dev/null) || _cur=""
    _yazildi=1
    if [ "$_cur" != "$_want" ]; then
      cp -a "$PFCONF" "$PFCONF.bak-$(date +%Y%m%d%H%M%S)" 2>/dev/null || true
      if grep -qiE '^[[:space:]]*MYSQLCrypt[[:space:]]' "$PFCONF"; then
        sed -ri "s/^([[:space:]]*MYSQLCrypt[[:space:]]+).*/\1$_want/" "$PFCONF" || _yazildi=0
      else
        printf 'MYSQLCrypt      %s\n' "$_want" >> "$PFCONF" || _yazildi=0
      fi
      if [ "$_yazildi" = 0 ]; then
        warn "could NOT write MYSQLCrypt $_want ($PFCONF) — FTP credential mode may stay mismatched; fix manually, then: systemctl restart pure-ftpd"
      elif systemctl is-active --quiet pure-ftpd; then
        systemctl restart pure-ftpd >/dev/null 2>&1 \
          && ok "FTP credential mode fixed: MYSQLCrypt ${_cur:-none} → $_want (pure-ftpd restarted)" \
          || warn "MYSQLCrypt $_want written but pure-ftpd restart FAILED — manually: systemctl restart pure-ftpd"
      else
        ok "FTP credential mode fixed: MYSQLCrypt ${_cur:-none} → $_want (pure-ftpd inactive)"
      fi
    else
      ok "FTP credential mode consistent (MYSQLCrypt=$_cur)"
    fi
  elif command -v mysql >/dev/null 2>&1 && command -v girginospanel-ftp-setup >/dev/null 2>&1; then
    # pureftpd-mysql.conf yok → tam kurulum (idempotent; .pfsql_pass varsa parola KORUNUR)
    girginospanel-ftp-setup >/dev/null 2>&1 \
      && ok "pure-ftpd config was missing → installed with girginospanel-ftp-setup" \
      || warn "pure-ftpd config missing + girginospanel-ftp-setup ERROR — manually: girginospanel-ftp-setup"
  fi
  # Kimlik modu hizalandıktan SONRA: etkin ama durmuş pure-ftpd'yi başlat (FTP-1).
  ftp_servis_canlandir

# 🔴 Guncelleme "tamam" demeden ONCE uretim davranisini olc. Eskiden
# updater servis ayakta diye tamam diyordu; wp-cli bozuk, SELinux
# etiketi yok, port 80 500 doner haldeyken bile "tamam" yaziyordu.
# 🔴 KAPI — uyari DEGIL. Installer bu sinyali sert kapi yapmisti ama
# updater'da yalnizca sari bir satira indirgemistim: hemen ardindan YESIL
# "Guncelleme tamam" basiliyor ve cikis kodu 0 oluyordu. Cron/otomasyon bunu
# "basarili" sayar. Ayni sinyal, ayni sonuc olmali.
DOGRULAMA_KODU=0
if command -v girginospanel-dogrula >/dev/null 2>&1; then
  echo
  girginospanel-dogrula --kisa || DOGRULAMA_KODU=$?
else
  # Arac yoksa "dogrulandi" sayilamaz.
  warn "girginospanel-dogrula missing — update NOT VERIFIED"
  DOGRULAMA_KODU=1
fi
if [ "$DOGRULAMA_KODU" -ne 0 ]; then
  die "update applied but VERIFICATION FAILED — fix the ✗ lines above, then: girginospanel-dogrula"
fi
  kapi_adresleri
  echo -e "${c_g}══ Update complete ($CURVER → $NEWVER) — env/DB/sites preserved ══${c_0}"
else
  warn "the new version did not start healthy — rolling back to the OLD binary + the pre-update DB"
  install -m 0755 "$BIN.bak" "$BIN"
  [ -f "$SEED.bak" ] && install -m 0755 "$SEED.bak" "$SEED" 2>/dev/null || true
  command -v restorecon >/dev/null && restorecon "$BIN" >/dev/null 2>&1 || true

  # DB'yi de geri yükle: yeni sürümün migration'ı şemayı değiştirmiş olabilir ve ESKİ
  # binary o şemayla çalışamaz → binary-only rollback yetmez. Panel şu an DURMUŞ
  # (restart sağlıksız kaldı) → geri yükleme sırasında yazma kaybı yok.
  # NOT: dump `--databases panel` ile alındı → her tablo için DROP+CREATE içerir; yeni
  # migration'ın EKLEDİĞİ tablolar dump'ta olmadığı için kalır (eski binary onları
  # görmez, zararsız). Kolon/veri değişiklikleri geri alınır.
  systemctl stop girginospanel >/dev/null 2>&1 || true

  # Göç dizinini güncelleme öncesine döndür: yoksa ESKİ ikili açılırken bu güncellemenin göç
  # dosyalarını geri alınmış DB'ye yeniden uygular (bkz. goc-dizini-geri bloğu). Geri alma
  # başarılıysa yedek artık gereksiz (bayat .bak kalmasın); başarısızsa elle kurtarma için durur.
  goc_dizini_geri_al && goc_dizini_temizle || true

  # Arayüz de güncelleme öncesine döner: ESKİ ikili + YENİ arayüz tutarsızdır (bkz. frontend-geri bloğu).
  frontend_geri_al || true

  # 10e'nin geçirdiği birimi geri koy: ESKİ ikili kimlikli birimle açılamaz (sırları
  # yalnız ortamdan okur). env dosyası hiç değişmedi → eski birim + eski ikili tam eski hal.
  if [ "$SIR_BIRIM_YENI" = 1 ] && [ -n "$SIR_ARAC" ]; then
    bash "$SIR_ARAC" birim-geri || warn "panel unit could not be restored — manually: girginospanel-sir birim-geri"
  fi

  # 10c'nin BU koşuda yarattığı kapi.json'u geri al (panel DURMUŞKEN: yeni ikilinin
  # Heal'i dosyayı yeniden yazamasın). Önceden var olan kapi.json'a DOKUNULMAZ.
  # Yeni ikilinin Heal'i sağlık kontrolünden önce koştuysa nginx'teki rol listen'ları /
  # kapı başlığı (ve firewall'da açılan portlar) kalır: eski ikili başlığı yok sayar, o
  # portlar da aynı (kapısız) panele çıkar — tek-port davranışı.
  if [ "$KAPI_YENI" = 1 ] && [ -f "$KAPI_JSON" ]; then
    KAPI_GERI="$KAPI_JSON.geri-alindi.$(date +%Y%m%d%H%M%S)"
    if mv -f "$KAPI_JSON" "$KAPI_GERI"; then
      ok "kapi.json created by this update was rolled back (backup: $KAPI_GERI) — single-port behavior"
    else
      warn "kapi.json could not be rolled back — erisim/dogrula will assume gate mode; manually: mv $KAPI_JSON $KAPI_GERI"
    fi
  fi

  if [ -n "$PREDUMP" ] && [ -f "$PREDUMP" ]; then
    if zcat "$PREDUMP" | mysql; then
      ok "DB restored from the pre-update backup ($PREDUMP)"
      # Dump'ta olmayan (bu güncellemenin göçlerinin yarattığı) tablolar → yedekle + kaldır.
      yeni_tablolari_kenara_al "$PREDUMP" || true
    else
      warn "DB restore FAILED — the dump is still there, manually: zcat '$PREDUMP' | mysql"
    fi
  else
    warn "pre-update dump not found — only the binary was rolled back"
  fi

  systemctl restart girginospanel; sleep 3
  if systemctl is-active --quiet girginospanel; then
    die "rollback done — the panel is up on the OLD version + OLD DB. New-version error: journalctl -u girginospanel -n 40"
  else
    die "CRITICAL: the panel did not come up after the rollback either — journalctl -u girginospanel -n 40 (DB backup: $PREDUMP)"
  fi
fi
