#!/usr/bin/env bash
# girginospanel-waf-setup — ModSecurity v3 + OWASP CRS kurulumu (IDEMPOTENT).
#
#   girginospanel-waf-setup            # eksikleri kur; her sey hazirsa hizlica cik
#   girginospanel-waf-setup --force    # connector'i yeniden derle (nginx ABI degisti sansa karsi)
#   girginospanel-waf-setup --status   # yalniz durum raporu, degisiklik yapma
#
# NE YAPAR (yalniz eksik olani):
#   1) libmodsecurity v3 (yoksa kaynaktan derle → /usr/local/modsecurity)
#   2) ModSecurity-nginx connector'i CALISAN nginx surumuyle BIREBIR derle → dinamik .so
#   3) OWASP CRS + /etc/nginx/modsec konfigleri (modsecurity.conf, crs-setup.conf, main.conf)
#   4) Modulu nginx.conf MAIN-context'ine load_module ile yukle
#      🔴 nginx -t GATE + otomatik ROLLBACK: -t patlarsa nginx.conf geri alinir (TUM nginx
#         cokmesin). Modul yuklemek ZARARSIZDIR: bir vhost "modsecurity on" demedikce
#         davranis degismez → WAF per-domain opt-in (panel yonetir).
#
# KORUR: mevcut vhost'lar, siteler, CRS ozel kurallari. Yeniden calistirmak guvenli.
set -uo pipefail

# ---- sabitler ----
MODSEC_VER=v3.0.14
CONNECTOR_VER=v1.0.3
CRS_VER=v4.28.0
MODSEC_PREFIX=/usr/local/modsecurity
SRC=/usr/local/src
MODSEC_DIR=/etc/nginx/modsec
CRS_DIR=$MODSEC_DIR/crs
DOMAINS_DIR=$MODSEC_DIR/domains
MODULE_DIR=/usr/lib64/nginx/modules
MODULE=$MODULE_DIR/ngx_http_modsecurity_module.so
NGINX_CONF=/etc/nginx/nginx.conf
ABI_STAMP=$MODSEC_DIR/.built_for_nginx
AUDIT_LOG=/var/log/nginx/modsec_audit.log
WORK_DIR=/var/cache/nginx/modsec
LOADLINE="load_module $MODULE;"
MARK="# girginospanel-waf: ModSecurity modulu (main-context, per-domain opt-in)"

set -uo pipefail

kullanim() {
  cat <<'USAGE'
Usage: girginospanel-waf-setup [--force | --status]

Installs ModSecurity v3 + the OWASP Core Rule Set for nginx. Idempotent: only
what is missing is installed, and it exits quickly if everything is in place.
Run as root.

What it does (only the missing parts):
  1. Builds libmodsecurity v3 from source into /usr/local/modsecurity
  2. Builds the ModSecurity-nginx connector against the EXACT running nginx
     version as a dynamic module (.so)
  3. Installs OWASP CRS and the configs in /etc/nginx/modsec
  4. Adds load_module to the main context of nginx.conf, behind an nginx -t
     gate: if nginx -t fails, nginx.conf is rolled back. Loading the module is
     harmless: nothing changes until a vhost says "modsecurity on", so the WAF
     is opt-in per domain (managed from the panel).
  5. Turns on the SELinux boolean httpd_execmem (only if the WAF was installed)
Existing vhosts, sites and custom CRS rules are left alone.

Options:
  --force        Rebuild the connector (use after the nginx ABI changed)
  --status       Only print a status report, change nothing
  -h, --help     Show this help

Exit codes: 0 success / nothing to do, 1 failure (nginx.conf is rolled back if
nginx -t failed), 2 unknown option
USAGE
}

FORCE=0; STATUS=0
while [ $# -gt 0 ]; do
  case "$1" in
    --force) FORCE=1 ;;
    --status) STATUS=1 ;;
    -h|--help) kullanim; exit 0 ;;
    *) echo "unknown argument: $1" >&2; exit 2 ;;
  esac
  shift
done

c_b="\033[1;34m"; c_g="\033[32m"; c_r="\033[31m"; c_y="\033[33m"; c_0="\033[0m"
[ -t 1 ] || { c_b=; c_g=; c_r=; c_y=; c_0=; }
ok()   { echo -e "  ${c_g}✓${c_0} $*"; }
warn() { echo -e "  ${c_y}!${c_0} $*"; }
die()  { echo -e "${c_r}✗ $*${c_0}" >&2; exit 1; }
step() { echo -e "${c_b}══ $* ══${c_0}"; }

# SELinux: libmodsecurity (PCRE2 JIT) nginx (httpd_t) altinda her baslatma/reload'da `execmem` ister.
# `httpd_execmem` kapaliysa Enforcing'de AVC + JIT'siz yorumlayici (WAF yine calisir). Boolean bir
# guvenlik gevsetmesidir → yalniz WAF KURULDUYSA (bu betik) acilir; WAF kurulu degilse dokunulmaz.
# Yalniz modul kuruldu + nginx -t gate GECTIKTEN sonra cagrilir (rollback dalinda die ile cikilir,
# boolean'a hic dokunulmaz → geri alinacak bir sey kalmaz). Zaten aciksa yazmaz; hata kurulumu
# DUSURMEZ (uyari). SELinux Disabled/yok → sessiz gec. Modu (setenforce) DEGISTIRMEZ.
waf_selinux_execmem() {
  command -v getenforce >/dev/null 2>&1 || return 0
  case "$(getenforce 2>/dev/null)" in Enforcing|Permissive) ;; *) return 0 ;; esac
  if ! command -v getsebool >/dev/null 2>&1 || ! command -v setsebool >/dev/null 2>&1; then
    warn "getsebool/setsebool not found (policycoreutils) — httpd_execmem could not be checked (the WAF runs without JIT + execmem AVC at nginx start)"
    return 0
  fi
  local cur; cur=$(getsebool httpd_execmem 2>/dev/null)
  case "$cur" in
    *"--> on") ok "SELinux httpd_execmem is already on" ;;
    *"--> off")
      if setsebool -P httpd_execmem 1 >/dev/null 2>&1; then
        ok "SELinux httpd_execmem=on (persistent) — WAF PCRE2 JIT, no execmem AVC at nginx start"
      else
        warn "setsebool -P httpd_execmem 1 FAILED — the WAF runs without JIT + an execmem AVC at every nginx start (manually: setsebool -P httpd_execmem 1)"
      fi ;;
    *) warn "boolean httpd_execmem is not in the policy / could not be read — skipped" ;;
  esac
  return 0
}
# Test kancasi: GOSP_WAF_KUTUPHANE=1 ile `source` edilince yalniz fonksiyonlar yuklenir.
if [ "${GOSP_WAF_KUTUPHANE:-0}" = 1 ]; then return 0 2>/dev/null || exit 0; fi

[ "$(id -u)" = 0 ] || die "must be run as root"
command -v nginx >/dev/null || die "nginx not found"
NGVER=$(nginx -v 2>&1 | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1)
[ -n "$NGVER" ] || die "could not read the nginx version"

# Dizinleri erken olustur (ABI stamp connector adiminda buraya yazilir).
mkdir -p "$MODSEC_DIR" "$DOMAINS_DIR" "$WORK_DIR" "$MODULE_DIR"

# ---- durum ----
have_lib() { [ -e "$MODSEC_PREFIX/lib/libmodsecurity.so" ]; }
have_module() { [ -f "$MODULE" ]; }
abi_ok() { [ -f "$ABI_STAMP" ] && [ "$(cat "$ABI_STAMP" 2>/dev/null)" = "$NGVER" ]; }
have_crs() { [ -f "$CRS_DIR/crs-setup.conf" ] && [ -d "$CRS_DIR/rules" ]; }
module_loaded() { grep -qF "ngx_http_modsecurity_module.so" "$NGINX_CONF" 2>/dev/null; }

if [ "$STATUS" = 1 ]; then
  step "WAF status (nginx $NGVER)"
  have_lib     && ok "libmodsecurity: installed" || warn "libmodsecurity: MISSING"
  have_module  && ok "connector .so: installed ($(abi_ok && echo "ABI=$NGVER compatible" || echo "ABI stamp differs/missing"))" || warn "connector .so: MISSING"
  have_crs     && ok "OWASP CRS: installed" || warn "OWASP CRS: MISSING"
  module_loaded && ok "nginx.conf load_module: PRESENT" || warn "nginx.conf load_module: MISSING"
  exit 0
fi

step "GirginOSPanel WAF setup (ModSecurity $MODSEC_VER + CRS $CRS_VER, nginx $NGVER)"

# Her sey hazir + ABI uyumlu + zorlanmiyorsa → hizli cik (agir derleme atlanir).
if have_lib && have_module && abi_ok && have_crs && module_loaded && [ "$FORCE" = 0 ]; then
  ok "everything is in place + nginx ABI ($NGVER) compatible — nothing to do (rebuild with --force)"
  waf_selinux_execmem   # eski kurulum: boolean sonradan kapanmis/hic acilmamis olabilir (idempotent)
  exit 0
fi

# ---- 1) libmodsecurity (yoksa derle — AGIR) ----
if ! have_lib; then
  step "building libmodsecurity $MODSEC_VER (heavy, a few minutes)"
  dnf install -y gcc-c++ make automake libtool pkgconf-pkg-config flex bison wget git \
    libxml2-devel pcre2-devel libcurl-devel lmdb-devel openssl-devel >/dev/null 2>&1 || \
    warn "some dependencies could not be installed — the build will be attempted anyway"
  rm -rf "$SRC/ModSecurity"
  git clone -b "$MODSEC_VER" --depth 1 https://github.com/owasp-modsecurity/ModSecurity "$SRC/ModSecurity" \
    || die "could not clone ModSecurity"
  cd "$SRC/ModSecurity"
  git submodule update --init --recursive --depth 1 >/dev/null 2>&1 || warn "submodule warning"
  ./build.sh >/dev/null 2>&1 || die "build.sh failed"
  ./configure --prefix="$MODSEC_PREFIX" --with-pcre2 >/dev/null 2>&1 || die "configure failed (PCRE2)"
  make -j"$(nproc)" >/dev/null 2>&1 || die "libmodsecurity make failed"
  make install >/dev/null 2>&1 || die "libmodsecurity make install failed"
  ok "libmodsecurity installed ($MODSEC_PREFIX)"
else
  ok "libmodsecurity already installed ($MODSEC_PREFIX) — skipping"
fi

# runtime linker libmodsecurity.so.3'u bulabilsin (module dlopen + calisma zamani)
if [ ! -f /etc/ld.so.conf.d/modsecurity.conf ] || ! grep -q "$MODSEC_PREFIX/lib" /etc/ld.so.conf.d/modsecurity.conf 2>/dev/null; then
  echo "$MODSEC_PREFIX/lib" > /etc/ld.so.conf.d/modsecurity.conf
fi
ldconfig

# ---- 2) connector (.so) — CALISAN nginx surumuyle BIREBIR ----
if ! have_module || ! abi_ok || [ "$FORCE" = 1 ]; then
  step "building the ModSecurity-nginx connector (matching nginx $NGVER exactly)"
  dnf install -y gcc make wget git pcre2-devel zlib-devel openssl-devel >/dev/null 2>&1 || true
  [ -d "$SRC/ModSecurity-nginx" ] || \
    git clone -b "$CONNECTOR_VER" --depth 1 https://github.com/owasp-modsecurity/ModSecurity-nginx "$SRC/ModSecurity-nginx" \
      || die "could not clone ModSecurity-nginx"
  cd "$SRC"
  if [ ! -d "$SRC/nginx-$NGVER" ]; then
    wget -qO "$SRC/nginx-$NGVER.tar.gz" "https://nginx.org/download/nginx-$NGVER.tar.gz" \
      || die "could not download the nginx-$NGVER source"
    tar xzf "$SRC/nginx-$NGVER.tar.gz" -C "$SRC" || die "could not extract the nginx source"
  fi
  cd "$SRC/nginx-$NGVER"
  export MODSECURITY_INC="$MODSEC_PREFIX/include"
  export MODSECURITY_LIB="$MODSEC_PREFIX/lib"
  # 🔴 el10/GCC 14+: implicit-function-declaration ARTIK HATA. nginx'in ModSecurity-nginx
  # feature-probe'u <stdio.h>'suz printf() kullanir → probe HATA verir ve "ModSecurity library
  # ... not found" der (kutuphane VAR olsa bile). -Wno-error=... probe'u uyariya dusurur.
  ./configure --with-compat \
    --with-cc-opt="-Wno-error=implicit-function-declaration" \
    --add-dynamic-module=../ModSecurity-nginx >/tmp/waf-configure.log 2>&1 \
    || { tail -20 /tmp/waf-configure.log; die "connector configure failed (see /tmp/waf-configure.log)"; }
  make modules >/tmp/waf-make.log 2>&1 \
    || { tail -20 /tmp/waf-make.log; die "make modules failed (see /tmp/waf-make.log)"; }
  [ -f objs/ngx_http_modsecurity_module.so ] || die "module was not built"
  mkdir -p "$MODULE_DIR"
  install -m 0644 objs/ngx_http_modsecurity_module.so "$MODULE"
  strip "$MODULE" 2>/dev/null || true
  echo "$NGVER" > "$ABI_STAMP"
  ok "connector installed ($MODULE, $(du -h "$MODULE" | cut -f1), ABI=$NGVER)"
else
  ok "connector already installed + ABI ($NGVER) compatible — skipping"
fi

# ---- 3) /etc/nginx/modsec konfigleri + CRS ----
step "OWASP CRS + configs"
mkdir -p "$MODSEC_DIR" "$DOMAINS_DIR" "$WORK_DIR"

# CRS (yoksa klonla; VARSA ozel kurallari koru — dokunma)
if ! have_crs; then
  rm -rf "$CRS_DIR"
  git clone -b "$CRS_VER" --depth 1 https://github.com/coreruleset/coreruleset "$CRS_DIR" \
    || die "could not clone OWASP CRS"
  ok "CRS $CRS_VER cloned ($CRS_DIR)"
else
  ok "CRS already installed — kept"
fi
# crs-setup.conf (yoksa ornek dosyadan; paranoia SecAction'i ornekte VARSAYILAN yorumlu →
# per-domain conf id:900000 ile paranoia set eder, cakisma yok)
if [ ! -f "$CRS_DIR/crs-setup.conf" ]; then
  [ -f "$CRS_DIR/crs-setup.conf.example" ] && cp "$CRS_DIR/crs-setup.conf.example" "$CRS_DIR/crs-setup.conf" \
    || die "crs-setup.conf.example not found"
  ok "crs-setup.conf created"
fi

# modsecurity.conf (temel yapilandirma — per-domain SecRuleEngine BUNU override eder)
cat > "$MODSEC_DIR/modsecurity.conf" <<MODSECEOF
# GirginOSPanel — ModSecurity temel yapilandirmasi.
# NOT: SecRuleEngine burada DetectionOnly; per-domain conf (Include sonrasi) On/DetectionOnly
# olarak override eder → gercek mod her zaman panel ayarindan gelir.
SecRuleEngine DetectionOnly
SecRequestBodyAccess On
SecRequestBodyLimit 13107200
SecRequestBodyNoFilesLimit 131072
SecRequestBodyLimitAction Reject
SecRequestBodyJsonDepthLimit 512
SecResponseBodyAccess On
SecResponseBodyMimeType text/plain text/html text/xml application/json
SecResponseBodyLimit 1048576
SecResponseBodyLimitAction ProcessPartial
SecTmpDir $WORK_DIR
SecDataDir $WORK_DIR
SecAuditEngine RelevantOnly
SecAuditLogRelevantStatus "^(?:5|4(?!04))"
SecAuditLogParts ABIJDEFHZ
SecAuditLogType Serial
SecAuditLog $AUDIT_LOG
SecArgumentSeparator &
SecCookieFormat 0
SecStatusEngine Off
SecPcreMatchLimit 100000
SecPcreMatchLimitRecursion 100000
MODSECEOF

# main.conf — GLOBAL varsayilan referans paketi (per-domain conf'lar bunun parcalarini kullanir).
cat > "$MODSEC_DIR/main.conf" <<MAINEOF
# GirginOSPanel — WAF global referans (per-domain conf'lar /etc/nginx/modsec/domains/<sk>.conf).
# Bu dosya dogrudan bir vhost'a baglanmaz; tam kural paketini tek yerde gormek icindir.
Include $MODSEC_DIR/modsecurity.conf
Include $CRS_DIR/crs-setup.conf
Include $CRS_DIR/rules/*.conf
MAINEOF
ok "modsecurity.conf + main.conf written"

# audit log + work dir yazilabilir (nginx user) + SELinux context
[ -f "$AUDIT_LOG" ] || : > "$AUDIT_LOG"
chown nginx:nginx "$AUDIT_LOG" 2>/dev/null || true
chown -R nginx:nginx "$WORK_DIR" 2>/dev/null || true
chmod 0750 "$WORK_DIR" 2>/dev/null || true
if command -v getenforce >/dev/null 2>&1 && [ "$(getenforce)" != "Disabled" ]; then
  command -v restorecon >/dev/null 2>&1 && restorecon -R "$AUDIT_LOG" "$WORK_DIR" >/dev/null 2>&1 || true
  # nginx'in $WORK_DIR (cache_t) icine yazabilmesi zaten httpd_cache_t ile kaplidir.
fi

# ---- 4) modulu nginx.conf MAIN-context'ine yukle (nginx -t GATE + ROLLBACK) ----
step "Loading the module (nginx -t gate + rollback)"
if module_loaded; then
  ok "load_module already in nginx.conf — skipping"
else
  cp -a "$NGINX_CONF" "$NGINX_CONF.waf-bak"
  # include /usr/share/nginx/modules/*.conf; satirindan SONRA ekle; yoksa dosya basina.
  if grep -qE '^\s*include\s+/usr/share/nginx/modules/\*\.conf;' "$NGINX_CONF"; then
    # NOT: gawk 'load' builtin adini degisken olarak kullanamaz → 'loadln'.
    awk -v mark="$MARK" -v loadln="$LOADLINE" '
      { print }
      $0 ~ /include \/usr\/share\/nginx\/modules\/\*\.conf;/ && !d { print mark; print loadln; d=1 }
    ' "$NGINX_CONF" > "$NGINX_CONF.wafnew"
  else
    { echo "$MARK"; echo "$LOADLINE"; cat "$NGINX_CONF"; } > "$NGINX_CONF.wafnew"
  fi
  if ! grep -qF "ngx_http_modsecurity_module.so" "$NGINX_CONF.wafnew"; then
    rm -f "$NGINX_CONF.wafnew" "$NGINX_CONF.waf-bak"
    die "could not add the load_module line (unexpected nginx.conf structure) — left untouched"
  fi
  mv -f "$NGINX_CONF.wafnew" "$NGINX_CONF"
  if nginx -t >/tmp/waf-nginx-t.log 2>&1; then
    rm -f "$NGINX_CONF.waf-bak"
    systemctl reload nginx >/dev/null 2>&1 || true
    ok "module loaded + nginx -t OK + reload"
  else
    # 🔴 ROLLBACK: -t patladi → nginx.conf geri al (TUM nginx cokmesin)
    mv -f "$NGINX_CONF.waf-bak" "$NGINX_CONF"
    echo "---- nginx -t ----"; tail -15 /tmp/waf-nginx-t.log
    die "nginx -t FAILED — nginx.conf ROLLED BACK (nginx is healthy). Module not loaded."
  fi
fi

# son kontrol: main nginx hala -t OK olmali
if nginx -t >/dev/null 2>&1; then
  ok "main nginx -t OK — setup complete"
  waf_selinux_execmem
else
  die "unexpected: nginx -t failed after setup (check manually: nginx -t)"
fi

step "WAF infrastructure READY"
echo "  • Module loaded (per-domain opt-in) — existing sites were NOT affected."
echo "  • Panel: domain > Security > WAF to switch on/off + mode + paranoia."
