#!/usr/bin/env bash
# gpanel — GirginOSPanel yönetim CLI.
#
# Alt komut:
#   gpanel ip change <yeni-ip>                # eski IP otomatik bulunur
#   gpanel ip change <eski-ip> <yeni-ip>      # açık
#   gpanel ip change [--kuru] [--evet] ...    # DENEME / onaysız
#
# `ip change`: sunucunun ESKİ IP'sini YENİ IP ile değiştirir. gPanel IP'yi tek
# yerde tutmaz: DB (dns_records + domains ipv4/ftp_host/db_host + panelhost
# geçmişi), DNS zone dosyaları (+ SOA serial), nginx vhost'ları ve genel metin
# dosyaları (/etc, /opt/girginospanel, /var/named, /usr/local/{bin,sbin}).
# Yalnızca verilen TEK IP dizesini değiştirir; başka IP'lere dokunmaz. Önce
# yedek alır (/root/ipdegis-<ts>/), idempotenttir. --kuru ile önizlenir.
set -uo pipefail
# 🔴 Türkçe locale, [a-z] aralığını ve sayı eşlemesini bozar → LC_ALL=C ZORUNLU.
export LC_ALL=C

# ── Alt komut dağıtıcı ──────────────────────────────────────────────────────
kullanim() {
  cat <<'USAGE'
Usage: gpanel ip change [<old-ip>] <new-ip> [--kuru] [--evet]

Replaces the server's OLD IP with a NEW IP everywhere gPanel keeps it:
  - the database (dns_records, domains ipv4/ftp_host/db_host, panelhost history)
  - DNS zone files in /var/named (SOA serial is incremented)
  - nginx vhosts in /etc/nginx/conf.d
  - other text files under /etc, /opt/girginospanel, /var/named, /usr/local/{bin,sbin}
Only the given IP string is replaced; other IPs are untouched. A backup is
written to /root/ipdegis-<timestamp>/ first. Safe to re-run. Run as root.

Arguments:
  <old-ip>       IP to replace. Omit it and the most common IP in domains.ipv4
                 (other than <new-ip>) is used.
  <new-ip>       IP to put in its place

Options:
  --kuru         Dry run: show what would change, change nothing (also --dry-run)
  --evet         Do not ask for confirmation (also -y, --yes)
  -h, --help     Show this help

Exit codes: 0 done / nothing to do / cancelled, 1 old IP not found or MySQL
unreachable, 2 bad command, option or IP
USAGE
}
# ── IP eşleştirme yardımcıları (testler GOSP_GPANEL_KUTUPHANE=1 ile yükler) ──
# gecerli_ip — kesin IPv4: dört bölüm, her biri 0-255, başında sıfır yok (010 sekizlik
# mi ondalık mı belirsiz). Eskiden ^([0-9]{1,3}\.){3}[0-9]{1,3}$ idi: 999.1.1.1 geçiyordu.
gecerli_ip(){
  [[ "$1" =~ ^(0|[1-9][0-9]{0,2})\.(0|[1-9][0-9]{0,2})\.(0|[1-9][0-9]{0,2})\.(0|[1-9][0-9]{0,2})$ ]] || return 1
  local i
  for i in 1 2 3 4; do (( BASH_REMATCH[i] <= 255 )) || return 1; done
}
# ip_desen — IP'nin noktalarını sabitler: '.' regex'te jokerdir ("1.2.3.4" deseni
# "1x2y3z4" ile de eşleşirdi).
ip_desen(){ printf '%s' "${1//./[.]}"; }
# 🔴 SINIRLI EŞLEŞME: IP'nin önünde rakam/nokta, arkasında rakam ya da ".rakam" OLMAMALI.
# Eskiden alt dize arandı/değiştirildi (grep -F, sed s/IP/…/g, SQL REPLACE/LIKE):
# 1.2.3.4 değiştirilirken 11.2.3.45, 1.2.3.40 ya da sürüm numarası "1.2.3.4.5" de
# /etc, /opt/girginospanel, /var/named ve DB'de bozuluyordu.
# sinirli_ere — grep -E / sed -E için. Gruplar: 1=önek, 2=sonek (sed geri başvurusu).
sinirli_ere(){ printf '(^|[^0-9.])%s([^0-9.]|[.]([^0-9]|$)|$)' "$(ip_desen "$1")"; }
# sinirli_pcre — MariaDB REGEXP/REGEXP_REPLACE (PCRE) için; ters bölü yok (SQL kaçışı gerekmez).
sinirli_pcre(){ printf '(?<![0-9.])%s(?![0-9]|[.][0-9])' "$(ip_desen "$1")"; }
# dosyada_degistir <dosya> <eski> <yeni> — yalnız sınırlı eşleşmeleri değiştirir. Döngü
# (:a … ta): önek/sonek karakteri tükettiği için bitişik eşleşmeleri s///g atlardı.
dosyada_degistir(){ sed -E -i ":a;s/$(sinirli_ere "$2")/\1$3\2/;ta" "$1"; }
if [ "${GOSP_GPANEL_KUTUPHANE:-}" = 1 ]; then return 0 2>/dev/null || exit 0; fi

grup="${1:-}"; eylem="${2:-}"
case "$grup" in
  ""|-h|--help|yardim) kullanim; exit 0 ;;
esac
if [ "$grup" != "ip" ] || [ "$eylem" != "change" ]; then
  echo "Unknown command: '$grup ${eylem}'." >&2; kullanim >&2; exit 2
fi
shift 2   # "ip change" tüketildi; geri kalan argümanlar ip-change'e ait

DB=panel
ZONEDIZ=/var/named
NGINXDIZ=/etc/nginx/conf.d

KURU=0; EVET=0
args=()
for a in "$@"; do
  case "$a" in
    --kuru|--dry-run) KURU=1 ;;
    --evet|-y|--yes)  EVET=1 ;;
    -h|--help) kullanim; exit 0 ;;
    -*) echo "unknown option: $a" >&2; exit 2 ;;
    *) args+=("$a") ;;
  esac
done

mysql_calisir(){ mysql -N -e 'SELECT 1' >/dev/null 2>&1; }

# ── Argüman çözümleme ──────────────────────────────────────────────────────
if [ "${#args[@]}" -eq 2 ]; then
  ESKI="${args[0]}"; YENI="${args[1]}"
elif [ "${#args[@]}" -eq 1 ]; then
  YENI="${args[0]}"
  # Yeni IP SQL'e girmeden ÖNCE doğrulanır.
  gecerli_ip "$YENI" || { echo "ERROR: invalid new IP: $YENI" >&2; exit 2; }
  # Eski IP = domains.ipv4'te EN ÇOK geçen ve YENİ olmayan IP.
  ESKI=$(mysql -N "$DB" -e "SELECT ipv4 FROM domains WHERE ipv4<>'' AND ipv4<>'$YENI' GROUP BY ipv4 ORDER BY COUNT(*) DESC LIMIT 1" 2>/dev/null)
  if [ -z "$ESKI" ]; then
    echo "ERROR: could not detect the old IP automatically (the domains table may be empty). Give it explicitly:" >&2
    echo "  gpanel ip change <old-ip> <new-ip>" >&2
    exit 1
  fi
  echo "ℹ old IP detected automatically: $ESKI"
else
  kullanim >&2; exit 2
fi

gecerli_ip "$ESKI" || { echo "ERROR: invalid old IP: $ESKI" >&2; exit 2; }
gecerli_ip "$YENI" || { echo "ERROR: invalid new IP: $YENI" >&2; exit 2; }
[ "$ESKI" = "$YENI" ] || true
if [ "$ESKI" = "$YENI" ]; then echo "old and new IP are the same ($ESKI) — nothing to do."; exit 0; fi
mysql_calisir || { echo "ERROR: could not connect to MySQL (root socket)." >&2; exit 1; }
ERE=$(sinirli_ere "$ESKI"); PCRE=$(sinirli_pcre "$ESKI")

# ── Kapsam (neyin değişeceği) ──────────────────────────────────────────────
n_dns=$(mysql -N "$DB" -e "SELECT COUNT(*) FROM dns_records WHERE deger REGEXP '$PCRE'" 2>/dev/null)
# 🔴 domains'te IP birden fazla kolonda: ipv4 (sunucu IP), ftp_host, db_host.
# Yalnız ipv4'ü saymak/değiştirmek ftp_host'u eskide bırakıyordu (E2E testte
# yakalandı). Üçünü de kapsa.
n_dom=$(mysql -N "$DB" -e "SELECT COUNT(*) FROM domains WHERE ipv4 REGEXP '$PCRE' OR ftp_host REGEXP '$PCRE' OR db_host REGEXP '$PCRE'" 2>/dev/null)
n_zone=$(grep -lE "$ERE" "$ZONEDIZ"/*.zone 2>/dev/null | wc -l)
n_nginx=$(grep -lE "$ERE" "$NGINXDIZ"/*.conf 2>/dev/null | wc -l)
# 🔴 GENEL METİN-DOSYA taraması: rc.conf, yorumlar, aracın hedeflemediği HER
# text dosya. `grep -rI` binary dosyaları ATLAR (asla sed'lenmez → imzalı
# panel ikilisi güvende). Yedek/log/git hariç.
# 🔴 /var/log HARİÇ: geçmiş log kayıtlarını yeniden yazmak tahrifattır (ve
# anlamsız — rotate olup giderler). Yalnız KONFİG/servis dosyaları.
FS_HARIC='\.bak|\.yedek|/backups?/|/ipdegis-|/ipchange-|\.log$|\.log-|\.log\.|/var/log/|\.gz$|named\.run|/\.git/'
# /usr/local/bin + /usr/local/sbin dahil (ops scriptleri orada da kurulu;
# girginospanel-dogrula gibi). grep -rIl binary'yi atlar.
FS_KOK="/etc /opt/girginospanel /var/named /usr/local/bin /usr/local/sbin"
n_fs=$(grep -rIlE "$ERE" $FS_KOK 2>/dev/null | grep -vE "$FS_HARIC" | wc -l)
# Denetim geçmişi: geçmiş kaydı silmeyiz ama eski IP DİZESİNİ yenisiyle
# değiştiririz — "hiçbir yerde eski IP kalmasın" için (kayıt yapısı korunur).
n_audit=$(mysql -N "$DB" -e "SELECT COUNT(*) FROM cp_panelhost_gecmisi WHERE hostname REGEXP '$PCRE' OR adimlar_json REGEXP '$PCRE' OR hata REGEXP '$PCRE'" 2>/dev/null)

echo "────────────────────────────────────────────"
echo " OLD IP : $ESKI"
echo " NEW IP : $YENI"
echo " Will change:"
echo "   dns_records (DB) : $n_dns records"
echo "   domains (DB)     : $n_dom domains (ipv4/ftp_host/db_host)"
echo "   DNS zone files  : $n_zone (+ SOA serial incremented)"
echo "   nginx vhost      : $n_nginx files"
echo "   other text files: $n_fs (rc.conf/comments/etc.)"
echo "   panelhost history: ${n_audit:-0} records"
echo "────────────────────────────────────────────"

if [ $((n_dns+n_dom+n_zone+n_nginx+n_fs+${n_audit:-0})) -eq 0 ]; then
  echo "This IP was not found anywhere — nothing to change."; exit 0
fi
if [ "$KURU" = "1" ]; then echo "[--kuru] Dry run: nothing was changed."; exit 0; fi

# 🔴 Yeni IP gerçekten bir arayüzde mi? Değilse UYAR (engelleme — önceden hazırlanmış olabilir).
# grep -q DEĞİL: pipefail altında `ip` SIGPIPE ile ölür → IP arayüzdeyken yanlış uyarı.
if ! ip -4 addr 2>/dev/null | grep -E "$(sinirli_ere "$YENI")" >/dev/null; then
  echo "⚠ WARNING: $YENI does not appear on any network interface. The change will be made, but"
  echo "  the IP must be added to an interface before traffic can arrive."
fi

if [ "$EVET" != "1" ]; then
  read -r -p "Continue? (yes/no) " c
  case "$c" in evet|e|yes|y) ;; *) echo "cancelled."; exit 0 ;; esac
fi

# ── Yedek ──────────────────────────────────────────────────────────────────
TS=$(date +%Y%m%d-%H%M%S)
YD=/root/ipdegis-$TS
mkdir -p "$YD"
mysqldump --single-transaction "$DB" dns_records domains cp_panelhost_gecmisi > "$YD/db.sql" 2>/dev/null \
  && echo "✓ DB backup: $YD/db.sql"
# Değişecek genel metin dosyalarını da yedekle (rc.conf/yorum/vb).
FS_YEDEK=$(grep -rIlE "$ERE" $FS_KOK 2>/dev/null | grep -vE "$FS_HARIC")
tar czf "$YD/dosyalar.tar.gz" "$ZONEDIZ"/*.zone "$NGINXDIZ"/*.conf $FS_YEDEK 2>/dev/null \
  && echo "✓ file backup: $YD/dosyalar.tar.gz"

# ── 1) DB ───────────────────────────────────────────────────────────────────
mysql "$DB" <<SQL
UPDATE dns_records SET deger=REGEXP_REPLACE(deger,'$PCRE','$YENI'), updated_at=NOW() WHERE deger REGEXP '$PCRE';
UPDATE domains SET
  ipv4     = REGEXP_REPLACE(ipv4,     '$PCRE','$YENI'),
  ftp_host = REGEXP_REPLACE(ftp_host, '$PCRE','$YENI'),
  db_host  = REGEXP_REPLACE(db_host,  '$PCRE','$YENI')
 WHERE ipv4 REGEXP '$PCRE' OR ftp_host REGEXP '$PCRE' OR db_host REGEXP '$PCRE';
SQL
echo "✓ DB updated (dns_records + domains: ipv4/ftp_host/db_host)"

# ── 2) Zone dosyaları + SOA serial +1 ───────────────────────────────────────
z_degisen=0
for z in "$ZONEDIZ"/*.zone; do
  [ -e "$z" ] || continue
  grep -qE "$ERE" "$z" || continue
  dosyada_degistir "$z" "$ESKI" "$YENI"
  # SOA serial'i +1: format KORUNUR (yalnız ilk '; serial' satırındaki sayı
  # yerinde artar). perl varsa onu kullan (boşlukları bozmaz); yoksa awk
  # fallback (satır boşluklarını sıkıştırır ama BIND için geçerli kalır).
  if command -v perl >/dev/null 2>&1; then
    perl -i -pe 's/(\d{6,10})(\s*;\s*[Ss]erial)/($1+1).$2/e unless $d; $d=1 if /;\s*[Ss]erial/' "$z"
  else
    awk '!d && tolower($0) ~ /;[[:space:]]*serial/ { for(i=1;i<=NF;i++){ if($i ~ /^[0-9]{6,10}$/){ $i=$i+1; d=1; break } } } {print}' "$z" > "$z.tmp" && mv "$z.tmp" "$z"
  fi
  z_degisen=$((z_degisen+1))
done
echo "✓ $z_degisen zone file(s) updated (+ serial)"

# ── 3) nginx vhost'ları ──────────────────────────────────────────────────────
for f in "$NGINXDIZ"/*.conf; do
  [ -e "$f" ] || continue
  grep -qE "$ERE" "$f" || continue
  dosyada_degistir "$f" "$ESKI" "$YENI"
done
echo "✓ nginx vhosts updated"

# ── 3b) GENEL METİN-DOSYA taraması — kalan HER şey (rc.conf, yorumlar, vb) ───
# grep -rIl binary'yi atlar; zone/nginx zaten yukarıda yapıldı (burada 0 bulur).
fs_degisen=0
while IFS= read -r f; do
  [ -n "$f" ] || continue
  dosyada_degistir "$f" "$ESKI" "$YENI" && fs_degisen=$((fs_degisen+1))
done < <(grep -rIlE "$ERE" $FS_KOK 2>/dev/null | grep -vE "$FS_HARIC")
echo "✓ $fs_degisen text file(s) cleaned (rc.conf/comments/etc.)"

# ── 3c) panelhost geçmişi (denetim) — eski IP DİZESİNİ değiştir, kaydı koru ──
mysql "$DB" -e "UPDATE cp_panelhost_gecmisi SET
    hostname=REGEXP_REPLACE(hostname,'$PCRE','$YENI'),
    adimlar_json=REGEXP_REPLACE(adimlar_json,'$PCRE','$YENI'),
    hata=REGEXP_REPLACE(hata,'$PCRE','$YENI')
  WHERE hostname REGEXP '$PCRE' OR adimlar_json REGEXP '$PCRE' OR hata REGEXP '$PCRE';" 2>/dev/null \
  && echo "✓ old IP string updated in the panelhost history"

# ── 4) Servis reload ─────────────────────────────────────────────────────────
if nginx -t >/dev/null 2>&1; then
  nginx -s reload >/dev/null 2>&1 && echo "✓ nginx reload"
else
  echo "⚠ nginx -t reported an error — reload NOT performed. Check: nginx -t"
fi
if command -v rndc >/dev/null 2>&1; then
  rndc reload >/dev/null 2>&1 && echo "✓ named reload (rndc)"
else
  systemctl reload named >/dev/null 2>&1 && echo "✓ named reload"
fi

# ── 5) Doğrulama ─────────────────────────────────────────────────────────────
# 🔴 TÜM DB'yi tara (denetim geçmişi DAHİL — artık orası da temizlendi) +
# TÜM metin dosyalarını tara. Belirli kolon/dosya saymak ATLANANI gizler.
kalan_db=0
for t in $(mysql -N "$DB" -e "SHOW TABLES" 2>/dev/null); do
  h=$(mysqldump --no-create-info --skip-extended-insert "$DB" "$t" 2>/dev/null | grep -cE "$ERE")
  [ "${h:-0}" -gt 0 ] && { echo "   ⚠ DB table '$t' still contains $ESKI ($h)"; kalan_db=$((kalan_db+h)); }
done
# TÜM metin dosyaları (binary hariç — imzalı ikilideki şablon yorumu HARİÇ;
# o build artefaktıdır, kaynakta düzeltilir, sed'lenmez).
kalan_fs=$(grep -rIlE "$ERE" $FS_KOK 2>/dev/null | grep -vE "$FS_HARIC" | wc -l)
kalan_zone=$(grep -lE "$ERE" "$ZONEDIZ"/*.zone 2>/dev/null | wc -l)
bin_kalinti=$(grep -rlE "$ERE" $FS_KOK 2>/dev/null | grep -vE "$FS_HARIC" | while read -r b; do grep -qI . "$b" 2>/dev/null || echo "$b"; done | head -3)
echo "────────────────────────────────────────────"
echo " VERIFICATION:"
echo "   $ESKI left in the DB     : $kalan_db (should be 0, incl. audit history)"
echo "   left in text files     : $kalan_fs (should be 0)"
echo "   $ESKI left in zones    : $kalan_zone (should be 0)"
[ -n "$bin_kalinti" ] && echo "   ⚠ BINARY (not sed-edited, build artifact): $bin_kalinti"
ornek=$(mysql -N "$DB" -e "SELECT alan_adi FROM domains LIMIT 1" 2>/dev/null)
[ -n "$ornek" ] && echo "   dig $ornek @localhost : $(dig +short "$ornek" @127.0.0.1 2>/dev/null | tr '\n' ' ')"
echo " Backup: $YD"
echo "────────────────────────────────────────────"
if [ "${kalan_db:-1}" = "0" ] && [ "${kalan_zone:-1}" = "0" ] && [ "${kalan_fs:-1}" = "0" ]; then
  echo "✓ DONE: $ESKI → $YENI (DB + all text files clean)"
  [ -n "$bin_kalinti" ] && echo "  Note: only a template COMMENT inside the signed binary remains (not functional; fixed at the source)."
else
  echo "⚠ The old IP REMAINS in some places (see the ⚠ lines above) — check manually."
fi
