[Unit]
# GirginOSPanel antivirüs — süreç davranış izleyici (netlink proc connector).
# 🔴 Slice=girginos-av.slice: panelin kaynak dilimine katılır (CPU/RAM sınırı).
Description=GirginOSPanel antivirüs süreç davranış izleyici
After=network-online.target mariadb.service
Wants=mariadb.service

[Service]
Type=simple
Slice=girginos-av.slice
ExecStart=/usr/local/bin/girginospanel-avajan --surec
Restart=on-failure
RestartSec=10
# netlink proc connector → CAP_NET_ADMIN; başka uid'lerin /proc/<pid>/exe
# readlink'i → CAP_SYS_PTRACE (ptrace_may_access, DAC bypass ETMEZ); dosya
# okuma → CAP_DAC_READ_SEARCH. Karantina YOK (salt gözlem) → DAC_OVERRIDE/FOWNER YOK.
AmbientCapabilities=CAP_NET_ADMIN CAP_SYS_PTRACE CAP_DAC_READ_SEARCH
CapabilityBoundingSet=CAP_NET_ADMIN CAP_SYS_PTRACE CAP_DAC_READ_SEARCH
# 🔴 CAP_SYS_PTRACE yalnız çekirdek-içi readlink izin kontrolünü GEÇMEK için
# tutulur; ajan HİÇBİR ZAMAN ptrace() ÇAĞIRMAZ. @ptrace grubunu (ptrace,
# process_vm_readv/writev, kcmp) engelle → cap enjeksiyon silahı OLAMAZ.
# readlinkat @system-service içindedir → exe okuma çalışmaya devam eder.
SystemCallFilter=@system-service
SystemCallArchitectures=native
RestrictAddressFamilies=AF_NETLINK AF_UNIX AF_INET
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
