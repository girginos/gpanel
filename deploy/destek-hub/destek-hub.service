# GirginOSPanel Telegram destek merkezi — bot.girginos.io (182). ÖRNEK; otomatik kurulmaz.
[Unit]
Description=GirginOSPanel Telegram destek merkezi (destek-hub)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=destekhub
Group=destekhub
ExecStart=/usr/local/bin/destek-hub calistir --yapilandirma /etc/girginos-destek/destek-hub.json

# Sırlar: kaynak dosyalar root:root 0600; systemd bunları servis kullanıcısına
# özel, 0400, ramfs'teki $CREDENTIALS_DIRECTORY altına kopyalar. Ortam değişkeni YOK.
LoadCredential=telegram-token:/etc/girginos-destek/telegram-token
LoadCredential=anthropic-key:/etc/girginos-destek/anthropic-key
LoadCredential=telegram-webhook-gizli:/etc/girginos-destek/telegram-webhook-gizli
LoadCredential=merkez-imza-anahtari:/etc/girginos-destek/merkez-imza-anahtari
# Portalın iç API'yi (/ic/v1/*) çağırırken sunduğu Bearer sırrı (≥32 karakter, [A-Za-z0-9_-]).
LoadCredential=portal-ic-anahtar:/etc/girginos-destek/portal-ic-anahtar

StateDirectory=girginos-destek
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

# Sertleştirme
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RemoveIPC=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=
DevicePolicy=closed
KeyringMode=private
LimitNOFILE=65536
MemoryMax=512M
TasksMax=256

[Install]
WantedBy=multi-user.target
